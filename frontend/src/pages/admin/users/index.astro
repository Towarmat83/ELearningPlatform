---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Utilisateurs">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px">
    <div>
      <h1 style="font-size:1.5rem">Utilisateurs</h1>
      <p class="text-soft text-sm" style="margin-top:4px" id="user-count">Chargement…</p>
    </div>
  </div>

  <!-- Filter bar -->
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;flex-wrap:wrap">
    <input id="search-input" class="input" style="width:260px" placeholder="Rechercher par nom ou email…" />
    <div id="provider-tabs" style="display:flex;gap:6px;flex-wrap:wrap"></div>
  </div>

  <!-- Table -->
  <div class="card" style="padding:0;overflow:hidden">
    <table style="width:100%;border-collapse:collapse;font-size:.875rem" id="users-table">
      <thead>
        <tr style="border-bottom:1px solid var(--line);background:var(--fill)">
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Utilisateur</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Rôle</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Provider</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Cours</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Inscrit le</th>
          <th style="padding:12px 16px;text-align:right;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Actions</th>
        </tr>
      </thead>
      <tbody id="users-body">
        <tr><td colspan="6" style="padding:32px;text-align:center"><div class="loading-state" style="padding:0"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div></td></tr>
      </tbody>
    </table>
  </div>

  <!-- Edit modal -->
  <div id="edit-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;align-items:center;justify-content:center">
    <div class="card" style="width:420px;max-width:95vw;padding:28px">
      <h3 style="margin-bottom:20px" id="modal-title">Modifier l'utilisateur</h3>
      <div class="stack" style="gap:14px">
        <div class="form-group">
          <label class="label">Rôle</label>
          <select id="modal-role" class="input" style="height:auto;padding:9px 14px">
            <option value="student">Étudiant</option>
            <option value="admin">Administrateur</option>
          </select>
        </div>
        <div class="form-group">
          <label class="label" style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" id="modal-active" style="width:16px;height:16px;accent-color:var(--blue)" />
            Compte actif
          </label>
        </div>
      </div>
      <div style="display:flex;gap:8px;margin-top:24px;justify-content:flex-end">
        <button class="btn btn-secondary" id="modal-cancel">Annuler</button>
        <button class="btn btn-primary" id="modal-save">Enregistrer</button>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers, body: opts.body ? JSON.stringify(opts.body) : undefined });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    let allUsers: any[] = [];
    let filterProvider = '';
    let editingUserId = '';

    async function load() {
      try {
        // Load provider counts for tabs
        const [usersRes, providersRes] = await Promise.all([
          api('/admin/users'),
          api('/admin/users/providers').catch(() => ({ providers: [] })),
        ]);
        allUsers = usersRes.users || [];
        document.getElementById('user-count')!.textContent = `${usersRes.total ?? allUsers.length} utilisateurs`;

        // Build provider tabs
        const tabs = document.getElementById('provider-tabs')!;
        const providers: any[] = providersRes.providers || [];
        const total = providers.reduce((s: number, p: any) => s + p.count, 0);
        const tabDefs = [{ provider: '', label: `Tous (${total || allUsers.length})` }, ...providers.map((p: any) => ({ provider: p.provider, label: `${p.provider} (${p.count})` }))];
        tabs.innerHTML = tabDefs.map(t => `
          <button class="btn btn-sm ${filterProvider === t.provider ? 'btn-primary' : 'btn-secondary'}" data-provider="${t.provider}">${t.label}</button>
        `).join('');
        tabs.querySelectorAll<HTMLButtonElement>('button').forEach(btn => {
          btn.addEventListener('click', () => {
            filterProvider = btn.dataset.provider!;
            tabs.querySelectorAll<HTMLButtonElement>('button').forEach(b => { b.className = `btn btn-sm ${b.dataset.provider === filterProvider ? 'btn-primary' : 'btn-secondary'}`; });
            renderUsers();
          });
        });

        renderUsers();
      } catch (e: any) {
        document.getElementById('users-body')!.innerHTML = `<tr><td colspan="6" style="padding:24px;text-align:center;color:var(--bad)">Erreur : ${e.message}</td></tr>`;
      }
    }

    function renderUsers() {
      const search = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase();
      let users = allUsers;
      if (filterProvider) users = users.filter((u: any) => u.authProvider === filterProvider);
      if (search) users = users.filter((u: any) => u.username.toLowerCase().includes(search) || u.email.toLowerCase().includes(search));

      const tbody = document.getElementById('users-body')!;
      if (!users.length) {
        tbody.innerHTML = `<tr><td colspan="6" style="padding:32px;text-align:center;color:var(--ink-soft)">Aucun utilisateur trouvé</td></tr>`;
        return;
      }

      tbody.innerHTML = users.map((u: any) => `
        <tr style="border-bottom:1px solid var(--line)" data-uid="${u.id}">
          <td style="padding:12px 16px">
            <div style="display:flex;align-items:center;gap:10px">
              <div style="width:34px;height:34px;border-radius:50%;background:${u.role === 'admin' ? 'var(--bad-soft)' : 'var(--blue-soft)'};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.82rem;color:${u.role === 'admin' ? 'var(--bad)' : 'var(--blue)'};flex-shrink:0">${(u.username||'?')[0].toUpperCase()}</div>
              <div>
                <div style="font-weight:500">${u.username}</div>
                <div style="font-size:.78rem;color:var(--ink-soft)">${u.email}</div>
              </div>
            </div>
          </td>
          <td style="padding:12px 16px">
            <span class="badge ${u.role === 'admin' ? 'badge-red' : 'badge-blue'}">${u.role === 'admin' ? 'Admin' : 'Étudiant'}</span>
            ${!u.isActive ? '<span class="badge badge-gray" style="margin-left:4px">Inactif</span>' : ''}
          </td>
          <td style="padding:12px 16px">
            <span class="badge badge-gray">${u.authProvider || 'local'}</span>
          </td>
          <td style="padding:12px 16px;color:var(--ink-soft);font-size:.875rem">${u.enrolledCourses ?? '—'}</td>
          <td style="padding:12px 16px;color:var(--ink-soft);font-size:.78rem">${new Date(u.createdAt).toLocaleDateString('fr-FR')}</td>
          <td style="padding:12px 16px;text-align:right">
            <button class="btn btn-secondary btn-sm edit-btn" data-uid="${u.id}" data-role="${u.role}" data-active="${u.isActive}">Modifier</button>
            <button class="btn btn-sm delete-btn" style="background:var(--bad-soft);color:var(--bad);margin-left:4px" data-uid="${u.id}" data-name="${u.username}">Supprimer</button>
          </td>
        </tr>
      `).join('');

      tbody.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(btn => {
        btn.addEventListener('click', () => openEdit(btn.dataset.uid!, btn.dataset.role!, btn.dataset.active === 'true'));
      });
      tbody.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
        btn.addEventListener('click', () => deleteUser(btn.dataset.uid!, btn.dataset.name!));
      });
    }

    function openEdit(uid: string, role: string, isActive: boolean) {
      editingUserId = uid;
      const user = allUsers.find((u: any) => u.id === uid);
      document.getElementById('modal-title')!.textContent = `Modifier — ${user?.username ?? uid}`;
      (document.getElementById('modal-role') as HTMLSelectElement).value = role;
      (document.getElementById('modal-active') as HTMLInputElement).checked = isActive;
      const modal = document.getElementById('edit-modal')!;
      modal.style.display = 'flex';
    }

    document.getElementById('modal-cancel')!.addEventListener('click', () => {
      document.getElementById('edit-modal')!.style.display = 'none';
    });

    document.getElementById('edit-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('edit-modal')) document.getElementById('edit-modal')!.style.display = 'none';
    });

    document.getElementById('modal-save')!.addEventListener('click', async () => {
      const role = (document.getElementById('modal-role') as HTMLSelectElement).value;
      const isActive = (document.getElementById('modal-active') as HTMLInputElement).checked;
      const btn = document.getElementById('modal-save') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Enregistrement…';
      try {
        await api(`/admin/users/${editingUserId}`, { method: 'PUT', body: { role, isActive } });
        const u = allUsers.find((u: any) => u.id === editingUserId);
        if (u) { u.role = role; u.isActive = isActive; }
        document.getElementById('edit-modal')!.style.display = 'none';
        renderUsers();
        (window as any).showToast?.('Utilisateur mis à jour', 'success');
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Enregistrer';
      }
    });

    async function deleteUser(uid: string, name: string) {
      if (!confirm(`Supprimer ${name} ? Cette action est irréversible.`)) return;
      try {
        await api(`/admin/users/${uid}`, { method: 'DELETE' });
        allUsers = allUsers.filter((u: any) => u.id !== uid);
        renderUsers();
        (window as any).showToast?.('Utilisateur supprimé', 'success');
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      }
    }

    document.getElementById('search-input')!.addEventListener('input', renderUsers);

    load();
  </script>
</Admin>
