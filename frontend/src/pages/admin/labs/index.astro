---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Labs — Suivi apprenant">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px">
    <div>
      <h1 style="font-size:1.5rem">Suivi des Labs</h1>
      <p class="text-soft text-sm" style="margin-top:4px" id="result-count">Chargement…</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <select id="course-filter" class="input" style="height:auto;padding:8px 12px;min-width:200px">
        <option value="">Tous les cours</option>
      </select>
      <button id="refresh-btn" class="btn btn-secondary">Actualiser</button>
    </div>
  </div>

  <!-- Stats rapides -->
  <div id="stats-row" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:24px"></div>

  <!-- Table -->
  <div class="card" style="padding:0;overflow:hidden">
    <table style="width:100%;border-collapse:collapse;font-size:.875rem" id="lab-table">
      <thead>
        <tr style="border-bottom:1px solid var(--line);background:var(--fill)">
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Apprenant</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Cours</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Lab</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Statut</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Violations</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Vérifié le</th>
        </tr>
      </thead>
      <tbody id="lab-body">
        <tr><td colspan="6" style="padding:32px;text-align:center"><div class="loading-state" style="padding:0"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div></td></tr>
      </tbody>
    </table>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string) {
      const res = await fetch('/api' + path, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    function fmt(dt: string) {
      return new Date(dt).toLocaleString('fr-FR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
    }

    function statusBadge(allow: boolean) {
      return allow
        ? `<span style="display:inline-flex;align-items:center;gap:4px;background:#d1fae5;color:#065f46;padding:2px 10px;border-radius:20px;font-size:.78rem;font-weight:600">✓ Validé</span>`
        : `<span style="display:inline-flex;align-items:center;gap:4px;background:#fee2e2;color:#991b1b;padding:2px 10px;border-radius:20px;font-size:.78rem;font-weight:600">✗ Échec</span>`;
    }

    let allRows: any[] = [];

    async function load(course = '') {
      const body = document.getElementById('lab-body')!;
      body.innerHTML = `<tr><td colspan="6" style="padding:32px;text-align:center"><div class="loading-state" style="padding:0"><div class="spinner"></div></div></td></tr>`;

      const qs = course ? `?course=${encodeURIComponent(course)}` : '';
      allRows = await api(`/admin/lab-checks${qs}`);

      // Populate course filter
      const courses = [...new Set(allRows.map((r: any) => r.course_slug))].sort();
      const sel = document.getElementById('course-filter') as HTMLSelectElement;
      const current = sel.value;
      sel.innerHTML = `<option value="">Tous les cours</option>` +
        courses.map((c: string) => `<option value="${c}" ${c === current ? 'selected' : ''}>${c}</option>`).join('');

      render(allRows);
    }

    function render(rows: any[]) {
      const body = document.getElementById('lab-body')!;
      const count = document.getElementById('result-count')!;
      const stats = document.getElementById('stats-row')!;

      const total = rows.length;
      const passed = rows.filter((r: any) => r.allow).length;
      const failed = total - passed;
      const unique = new Set(rows.map((r: any) => r.username)).size;

      count.textContent = `${total} vérification${total > 1 ? 's' : ''} — ${unique} apprenant${unique > 1 ? 's' : ''}`;

      stats.innerHTML = [
        { label: 'Total vérifications', value: total, color: 'var(--blue)' },
        { label: 'Labs validés', value: passed, color: '#065f46' },
        { label: 'Labs échoués', value: failed, color: '#991b1b' },
        { label: 'Apprenants actifs', value: unique, color: 'var(--ink)' },
      ].map(s => `
        <div class="card" style="padding:16px 20px">
          <div style="font-size:1.75rem;font-weight:700;color:${s.color}">${s.value}</div>
          <div class="text-soft text-sm" style="margin-top:2px">${s.label}</div>
        </div>
      `).join('');

      if (rows.length === 0) {
        body.innerHTML = `<tr><td colspan="6" style="padding:40px;text-align:center;color:var(--ink-soft)">Aucune vérification enregistrée.</td></tr>`;
        return;
      }

      body.innerHTML = rows.map((r: any) => `
        <tr style="border-bottom:1px solid var(--line)">
          <td style="padding:12px 16px">
            <div style="display:flex;align-items:center;gap:8px">
              <div style="width:30px;height:30px;border-radius:50%;background:var(--blue-soft);display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:600;color:var(--blue);flex-shrink:0">${r.username[0].toUpperCase()}</div>
              <span style="font-weight:500">${r.username}</span>
            </div>
          </td>
          <td style="padding:12px 16px;color:var(--ink-soft);font-size:.85rem">${r.course_slug}</td>
          <td style="padding:12px 16px;font-size:.85rem">${r.module_name}</td>
          <td style="padding:12px 16px">${statusBadge(r.allow)}</td>
          <td style="padding:12px 16px;max-width:340px">
            ${r.violations && r.violations.length
              ? r.violations.map((v: string) => `<div style="font-size:.8rem;color:#991b1b;margin-bottom:2px">• ${v}</div>`).join('')
              : `<span style="color:var(--ink-soft);font-size:.82rem">—</span>`}
          </td>
          <td style="padding:12px 16px;color:var(--ink-soft);font-size:.82rem;white-space:nowrap">${fmt(r.checked_at)}</td>
        </tr>
      `).join('');
    }

    document.getElementById('course-filter')!.addEventListener('change', (e) => {
      load((e.target as HTMLSelectElement).value);
    });

    document.getElementById('refresh-btn')!.addEventListener('click', () => {
      const sel = document.getElementById('course-filter') as HTMLSelectElement;
      load(sel.value);
    });

    load();
  </script>
</Admin>
