---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Patterns">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl">Markdown Patterns</h1>
      <p class="text-soft text-sm mt-1">Stockés en base et gérés depuis cette page.</p>
    </div>
    <button class="btn btn-primary btn-sm" id="new-btn">+ Nouveau pattern</button>
  </div>

  <!-- Form (create / edit) -->
  <div id="form-area" class="mb-6" style="display:none">
    <div class="pat-grid">
      <div class="form-card">
        <h3 id="form-title" class="mb-4">Nouveau pattern</h3>
        <div class="form-stack">
          <div class="form-grid2">
            <div>
              <label class="label" for="f-name">Nom <span class="text-bad">*</span></label>
              <input class="input font-mono" id="f-name" type="text" placeholder="blink" />
              <p class="label-hint">Utilisé comme identifiant : <code>|||blink</code></p>
            </div>
            <div>
              <label class="label" for="f-label">Label</label>
              <input class="input" id="f-label" type="text" placeholder="Clignotant" />
            </div>
          </div>
          <div>
            <label class="label" for="f-scope">Scope</label>
            <input class="input font-mono" id="f-scope" type="text" placeholder="global" />
          </div>
          <div>
            <label class="label" for="f-html">HTML <span class="text-bad">*</span></label>
            <p class="label-hint"><code>&#123;&#123;content&#125;&#125;</code> → markdown rendu.</p>
            <textarea class="input font-mono text-[.82rem]" id="f-html" rows="3" placeholder='<span class="md-pat-blink">&#123;&#123;content&#125;&#125;</span>'></textarea>
          </div>
          <div>
            <label class="label" for="f-css">CSS</label>
            <textarea class="input font-mono text-[.82rem]" id="f-css" rows="4" placeholder=".md-pat-blink { animation: blink 1s step-end infinite; }"></textarea>
          </div>
          <div>
            <label class="label" for="f-js">JS <span class="font-normal text-ink-soft">(exécuté après rendu)</span></label>
            <textarea class="input font-mono text-[.82rem]" id="f-js" rows="3" placeholder="// container is the parent element"></textarea>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary btn-sm" id="form-save">Créer le pattern</button>
            <button class="btn btn-secondary btn-sm" id="form-yaml">⎈ YAML</button>
            <button class="btn btn-secondary btn-sm" id="form-cancel">Annuler</button>
          </div>
        </div>
      </div>
      <!-- Preview column -->
      <div class="form-card sticky top-4">
        <h3 class="mb-3">Aperçu</h3>
        <div id="preview-usage" class="mb-3"></div>
        <div>
          <label class="label" for="f-preview-md">Markdown personnalisé</label>
          <textarea class="input font-mono text-[.82rem]" id="f-preview-md" rows="4" placeholder="Tapez du markdown pour tester…"></textarea>
        </div>
        <div id="preview-area" class="preview-area">
          <p class="text-soft text-sm italic">Remplissez le nom et le HTML pour prévisualiser.</p>
        </div>
        <div id="preview-note" class="text-[.72rem] text-ink-soft mt-1.5" style="display:none">
          La prévisualisation nécessite un appel API. Le rendu réel peut différer selon les styles CSS chargés.
        </div>
      </div>
    </div>
  </div>

  <!-- Pattern list -->
  <div id="loading" class="loading-state"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div>
  <div id="patterns-list" style="display:none">
    <div id="patterns-body" class="flex flex-col gap-2"></div>
    <div id="empty-state" class="card text-center p-10" style="display:none">
      <p class="text-soft">Aucun pattern. Cliquez <strong>+ Nouveau pattern</strong>.</p>
    </div>
  </div>

  <!-- ── YAML modal ── -->
  <div class="modal-overlay" id="yaml-modal">
    <div class="modal-box">
      <div class="modal-head">
        <h3 id="yaml-title">Définition — pattern</h3>
        <button class="btn btn-ghost btn-sm" id="yaml-close">✕</button>
      </div>
      <div class="modal-body">
        <pre class="yaml" id="yaml-content"></pre>
      </div>
      <div class="modal-foot">
        <button class="btn btn-secondary btn-sm" id="yaml-copy">Copier</button>
        <button class="btn btn-secondary btn-sm" id="yaml-close2">Fermer</button>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers, body: opts.body ? JSON.stringify(opts.body) : undefined });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    let patterns: any[] = [];
    let editingName: string | null = null;
    let prevName = '';

    const nameEl    = document.getElementById('f-name')    as HTMLInputElement;
    const labelEl   = document.getElementById('f-label')   as HTMLInputElement;
    const scopeEl   = document.getElementById('f-scope')   as HTMLInputElement;
    const htmlEl    = document.getElementById('f-html')    as HTMLTextAreaElement;
    const cssEl     = document.getElementById('f-css')     as HTMLTextAreaElement;
    const jsEl      = document.getElementById('f-js')      as HTMLTextAreaElement;
    const formArea  = document.getElementById('form-area')!;

    function getDraft() {
      return { name: nameEl.value.trim(), label: labelEl.value.trim(), scope: scopeEl.value.trim() || 'global', html: htmlEl.value, css: cssEl.value, js: jsEl.value };
    }

    function resetForm() {
      nameEl.value = ''; labelEl.value = ''; scopeEl.value = 'global';
      htmlEl.value = '<span class="md-pat-{{name}}">{{content}}</span>';
      cssEl.value = '.md-pat-{{name}} {\n  \n}';
      jsEl.value = '';
      prevName = '';
      (document.getElementById('form-title') as HTMLElement).textContent = 'Nouveau pattern';
      (document.getElementById('form-save') as HTMLButtonElement).textContent = 'Créer le pattern';
      nameEl.removeAttribute('disabled');
    }

    function openForm() {
      resetForm();
      formArea.style.display = 'block';
      nameEl.focus();
    }

    function closeForm() {
      formArea.style.display = 'none';
      resetForm();
    }

    // Auto-update class names when name changes
    nameEl.addEventListener('input', () => {
      const name = nameEl.value.trim();
      const from = prevName ? `md-pat-${prevName}` : 'md-pat-{{name}}';
      const to   = name    ? `md-pat-${name}`      : 'md-pat-{{name}}';
      if (htmlEl.value.includes(from)) htmlEl.value = htmlEl.value.replaceAll(from, to);
      if (cssEl.value.includes(from))  cssEl.value  = cssEl.value.replaceAll(from, to);
      prevName = name;
      schedulePreview();
    });

    let previewTimer: ReturnType<typeof setTimeout> | null = null;
    function schedulePreview() {
      if (previewTimer) clearTimeout(previewTimer);
      previewTimer = setTimeout(updatePreview, 180);
    }

    [htmlEl, cssEl, jsEl, document.getElementById('f-preview-md') as HTMLTextAreaElement].forEach(el => {
      el?.addEventListener('input', schedulePreview);
    });

    async function updatePreview() {
      const name    = nameEl.value.trim();
      const html    = htmlEl.value.trim();
      const css     = cssEl.value.trim();
      const previewMd = (document.getElementById('f-preview-md') as HTMLTextAreaElement).value.trim();

      const usageEl     = document.getElementById('preview-usage')!;
      const previewArea = document.getElementById('preview-area')!;
      const previewNote = document.getElementById('preview-note')!;

      // Usage snippets
      if (name) {
        usageEl.innerHTML = `<div class="flex gap-2 flex-wrap">
          <code class="code-snippet">|||${name}\\n…\\n|||</code>
          <code class="code-snippet">|||${name} texte|||</code>
        </div>`;
      } else {
        usageEl.innerHTML = '';
      }

      if (!name || !html) {
        previewArea.innerHTML = '<p class="text-soft text-sm italic">Remplissez le nom et le HTML pour prévisualiser.</p>';
        previewNote.style.display = 'none';
        return;
      }

      // Inject scoped CSS
      let styleEl = document.getElementById('pat-preview-css') as HTMLStyleElement | null;
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'pat-preview-css';
        document.head.appendChild(styleEl);
      }
      styleEl.textContent = css;

      // Normalize line endings and provide default markdown
      const raw = previewMd || `Exemple inline : |||${name} texte en ligne|||.\n\n|||${name}\nContenu **bloc** sur plusieurs lignes.\n|||`;
      const md = raw.replace(/\r\n/g, '\n').replace(/\r/g, '\n');

      try {
        const { marked } = await import('marked');
        const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

        // Block pattern: find all matches first, then replace async (can't await in .replace callback)
        let processed = md;
        const blockRe = new RegExp(`\\|\\|\\|${escaped}\\n([\\s\\S]*?)\\n\\|\\|\\|`, 'g');
        const blockHits: Array<{ full: string; content: string }> = [];
        let bm: RegExpExecArray | null;
        while ((bm = blockRe.exec(md)) !== null) {
          blockHits.push({ full: bm[0], content: bm[1] });
        }
        for (const hit of blockHits) {
          const inner = await marked.parseInline(hit.content.trim());
          processed = processed.replace(hit.full, html.replace(/\{\{content\}\}/g, inner));
        }

        // Inline pattern: |||name text|||  (synchronous, no marked needed for inner content)
        processed = processed.replace(
          new RegExp(`\\|\\|\\|${escaped} ([^|\\n]+?)\\|\\|\\|`, 'g'),
          (_, content: string) => html.replace(/\{\{content\}\}/g, content.trim())
        );

        previewArea.innerHTML = await marked.parse(processed);
        previewNote.style.display = 'block';
      } catch {
        previewArea.innerHTML = '<p class="text-bad text-[.85rem]">Erreur de rendu.</p>';
      }
    }

    // ── Definition export ──
    // Renders the pattern as the JSON body accepted by
    // POST /api/admin/patterns.
    function generateDefinition(p: { name: string; label?: string; scope?: string; html: string; css?: string; js?: string }) {
      return JSON.stringify({
        name:  p.name,
        label: p.label || p.name,
        scope: p.scope || 'global',
        html:  p.html,
        css:   p.css || '',
        js:    p.js  || '',
      }, null, 2);
    }

    function showYAML(p: { name: string; label?: string; scope?: string; html: string; css?: string; js?: string }) {
      const yaml = generateDefinition(p);
      (document.getElementById('yaml-title') as HTMLElement).textContent = `Définition — ${p.name}`;
      (document.getElementById('yaml-content') as HTMLElement).textContent = yaml;
      document.getElementById('yaml-modal')!.classList.add('open');
    }

    document.getElementById('new-btn')!.addEventListener('click', openForm);
    document.getElementById('form-cancel')!.addEventListener('click', closeForm);
    document.getElementById('form-yaml')!.addEventListener('click', () => {
      const d = getDraft();
      if (!d.name || !d.html) return;
      showYAML(d);
    });

    document.getElementById('yaml-close')!.addEventListener('click', () => document.getElementById('yaml-modal')!.classList.remove('open'));
    document.getElementById('yaml-close2')!.addEventListener('click', () => document.getElementById('yaml-modal')!.classList.remove('open'));
    document.getElementById('yaml-modal')!.addEventListener('click', e => { if (e.target === document.getElementById('yaml-modal')) document.getElementById('yaml-modal')!.classList.remove('open'); });
    document.getElementById('yaml-copy')!.addEventListener('click', () => {
      navigator.clipboard.writeText((document.getElementById('yaml-content') as HTMLElement).textContent || '')
        .then(() => (window as any).showToast?.('Copié', 'success'));
    });

    // ── Save form (create only) ──
    document.getElementById('form-save')!.addEventListener('click', async () => {
      const d = getDraft();
      if (!d.name || !d.html) { (window as any).showToast?.('Nom et HTML requis', 'error'); return; }
      const btn = document.getElementById('form-save') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Enregistrement…';
      try {
        await api('/admin/patterns', { method: 'POST', body: d });
        (window as any).showToast?.(`Pattern "${d.name}" créé`, 'success');
        closeForm();
        await loadPatterns();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Créer le pattern';
      }
    });

    // ── Load patterns ──
    async function loadPatterns() {
      try {
        const res = await api('/patterns');
        patterns = res.patterns || [];
        renderList();
        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('patterns-list')!.style.display = 'block';
      } catch (e: any) {
        document.getElementById('loading')!.innerHTML = `<p class="text-bad p-6">${e.message}</p>`;
      }
    }

    function escHtml(s: string) {
      return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function renderInlineForm(p: any) {
      return `
        <div class="pat-inline-form">
          <div class="pat-inline-grid">
            <div>
              <label class="label text-[.78rem]">Label</label>
              <input class="input" id="ef-label" type="text" value="${escHtml(p.label || '')}" placeholder="Clignotant" />
            </div>
            <div>
              <label class="label text-[.78rem]">Scope</label>
              <input class="input font-mono" id="ef-scope" type="text" value="${escHtml(p.scope || 'global')}" />
            </div>
          </div>
          <div>
            <label class="label text-[.78rem]">HTML <span class="text-bad">*</span></label>
            <p class="label-hint"><code>{{content}}</code> → markdown rendu.</p>
            <textarea class="input font-mono text-[.82rem]" id="ef-html" rows="3">${escHtml(p.html || '')}</textarea>
          </div>
          <div>
            <label class="label text-[.78rem]">CSS</label>
            <textarea class="input font-mono text-[.82rem]" id="ef-css" rows="3">${escHtml(p.css || '')}</textarea>
          </div>
          <div>
            <label class="label text-[.78rem]">JS <span class="font-normal text-ink-soft">(exécuté après rendu)</span></label>
            <textarea class="input font-mono text-[.82rem]" id="ef-js" rows="2">${escHtml(p.js || '')}</textarea>
          </div>
          <div class="flex gap-1.5">
            <button class="btn btn-primary btn-sm" data-action="ef-save">Enregistrer</button>
            <button class="btn btn-secondary btn-sm" data-action="ef-yaml">⎈ YAML</button>
            <button class="btn btn-secondary btn-sm" data-action="ef-cancel">Annuler</button>
          </div>
        </div>
      `;
    }

    function renderList() {
      const body = document.getElementById('patterns-body')!;
      const empty = document.getElementById('empty-state')!;
      if (!patterns.length) {
        body.innerHTML = '';
        empty.style.display = 'block';
        return;
      }
      empty.style.display = 'none';
      body.innerHTML = patterns.map(p => {
        const isOpen = editingName === p.name;
        return `
          <div class="pat-item${isOpen ? ' open' : ''}" id="pi-${p.name}">
            <div class="pat-row">
              <div class="pat-info">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="pat-name">|||${p.name}</span>
                  ${p.label ? `<span class="text-soft text-sm">${p.label}</span>` : ''}
                  ${p.scope && p.scope !== 'global'
                    ? `<span class="badge badge-amber text-[.7rem]">${p.scope}</span>`
                    : `<span class="badge badge-gray text-[.7rem]">global</span>`}
                </div>
                <div class="pat-html">${escHtml(p.html || '')}</div>
              </div>
              <div class="pat-actions">
                <button class="link-btn violet" data-action="yaml" data-name="${p.name}">⎈ YAML</button>
                <button class="link-btn gray" data-action="${isOpen ? 'ef-cancel' : 'edit'}" data-name="${p.name}">${isOpen ? '▲ Fermer' : 'Modifier'}</button>
                <button class="link-btn red" data-action="delete" data-name="${p.name}">Supprimer</button>
              </div>
            </div>
            ${isOpen ? renderInlineForm(p) : ''}
          </div>
        `;
      }).join('');
    }

    // ── Single delegated listener on patterns-body ──
    document.getElementById('patterns-body')!.addEventListener('click', async (e: MouseEvent) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
      if (!btn) return;
      const action = btn.dataset.action!;
      const name = btn.dataset.name!;

      if (action === 'ef-cancel') { editingName = null; renderList(); return; }
      if (action === 'ef-save')   { await saveInlineEdit(); return; }
      if (action === 'ef-yaml')   { const p = patterns.find(x => x.name === editingName); if (p) showYAML(getInlineDraft(p)); return; }

      const p = patterns.find(x => x.name === name);
      if (!p) return;
      if (action === 'yaml')   showYAML(p);
      else if (action === 'edit')   startEdit(p);
      else if (action === 'delete') deletePattern(p);
    });

    function startEdit(p: any) {
      editingName = p.name;
      formArea.style.display = 'none'; // close create form if open
      renderList();
      setTimeout(() => document.getElementById('pi-' + p.name)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 30);
    }

    function getInlineDraft(p: any) {
      return {
        name: p.name,
        label: (document.getElementById('ef-label') as HTMLInputElement)?.value.trim() ?? p.label,
        scope: (document.getElementById('ef-scope') as HTMLInputElement)?.value.trim() || 'global',
        html:  (document.getElementById('ef-html')  as HTMLTextAreaElement)?.value ?? p.html,
        css:   (document.getElementById('ef-css')   as HTMLTextAreaElement)?.value ?? p.css,
        js:    (document.getElementById('ef-js')    as HTMLTextAreaElement)?.value ?? p.js,
      };
    }

    async function saveInlineEdit() {
      if (!editingName) return;
      const html = (document.getElementById('ef-html') as HTMLTextAreaElement)?.value || '';
      if (!html) { (window as any).showToast?.('HTML requis', 'error'); return; }
      const body: any = {
        name:  editingName,
        label: (document.getElementById('ef-label') as HTMLInputElement)?.value.trim() || '',
        scope: (document.getElementById('ef-scope') as HTMLInputElement)?.value.trim() || 'global',
        html,
        css:   (document.getElementById('ef-css')   as HTMLTextAreaElement)?.value || '',
        js:    (document.getElementById('ef-js')    as HTMLTextAreaElement)?.value || '',
      };
      const btn = document.querySelector<HTMLButtonElement>('[data-action="ef-save"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Enregistrement…'; }
      try {
        await api(`/admin/patterns/${editingName}`, { method: 'PUT', body });
        (window as any).showToast?.(`Pattern "${editingName}" mis à jour`, 'success');
        editingName = null;
        await loadPatterns();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
        if (btn) { btn.disabled = false; btn.textContent = 'Enregistrer'; }
      }
    }

    async function deletePattern(p: any) {
      if (!confirm(`Supprimer le pattern "${p.name}" ? Cette action est irréversible.`)) return;
      try {
        await api(`/admin/patterns/${p.name}`, { method: 'DELETE' });
        (window as any).showToast?.(`Pattern "${p.name}" supprimé`, 'success');
        await loadPatterns();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      }
    }

    loadPatterns();
  </script>
</Admin>
