# Database
DB_PASSWORD=elearning_secret

# Admin account (email: admin@elearning.local)
# Set to a strong password before going to production.
# Accepts either a cleartext password or a pre-computed bcrypt hash (starts with $2).
# The hash is refreshed at every startup, allowing password rotation without SQL.
ADMIN_PASSWORD=Admin@1234

# API
JWT_SECRET=change-this-to-a-long-random-string-in-production

# GitOps — encryption key for git repo tokens (change in production)
REPO_TOKEN_SECRET=change-me-use-a-long-random-secret-32chars
DATABASE_URL=postgres://elearning:elearning_secret@localhost:5432/elearning

# Frontend
FRONTEND_URL=http://localhost:3000

# Grafana
GRAFANA_PASSWORD=admin

# OAuth SSO (optional — leave empty to disable provider)

# GitLab: https://gitlab.com/-/profile/applications (or your self-hosted instance)
# Redirect URI: http://localhost:3000/auth/callback   Scopes: read_user
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Override for self-hosted GitLab (default: https://gitlab.com)
GITLAB_URL=https://gitlab.com

# GitHub: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base URL of the frontend (used to build the OAuth redirect_uri)
OAUTH_REDIRECT_BASE=http://localhost:3000
