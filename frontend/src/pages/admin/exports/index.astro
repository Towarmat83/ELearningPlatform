---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Exports CSV" allowedRoles={['admin', 'manager']}>
  <div class="flex items-center justify-between mb-7 flex-wrap gap-3">
    <div>
      <h1 class="text-2xl">Exports CSV</h1>
      <p class="text-soft text-sm mt-1">Exportez les données de la plateforme au format CSV.</p>
    </div>
    <button class="btn btn-primary" id="download-btn" disabled>⬇ Télécharger</button>
  </div>

  <div id="loading" class="loading-state !py-12 !px-0">
    <div class="spinner"></div>
    <span class="text-soft text-sm">Chargement…</span>
  </div>

  <div id="export-body" class="export-grid" style="display:none">

    <!-- ── Panneau de configuration ── -->
    <div class="card export-config-panel">
      <h2 class="mb-4">Catégorie</h2>
      <div id="categories-list" class="flex flex-col gap-2 mb-6"></div>

      <div id="fields-section" style="display:none">
        <h2 class="mb-3">Champs</h2>
        <div class="flex gap-2 mb-3">
          <button class="btn btn-secondary btn-sm" id="select-all-btn">Tout sélectionner</button>
          <button class="btn btn-secondary btn-sm" id="reset-fields-btn">Réinitialiser</button>
        </div>
        <div id="fields-list" class="flex flex-col gap-1.5"></div>
      </div>

      <div id="filters-section" style="display:none">
        <h2 class="mt-6 mb-3">Filtres</h2>
        <div id="filters-list" class="flex flex-col gap-3"></div>
      </div>
    </div>

    <!-- ── Panneau de prévisualisation ── -->
    <div class="card export-preview-panel">
      <div class="flex items-baseline justify-between mb-4 gap-3 flex-wrap">
        <h2>Aperçu</h2>
        <span class="text-soft text-sm" id="preview-count"></span>
      </div>

      <div id="preview-loading" class="loading-state !py-8 !px-0" style="display:none">
        <div class="spinner"></div>
      </div>

      <div id="preview-empty" class="text-soft text-sm py-8 text-center" style="display:none">
        Sélectionnez une catégorie et au moins un champ.
      </div>

      <div id="preview-table-wrap" class="admin-table-wrap overflow-x-auto" style="display:none">
        <table class="admin-table" id="preview-table">
          <thead id="preview-head"></thead>
          <tbody id="preview-body"></tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`,
      };
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body !== undefined ? JSON.stringify(opts.body) : undefined,
      });
      if (!res.ok) {
        const e = await res.json().catch(() => ({}));
        throw new Error((e as any).error || `HTTP ${res.status}`);
      }
      return res.status === 204 ? null : res.json();
    }

    interface FieldMeta  { id: string; label: string }
    interface FilterOption { value: string; label: string }
    interface FilterMeta {
      id: string;
      label: string;
      type: 'date' | 'select' | 'text';
      options?: FilterOption[];
    }
    interface CategoryMeta {
      id: string;
      label: string;
      fields: FieldMeta[];
      defaultFields: string[];
      filters: FilterMeta[];
      _apiBase: string;
    }

    let categories: CategoryMeta[] = [];
    let selectedCategory = '';
    let selectedCategoryApiBase = '/admin/exports';
    let selectedFields: Set<string> = new Set();
    let activeFilters: Record<string, string> = {};
    let previewTimer: ReturnType<typeof setTimeout> | null = null;

    // ── DOM refs ──
    const loadingEl      = document.getElementById('loading')!;
    const exportBody     = document.getElementById('export-body')!;
    const catList        = document.getElementById('categories-list')!;
    const fieldsSection  = document.getElementById('fields-section')!;
    const fieldsList     = document.getElementById('fields-list')!;
    const filtersSection = document.getElementById('filters-section')!;
    const filtersList    = document.getElementById('filters-list')!;
    const downloadBtn    = document.getElementById('download-btn') as HTMLButtonElement;
    const selectAllBtn   = document.getElementById('select-all-btn') as HTMLButtonElement;
    const resetBtn       = document.getElementById('reset-fields-btn') as HTMLButtonElement;
    const previewCount   = document.getElementById('preview-count')!;
    const previewLoading = document.getElementById('preview-loading')!;
    const previewEmpty   = document.getElementById('preview-empty')!;
    const previewWrap    = document.getElementById('preview-table-wrap')!;
    const previewHead    = document.getElementById('preview-head')!;
    const previewBody    = document.getElementById('preview-body')!;

    // ── Select a category ──
    function selectCategory(cat: CategoryMeta) {
      selectedCategory = cat.id;
      selectedCategoryApiBase = cat._apiBase;
      selectedFields = new Set(cat.defaultFields);
      activeFilters = {};

      catList.querySelectorAll<HTMLButtonElement>('.export-cat-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.id === cat.id);
      });

      renderFields(cat);
      renderFilters(cat);
      fieldsSection.style.display = 'block';
      schedulePreview();
    }

    function renderFields(cat: CategoryMeta) {
      fieldsList.innerHTML = '';
      for (const f of cat.fields) {
        const label = document.createElement('label');
        label.className = 'export-field-row';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'w-4 h-4 accent-blue-500';
        cb.value = f.id;
        cb.checked = selectedFields.has(f.id);
        cb.addEventListener('change', () => {
          if (cb.checked) selectedFields.add(f.id);
          else selectedFields.delete(f.id);
          updateDownloadBtn();
          schedulePreview();
        });
        const span = document.createElement('span');
        span.className = 'text-sm';
        span.textContent = f.label;
        label.appendChild(cb);
        label.appendChild(span);
        fieldsList.appendChild(label);
      }
      updateDownloadBtn();
    }

    function renderFilters(cat: CategoryMeta) {
      filtersList.innerHTML = '';
      if (!cat.filters || cat.filters.length === 0) {
        filtersSection.style.display = 'none';
        return;
      }
      filtersSection.style.display = 'block';
      for (const f of cat.filters) {
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-col gap-1';
        const lbl = document.createElement('label');
        lbl.className = 'text-sm font-medium';
        lbl.textContent = f.label;
        wrap.appendChild(lbl);

        let input: HTMLInputElement | HTMLSelectElement;

        if (f.type === 'select' && f.options) {
          const sel = document.createElement('select');
          sel.className = 'input input-sm';
          const empty = document.createElement('option');
          empty.value = '';
          empty.textContent = '— Tous —';
          sel.appendChild(empty);
          for (const opt of f.options) {
            const o = document.createElement('option');
            o.value = opt.value;
            o.textContent = opt.label;
            sel.appendChild(o);
          }
          sel.addEventListener('change', () => {
            if (sel.value) activeFilters[f.id] = sel.value;
            else delete activeFilters[f.id];
            schedulePreview();
          });
          input = sel;
        } else {
          const inp = document.createElement('input');
          inp.type = f.type === 'date' ? 'date' : 'text';
          inp.className = 'input input-sm';
          inp.placeholder = f.type === 'text' ? f.label : '';
          inp.addEventListener('input', () => {
            if (inp.value) activeFilters[f.id] = inp.value;
            else delete activeFilters[f.id];
            schedulePreview();
          });
          input = inp;
        }

        wrap.appendChild(input);
        filtersList.appendChild(wrap);
      }
    }

    function updateDownloadBtn() {
      downloadBtn.disabled = selectedCategory === '' || selectedFields.size === 0;
    }

    // ── Select All / Reset ──
    selectAllBtn.addEventListener('click', () => {
      const cat = categories.find(c => c.id === selectedCategory);
      if (!cat) return;
      selectedFields = new Set(cat.fields.map(f => f.id));
      renderFields(cat);
      schedulePreview();
    });

    resetBtn.addEventListener('click', () => {
      const cat = categories.find(c => c.id === selectedCategory);
      if (!cat) return;
      selectedFields = new Set(cat.defaultFields);
      renderFields(cat);
      schedulePreview();
    });

    // ── Debounced preview ──
    function schedulePreview() {
      if (previewTimer) clearTimeout(previewTimer);
      previewTimer = setTimeout(fetchPreview, 300);
    }

    async function fetchPreview() {
      if (!selectedCategory || selectedFields.size === 0) {
        showPreviewEmpty();
        return;
      }

      previewLoading.style.display = 'flex';
      previewEmpty.style.display = 'none';
      previewWrap.style.display = 'none';
      previewCount.textContent = '';

      try {
        const data = await api(`${selectedCategoryApiBase}/preview`, {
          method: 'POST',
          body: { category: selectedCategory, fields: [...selectedFields], filters: activeFilters },
        });

        const headers: string[] = data.headers ?? [];
        const rows: Record<string, string>[] = data.rows ?? [];
        const total: number = data.totalCount ?? 0;

        previewHead.innerHTML = `<tr class="admin-tr-head">${
          headers.map(h => `<th class="admin-th">${escHtml(labelFor(h))}</th>`).join('')
        }</tr>`;

        previewBody.innerHTML = rows.length === 0
          ? `<tr><td colspan="${headers.length}" class="admin-td text-soft text-center py-6">Aucune donnée.</td></tr>`
          : rows.map(row => `<tr class="admin-tr">${
              headers.map(h => `<td class="admin-td preview-td" title="${escHtml(row[h] ?? '')}">${escHtml(row[h] ?? '')}</td>`).join('')
            }</tr>`).join('');

        const shown = rows.length;
        previewCount.textContent = shown < total
          ? `${shown} lignes affichées sur ${total.toLocaleString('fr-FR')}`
          : `${total.toLocaleString('fr-FR')} ligne${total > 1 ? 's' : ''}`;

        previewLoading.style.display = 'none';
        previewWrap.style.display = 'block';
      } catch (err: any) {
        previewLoading.style.display = 'none';
        previewCount.textContent = err.message || 'Erreur';
        previewEmpty.textContent = "Impossible de charger l'aperçu.";
        previewEmpty.style.display = 'block';
      }
    }

    function showPreviewEmpty() {
      previewLoading.style.display = 'none';
      previewWrap.style.display = 'none';
      previewEmpty.textContent = 'Sélectionnez une catégorie et au moins un champ.';
      previewEmpty.style.display = 'block';
      previewCount.textContent = '';
    }

    // ── Label lookup ──
    function labelFor(fieldId: string): string {
      if (!selectedCategory) return fieldId;
      const cat = categories.find(c => c.id === selectedCategory);
      const f = cat?.fields.find(f => f.id === fieldId);
      return f?.label ?? fieldId;
    }

    function escHtml(s: string): string {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ── Download ──
    downloadBtn.addEventListener('click', async () => {
      if (!selectedCategory || selectedFields.size === 0) return;
      downloadBtn.disabled = true;
      downloadBtn.textContent = 'Téléchargement…';
      try {
        const res = await fetch(`/api${selectedCategoryApiBase}/download`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ category: selectedCategory, fields: [...selectedFields], filters: activeFilters }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const blob = await res.blob();
        const disp = res.headers.get('Content-Disposition') ?? '';
        const match = disp.match(/filename="?([^";\r\n]+)"?/i);
        const filename = match ? match[1] : `${selectedCategory}-export.csv`;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
      } catch (err: any) {
        (window as any).showToast?.(err.message || 'Erreur lors du téléchargement', 'error');
      } finally {
        downloadBtn.disabled = false;
        downloadBtn.textContent = '⬇ Télécharger';
        updateDownloadBtn();
      }
    });

    // ── Init ──
    async function load() {
      try {
        const [mainData, labData] = await Promise.allSettled([
          api('/admin/exports/categories'),
          api('/admin/exports/lab-checks/categories'),
        ]);

        const mainCats: CategoryMeta[] = mainData.status === 'fulfilled'
          ? (mainData.value.categories ?? []).map((c: any) => ({ ...c, _apiBase: '/admin/exports' }))
          : [];

        const labCats: CategoryMeta[] = labData.status === 'fulfilled'
          ? (labData.value.categories ?? []).map((c: any) => ({ ...c, _apiBase: '/admin/exports/lab-checks' }))
          : [];

        categories = [...mainCats, ...labCats];

        catList.innerHTML = '';
        for (const cat of categories) {
          const btn = document.createElement('button');
          btn.className = 'export-cat-btn';
          btn.dataset.id = cat.id;
          btn.textContent = cat.label;
          btn.addEventListener('click', () => selectCategory(cat));
          catList.appendChild(btn);
        }

        loadingEl.style.display = 'none';
        exportBody.style.display = 'grid';
        showPreviewEmpty();
      } catch (e: any) {
        loadingEl.innerHTML = `<p class="text-bad p-6">${e.message}</p>`;
      }
    }

    load();
  </script>
</Admin>
