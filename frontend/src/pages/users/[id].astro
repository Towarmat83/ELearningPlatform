---
import App from '../../layouts/App.astro';
---
<App title="Profil">
  <style is:global>
    .up-page { padding: 28px 36px 80px; max-width: 900px; margin: 0 auto; }

    .up-header {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 32px;
      padding: 24px;
      border: 1.5px solid var(--line);
      border-radius: 14px;
      background: var(--paper);
    }

    .up-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue-soft), #d6ecfd);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 700;
      color: var(--blue);
      flex-shrink: 0;
      overflow: hidden;
    }
    .up-avatar img { width: 100%; height: 100%; object-fit: cover; }

    .up-username { font-size: 1.3rem; font-weight: 700; }
    .up-subtitle { font-size: .82rem; color: var(--ink-soft); margin-top: 2px; }

    .up-section-title {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 16px;
      color: var(--ink-soft);
      text-transform: uppercase;
      letter-spacing: .05em;
      font-size: .78rem;
    }

    .up-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .up-card {
      border: 1.5px solid #22c55e33;
      border-radius: 14px;
      background: var(--paper);
      padding: 20px 16px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      text-align: center;
      text-decoration: none;
      color: inherit;
      transition: box-shadow .15s, border-color .15s;
    }
    .up-card:hover { border-color: #22c55e; box-shadow: 0 4px 18px rgba(34,197,94,.12); }

    .up-card-icon {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f0fdf4, #dcfce7);
      border: 2px solid #22c55e44;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
    }
    .up-card-name { font-weight: 700; font-size: .9rem; }
    .up-card-course { font-size: .75rem; color: var(--ink-soft); }
    .up-card-earners {
      font-size: .68rem;
      color: #16a34a;
      background: #f0fdf4;
      border: 1px solid #22c55e33;
      border-radius: 20px;
      padding: 2px 10px;
      margin-top: auto;
    }

    .up-empty {
      text-align: center;
      padding: 48px 24px;
      color: var(--ink-soft);
      font-size: .9rem;
    }

    @media (max-width: 768px) { .up-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) {
      .up-page { padding: 20px 14px 80px; }
      .up-grid { grid-template-columns: 1fr; }
      .up-header { flex-direction: column; text-align: center; }
    }
  </style>

  <div class="up-page">
    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>
    <div id="up-content" style="display:none">
      <div class="up-header">
        <div class="up-avatar" id="up-avatar"></div>
        <div>
          <div class="up-username" id="up-username"></div>
          <div class="up-subtitle" id="up-subtitle"></div>
        </div>
      </div>

      <div class="up-section-title" id="up-section-label"></div>
      <div id="up-grid" class="up-grid"></div>
      <div id="up-empty" class="up-empty" style="display:none">Aucun badge pour l'instant.</div>
    </div>
  </div>

  <script>
    async function apiFetch(path: string) {
      const res = await fetch(`/api${path}`);
      if (!res.ok) { const err: any = new Error(); err.status = res.status; throw err; }
      return res.json();
    }

    const id = location.pathname.split('/').pop()!;

    async function init() {
      try {
        const [userRes, badgesRes] = await Promise.allSettled([
          apiFetch(`/users/${id}`),
          apiFetch(`/users/${id}/badges`),
        ]);

        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('up-content')!.style.display = '';

        // Header
        const user: any = userRes.status === 'fulfilled' ? userRes.value : null;
        const username = user?.username || 'Utilisateur';
        document.title = `${username} — pupitre`;
        document.getElementById('up-username')!.textContent = username;

        const avatarEl = document.getElementById('up-avatar')!;
        if (user?.avatarUrl) {
          const isUrl = user.avatarUrl.startsWith('http://') || user.avatarUrl.startsWith('https://');
          if (isUrl) {
            avatarEl.innerHTML = `<img src="${user.avatarUrl}" alt="${username}" />`;
          } else {
            avatarEl.style.fontSize = '2.2rem';
            avatarEl.textContent = user.avatarUrl;
          }
        } else {
          avatarEl.textContent = username[0].toUpperCase();
        }

        const badges: any[] = badgesRes.status === 'fulfilled'
          ? (badgesRes.value as any).badges || []
          : [];

        document.getElementById('up-subtitle')!.textContent =
          badges.length > 0
            ? `${badges.length} badge${badges.length > 1 ? 's' : ''} obtenu${badges.length > 1 ? 's' : ''}`
            : 'Aucun badge pour l\'instant';

        if (badges.length === 0) {
          document.getElementById('up-empty')!.style.display = '';
          return;
        }

        document.getElementById('up-section-label')!.textContent = 'Badges obtenus';

        document.getElementById('up-grid')!.innerHTML = badges.map((b: any) => `
          <a href="/courses/${b.courseSlug}" class="up-card">
            <div class="up-card-icon">${b.icon || '🏅'}</div>
            <div class="up-card-name">${b.name || b.courseSlug}</div>
            <div class="up-card-course">${b.courseTitle || b.courseSlug}</div>
            <div class="up-card-earners">${b.earnedBy} apprenant${b.earnedBy > 1 ? 's' : ''}</div>
          </a>
        `).join('');
      } catch {
        document.getElementById('loading')!.innerHTML =
          '<p style="text-align:center;color:var(--ink-soft);padding:40px">Profil introuvable.</p>';
      }
    }

    init();
  </script>
</App>
