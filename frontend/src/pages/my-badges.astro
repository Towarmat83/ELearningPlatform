---
import App from '../layouts/App.astro';
---
<App title="Mes badges" activePage="badges">
  <style is:global>
    .mb-page {
      min-height: calc(100vh - 64px);
      background: linear-gradient(160deg, #f0f4ff 0%, #faf5ff 50%, #f0fdf4 100%);
      padding: 40px 32px 80px;
    }
    .mb-inner { max-width: 1400px; margin: 0 auto; }

    .mb-header { margin-bottom: 32px; }
    .mb-title {
      font-size: 2rem; font-weight: 800; margin-bottom: 4px;
      background: linear-gradient(135deg, #4361ee, #7c3aed);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .mb-subtitle { font-size: .9rem; color: var(--ink-soft); }

    .mb-stats {
      display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 32px;
    }
    .mb-stat {
      background: #ffffffcc; border: 1.5px solid #e2e8f0;
      border-radius: 14px; padding: 16px 32px;
      display: flex; flex-direction: column; gap: 2px; align-items: center;
    }
    .mb-stat-val { font-size: 1.8rem; font-weight: 800; color: var(--blue); line-height: 1; }
    .mb-stat-label { font-size: .78rem; color: var(--ink-soft); }

    .mb-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
    }

    /* Badge gagné */
    .mb-card {
      border: 1.5px solid #22c55e33;
      border-radius: 16px;
      background: #ffffffcc;
      backdrop-filter: blur(8px);
      padding: 24px 16px 18px;
      display: flex; flex-direction: column; align-items: center;
      gap: 10px; text-align: center;
      text-decoration: none; color: inherit;
      transition: box-shadow .15s, border-color .15s, transform .15s;
    }
    .mb-card:hover { border-color: #22c55e; box-shadow: 0 6px 24px rgba(34,197,94,.15); transform: translateY(-3px); }

    .mb-card-icon {
      width: 80px; height: 80px; border-radius: 50%;
      background: linear-gradient(135deg, #f0fdf4, #dcfce7);
      border: 3px solid #22c55e44;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.4rem;
      box-shadow: 0 4px 16px rgba(34,197,94,.2);
    }
    .mb-card-name { font-weight: 700; font-size: .95rem; }
    .mb-card-course {
      font-size: .78rem; color: var(--ink-soft);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden; min-height: 2.4em;
    }
    .mb-card-earned-by {
      font-size: .7rem; color: #16a34a;
      background: #f0fdf4; border: 1px solid #22c55e33;
      border-radius: 20px; padding: 2px 10px;
      margin-top: auto;
    }
    .mb-card-date { font-size: .72rem; color: var(--ink-soft); }

    /* Badge non gagné */
    .mb-card-locked {
      border: 1.5px solid #e2e8f0;
      border-radius: 16px;
      background: #f8fafc99;
      backdrop-filter: blur(8px);
      padding: 24px 16px 18px;
      display: flex; flex-direction: column; align-items: center;
      gap: 10px; text-align: center;
      opacity: .55;
      filter: grayscale(1);
      position: relative;
    }
    .mb-card-locked-icon {
      width: 80px; height: 80px; border-radius: 50%;
      background: #f1f5f9;
      border: 3px solid #e2e8f0;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.4rem;
    }
    .mb-card-locked-name { font-weight: 700; font-size: .95rem; color: var(--ink-soft); }
    .mb-card-locked-course {
      font-size: .78rem; color: var(--ink-soft);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden; min-height: 2.4em;
    }
    .mb-lock-label {
      font-size: .7rem; color: #94a3b8;
      background: #f1f5f9; border: 1px solid #e2e8f0;
      border-radius: 20px; padding: 2px 10px;
      margin-top: auto;
    }

    .mb-section-title {
      font-size: .8rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: .06em;
      color: var(--ink-soft); margin: 28px 0 14px;
      display: flex; align-items: center; gap: 10px;
    }
    .mb-section-title::after { content: ''; flex: 1; height: 1px; background: #e2e8f0; }

    @media (max-width: 600px) {
      .mb-page { padding: 20px 14px 80px; }
      .mb-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>

  <div class="mb-page">
    <div class="mb-inner">
      <div class="mb-header">
        <h1 class="mb-title">Mes badges</h1>
        <p class="mb-subtitle" id="mb-subtitle">Chargement…</p>
      </div>

      <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

      <div id="mb-content" style="display:none">
        <div class="mb-stats" id="mb-stats"></div>
        <div id="mb-earned-section"></div>
        <div id="mb-locked-section"></div>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function apiFetch(path: string, auth = false) {
      const headers: Record<string, string> = {};
      if (auth && token) headers['Authorization'] = `Bearer ${token}`;
      const res = await fetch(`/api${path}`, { headers });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    function formatDate(iso: string) {
      return new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    }


    async function init() {
      if (!token) { window.location.href = '/login?redirect=/my-badges'; return; }

      try {
        const [myData, coursesData] = await Promise.all([
          apiFetch('/my/badges', true),
          apiFetch('/courses'),
        ]);

        const earned: any[] = myData.badges || [];
        const earnedSlugs = new Set(earned.map((b: any) => b.courseSlug));

        // Collect all badges from all courses
        const allCourses: any[] = coursesData.courses || [];
        const allBadges = allCourses
          .filter((c: any) => c.badge)
          .map((c: any) => ({ ...c.badge, courseSlug: c.slug, courseTitle: c.title }));

        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('mb-content')!.style.display = '';
        document.getElementById('mb-subtitle')!.textContent =
          `${earned.length} badge${earned.length !== 1 ? 's' : ''} obtenus sur ${allBadges.length} disponibles`;

        document.getElementById('mb-stats')!.innerHTML = `
          <div class="mb-stat">
            <span class="mb-stat-val">${earned.length}</span>
            <span class="mb-stat-label">Badge${earned.length !== 1 ? 's' : ''} obtenu${earned.length !== 1 ? 's' : ''}</span>
          </div>
          <div class="mb-stat">
            <span class="mb-stat-val">${allBadges.length - earned.length}</span>
            <span class="mb-stat-label">Badge${allBadges.length - earned.length !== 1 ? 's' : ''} à débloquer</span>
          </div>
          <div class="mb-stat">
            <span class="mb-stat-val">${allBadges.length > 0 ? Math.round(earned.length / allBadges.length * 100) : 0}%</span>
            <span class="mb-stat-label">Complété</span>
          </div>
        `;

        // Earned badges
        const earnedFull = earned.map((b: any) => {
          const course = allCourses.find((c: any) => c.slug === b.courseSlug);
          return { ...b, courseTitle: course?.title || b.courseSlug };
        });

        const earnedSection = document.getElementById('mb-earned-section')!;
        if (earnedFull.length > 0) {
          earnedSection.innerHTML = `
            <div class="mb-section-title">Obtenus (${earnedFull.length})</div>
            <div class="mb-grid">
              ${earnedFull.map((b: any) => `
                <a href="/courses/${b.courseSlug}" class="mb-card">
                  <div class="mb-card-icon">${b.icon || '🏅'}</div>
                  <div class="mb-card-name">${b.name || b.courseSlug}</div>
                  <div class="mb-card-course">${b.courseTitle}</div>
                  <div class="mb-card-earned-by">${b.earnedBy} apprenant${b.earnedBy > 1 ? 's' : ''}</div>
                  <div class="mb-card-date">Obtenu le ${formatDate(b.earnedAt)}</div>
                </a>
              `).join('')}
            </div>`;
        }

        // Locked badges
        const locked = allBadges.filter((b: any) => !earnedSlugs.has(b.courseSlug));
        const lockedSection = document.getElementById('mb-locked-section')!;
        if (locked.length > 0) {
          lockedSection.innerHTML = `
            <div class="mb-section-title">À débloquer (${locked.length})</div>
            <div class="mb-grid">
              ${locked.map((b: any) => `
                <div class="mb-card-locked">
                  <div class="mb-card-locked-icon">${b.icon || '🏅'}</div>
                  <div class="mb-card-locked-name">${b.name || b.courseSlug}</div>
                  <div class="mb-card-locked-course">${b.courseTitle}</div>
                  <div class="mb-lock-label">🔒 Non obtenu</div>
                </div>
              `).join('')}
            </div>`;
        }
      } catch {
        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('mb-content')!.style.display = '';
      }
    }

    init();
  </script>
</App>
