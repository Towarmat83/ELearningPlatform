---
import App from '../../layouts/App.astro';
---
<App title="Catalogue" activePage="catalogue">
  <style is:global>
    .cat-page { padding: 22px 26px 80px; }

    /* Continue hero */
    .continue-hero {
      display: flex;
      align-items: center;
      gap: 20px;
      background: var(--blue-soft);
      border: 1.5px solid var(--blue);
      border-radius: 10px;
      padding: 20px;
      cursor: pointer;
    }
    .continue-hero:hover { filter: brightness(.97); }
    .continue-thumb {
      width: 200px;
      height: 118px;
      border-radius: 10px;
      background: var(--fill);
      border: 1.5px solid var(--line);
      flex: 0 0 auto;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
    }
    .continue-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .continue-meta {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
      justify-content: center;
    }
    .continue-badge {
      display: inline-flex;
      align-items: center;
      height: 26px;
      padding: 0 11px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      background: var(--orange-soft);
      color: #9a5a00;
      border: 1px solid var(--orange);
      width: max-content;
    }
    .continue-title {
      font-weight: 700;
      font-size: 1rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .continue-prog {
      height: 8px;
      background: rgba(27,134,242,.18);
      border-radius: 5px;
      max-width: 340px;
      overflow: hidden;
    }
    .continue-prog-fill { height: 100%; background: var(--blue); border-radius: 5px; }
    .continue-sub { font-size: .8rem; color: var(--ink-soft); }
    .continue-btn {
      align-self: center;
      flex: 0 0 auto;
      height: 40px;
      padding: 0 18px;
      border-radius: 9px;
      background: var(--blue);
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      white-space: nowrap;
      transition: background .12s;
    }
    .continue-btn:hover { background: #1470d6; }

    /* Rails */
    .cat-rail { margin-top: 20px; }
    .cat-rail-header {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 12px;
    }
    .cat-rail-title { font-size: 1rem; font-weight: 700; color: var(--ink); }
    .cat-rail-count { font-size: .8rem; color: var(--ink-soft); }
    .rail-scroll {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      padding-bottom: 8px;
      -ms-overflow-style: none;
      scrollbar-width: thin;
      scrollbar-color: var(--line) transparent;
    }
    .rail-scroll::-webkit-scrollbar { height: 4px; }
    .rail-scroll::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }

    /* Rail card */
    .rail-card {
      flex: 0 0 auto;
      width: 210px;
      border: 1.5px solid var(--line);
      border-radius: 12px;
      background: var(--paper);
      overflow: hidden;
      cursor: pointer;
      transition: box-shadow .15s, border-color .15s;
    }
    .rail-card:hover { border-color: var(--blue); box-shadow: 0 4px 14px rgba(27,134,242,.15); }
    .rail-card-thumb {
      width: 100%;
      height: 108px;
      background: var(--fill);
      border-bottom: 1.5px solid var(--line);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
    }
    .rail-card-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .rail-card-body { padding: 12px; display: flex; flex-direction: column; gap: 6px; }
    .rail-card-title {
      font-size: .875rem;
      font-weight: 600;
      color: var(--ink);
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .rail-card-tags { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 2px; }
    .rail-card-tags .badge { font-size: 11px; }
    .rail-card-prog { height: 5px; background: var(--fill); border-radius: 3px; overflow: hidden; margin-top: 4px; }
    .rail-card-prog-fill { height: 100%; background: var(--blue); border-radius: 3px; }

    /* Page search bar */
    .cat-search-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
    }
    .cat-search-bar .search-wrap { position: relative; flex: 1; max-width: 480px; }
    .cat-search-bar .search-wrap svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--ink-soft); pointer-events: none; }
    .cat-search-bar .input { padding-left: 38px; width: 100%; height: 40px; font-size: .9rem; }

    /* Responsive */
    @media (max-width: 640px) {
      .cat-page { padding: 14px 14px 80px; }
      .continue-hero { flex-direction: column; align-items: stretch; gap: 14px; }
      .continue-thumb { width: 100%; height: 140px; }
      .continue-prog { max-width: 100%; }
      .continue-btn { align-self: stretch; width: 100%; }
      .rail-card { width: 180px; }
      .cat-search-bar .search-wrap { max-width: 100%; }
    }
  </style>

  <div class="cat-page">
    <!-- Search bar -->
    <div class="cat-search-bar">
      <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input class="input js-cat-search" type="search" placeholder="Rechercher un cours…" />
      </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="loading-state">
      <div class="spinner"></div>
      <span>Chargement des cours…</span>
    </div>

    <!-- Content -->
    <div id="cat-content" style="display:none">
      <!-- Continue hero -->
      <div id="continue-hero" style="display:none"></div>

      <!-- Empty state -->
      <div id="empty" style="display:none;text-align:center;padding:64px 24px">
        <div style="font-size:3rem;margin-bottom:16px">📭</div>
        <h3 style="margin-bottom:6px">Aucun cours trouvé</h3>
        <p class="text-soft text-sm">Essayez d'ajuster votre recherche</p>
      </div>

      <!-- Rails container -->
      <div id="rails-container"></div>
    </div>
  </div>

  <script>
    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error((err as any).error || `HTTP ${res.status}`); }
      return res.json();
    }

    const token = localStorage.getItem('token');
    let allCourses: any[] = [];
    let enrolledCourses: any[] = [];
    let enrolledIds = new Set<string>();
    let searchTimer: ReturnType<typeof setTimeout>;

    const diffLabels: Record<string, string> = { beginner: 'Débutant', intermediate: 'Intermédiaire', advanced: 'Avancé' };
    const diffColors: Record<string, string> = { beginner: 'badge-green', intermediate: 'badge-orange', advanced: 'badge-red' };

    function renderCourseCard(c: any): string {
      const enrolled = enrolledIds.has(c.id);
      const diff = c.difficulty ? `<span class="badge ${diffColors[c.difficulty] || 'badge-blue'}">${diffLabels[c.difficulty] || c.difficulty}</span>` : '';
      const cat = c.category ? `<span class="badge badge-blue">${c.category}</span>` : '';

      let footer = '';
      if (enrolled) {
        footer = `<div class="rail-card-prog"><div class="rail-card-prog-fill" style="width:100%"></div></div>`;
      }

      return `
        <div class="rail-card" onclick="goToCourse('${c.id}')">
          <div class="rail-card-thumb">
            ${c.thumbnail ? `<img src="${c.thumbnail}" alt="${c.title}" />` : '📖'}
          </div>
          <div class="rail-card-body">
            <div class="rail-card-title">${c.title}</div>
            <div class="rail-card-tags">${diff}${cat}</div>
            ${footer}
          </div>
        </div>
      `;
    }

    function renderContinueHero(course: any): string {
      const thumb = course.thumbnail
        ? `<img src="${course.thumbnail}" alt="${course.title}" />`
        : '📖';
      const labsDone = course.completed_labs ?? 0;
      const labsTotal = course.lab_count ?? 0;
      const pct = labsTotal > 0 ? Math.round(labsDone / labsTotal * 100) : 0;
      return `
        <div class="continue-hero" onclick="goToCourse('${course.id}')">
          <div class="continue-thumb">${thumb}</div>
          <div class="continue-meta">
            <div class="continue-badge">Reprendre</div>
            <div class="continue-title">${course.title}</div>
            <div class="continue-prog"><div class="continue-prog-fill" style="width:${pct}%"></div></div>
            <div class="continue-sub">${labsDone}/${labsTotal} modules</div>
          </div>
          <button class="continue-btn" onclick="event.stopPropagation();goToCourse('${course.id}')">Continuer ▸</button>
        </div>
      `;
    }

    function renderRails(courses: any[], search: string) {
      const q = search.toLowerCase().trim();
      const filtered = q
        ? courses.filter(c => c.title.toLowerCase().includes(q) || (c.description || '').toLowerCase().includes(q) || (c.category || '').toLowerCase().includes(q))
        : courses;

      if (filtered.length === 0) {
        document.getElementById('empty')!.style.display = 'block';
        document.getElementById('rails-container')!.innerHTML = '';
        return;
      }
      document.getElementById('empty')!.style.display = 'none';

      const categories = new Map<string, any[]>();
      for (const c of filtered) {
        const cat = c.category || 'Cours';
        if (!categories.has(cat)) categories.set(cat, []);
        categories.get(cat)!.push(c);
      }

      let html = '';
      for (const [cat, list] of categories) {
        html += `
          <div class="cat-rail">
            <div class="cat-rail-header">
              <h2 class="cat-rail-title">${cat}</h2>
              <span class="cat-rail-count">${list.length} cours</span>
            </div>
            <div class="rail-scroll">
              ${list.map(c => renderCourseCard(c)).join('')}
            </div>
          </div>
        `;
      }
      document.getElementById('rails-container')!.innerHTML = html;
    }

    (window as any).goToCourse = (id: string) => { window.location.href = `/courses/${id}`; };
    (window as any).enrollAndGo = async (id: string, e: Event) => {
      e.stopPropagation();
      if (!token) { window.location.href = `/login?redirect=/courses/${id}`; return; }
      try {
        await apiFetch(`/courses/${id}/enroll`, { method: 'POST', body: {}, token: token! });
      } catch { /* ok if already enrolled */ }
      window.location.href = `/courses/${id}`;
    };

    async function loadAll() {
      document.getElementById('loading')!.style.display = 'flex';
      try {
        const [coursesRes, enrolledRes] = await Promise.allSettled([
          apiFetch('/courses'),
          token ? apiFetch('/my/courses', { token: token! }) : Promise.resolve({ courses: [] }),
        ]);

        if (coursesRes.status === 'fulfilled') {
          allCourses = (coursesRes.value as any).courses || [];
        }
        if (enrolledRes.status === 'fulfilled') {
          enrolledCourses = (enrolledRes.value as any).courses || [];
          enrolledIds = new Set(enrolledCourses.map((c: any) => c.id));
        }

        const heroContainer = document.getElementById('continue-hero')!;
        const inProgress = enrolledCourses.filter((c: any) => {
          const p = c.lab_count > 0 ? c.completed_labs / c.lab_count : 0;
          return p > 0 && p < 1;
        });
        const heroTarget = inProgress[0] || enrolledCourses[0];
        if (heroTarget) {
          heroContainer.style.display = 'block';
          heroContainer.innerHTML = renderContinueHero(heroTarget);
        }

        renderRails(allCourses, '');
        document.getElementById('cat-content')!.style.display = 'block';
      } catch { /* show empty */ } finally {
        document.getElementById('loading')!.style.display = 'none';
      }
    }

    // Bind all search inputs (nav + mobile)
    const searchInputs = document.querySelectorAll<HTMLInputElement>('.js-cat-search');
    searchInputs.forEach(inp => {
      inp.addEventListener('input', () => {
        const q = inp.value;
        searchInputs.forEach(other => { if (other !== inp) other.value = q; });
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => renderRails(allCourses, q), 300);
      });
    });

    loadAll();
  </script>
</App>
