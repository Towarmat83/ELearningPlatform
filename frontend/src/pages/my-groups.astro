---
import App from '../layouts/App.astro';
---
<App title="Mes groupes" activePage="groups">
  <div class="page-outer">
    <div class="page-inner">
      <div class="mb-9">
        <h1 class="page-title mb-1">Mes groupes</h1>
        <p class="text-[.9rem] text-ink-soft" id="group-count">Chargement…</p>
      </div>

      <div id="groups-container">
        <div class="loading-state py-10"><div class="spinner"></div></div>
      </div>
    </div>
  </div>

  <script>
    async function api(path: string) {
      const token = localStorage.getItem('token');
      const res = await fetch('/api' + path, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.json();
    }

    async function load() {
      try {
        const [groupsRes, coursesRes] = await Promise.all([
          api('/my/groups'),
          api('/courses').catch(() => ({ courses: [] })),
        ]);

        const groups: any[] = groupsRes.groups || [];
        const allCourses: any[] = coursesRes.courses || [];
        const courseBySlug: Record<string, any> = {};
        for (const c of allCourses) courseBySlug[c.slug] = c;

        document.getElementById('group-count')!.textContent =
          groups.length ? `${groups.length} groupe${groups.length > 1 ? 's' : ''}` : "Vous n'appartenez à aucun groupe.";

        const container = document.getElementById('groups-container')!;

        if (!groups.length) {
          container.innerHTML = `
            <div class="mg-empty-card">
              <div class="text-[3rem] mb-3">👥</div>
              <p>Vous n'appartenez à aucun groupe pour le moment.</p>
              <p class="text-[.8rem] text-ink-soft mt-1.5">Un administrateur peut vous ajouter à un groupe.</p>
            </div>`;
          return;
        }

        container.innerHTML = `<div class="auto-grid-lg">${groups.map((g: any) => {
          const slugs: string[] = g.courseSlugs || [];
          const courses = slugs.map((s: string) => courseBySlug[s]).filter(Boolean);
          const isLocal = g.source === 'local';

          let roleBadge = '';
          if (g.mappedRole) {
            const cls = g.mappedRole === 'admin' ? 'mg-role-admin' : g.mappedRole === 'manager' ? 'mg-role-manager' : 'mg-role-student';
            const label = g.mappedRole === 'admin' ? 'Admin' : g.mappedRole === 'manager' ? 'Manager' : 'Étudiant';
            roleBadge = `<span class="mg-role-badge ${cls}">${label}</span>`;
          }

          const coursesHtml = courses.length
            ? courses.map((c: any) => `
                <a href="/courses/${c.slug}" class="mg-course-link">
                  <span class="mg-course-icon">${c.icon || '📘'}</span>
                  <span class="mg-course-title">${c.title || c.slug}</span>
                </a>`).join('')
            : `<p class="text-[.8rem] text-ink-soft italic">Aucun cours associé à ce groupe.</p>`;

          return `
            <div class="mg-card">
              <div class="mg-card-top">
                <div class="mg-icon ${isLocal ? 'local' : 'remote'}">${isLocal ? '🏠' : '🔗'}</div>
                <div>
                  <div class="mg-name">${g.name}</div>
                  <div class="mg-source">${isLocal ? 'Groupe local' : `Synchronisé depuis ${g.source}`}</div>
                </div>
                ${roleBadge}
              </div>
              <div class="h-px bg-line mb-3.5"></div>
              <div class="mg-courses-label">Cours du groupe</div>
              ${coursesHtml}
            </div>`;
        }).join('')}</div>`;
      } catch (e: any) {
        document.getElementById('groups-container')!.innerHTML =
          `<div class="mg-card text-bad">Erreur : ${e.message}</div>`;
      }
    }

    load();
  </script>
</App>
