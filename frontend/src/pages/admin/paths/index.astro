---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Parcours — Inscriptions">
  <div class="admin-page-header">
    <div>
      <h1 class="text-2xl">Parcours — Inscriptions</h1>
      <p class="text-soft text-sm mt-1">Gérer les utilisateurs inscrits à chaque parcours</p>
    </div>
  </div>

  <!-- Path selector -->
  <div class="flex items-center gap-3 mb-5 flex-wrap">
    <label class="label m-0 whitespace-nowrap">Parcours :</label>
    <select id="path-select" class="input w-auto min-w-[220px]">
      <option value="">Chargement…</option>
    </select>
    <span class="text-soft text-sm" id="enroll-count"></span>
  </div>

  <!-- Enroll form -->
  <div id="enroll-form" class="card mb-5" style="padding:16px 20px;display:none">
    <div class="flex-row-gap3-wrap">
      <select id="user-select" class="input flex-1 min-w-[200px]">
        <option value="">Sélectionner un utilisateur…</option>
      </select>
      <button id="enroll-btn" class="btn btn-primary btn-sm">Inscrire</button>
    </div>
  </div>

  <!-- Enrollments table -->
  <div class="card !p-0 overflow-x-auto" id="table-card">
    <table class="admin-table" id="enrollments-table">
      <thead>
        <tr class="admin-tr-head">
          <th class="admin-th">Utilisateur</th>
          <th class="admin-th">Progression</th>
          <th class="admin-th">Inscrit le</th>
          <th class="admin-th-right">Actions</th>
        </tr>
      </thead>
      <tbody id="enrollments-body">
        <tr><td colspan="4" class="p-8 text-center text-soft">Sélectionnez un parcours</td></tr>
      </tbody>
    </table>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers, body: opts.body ? JSON.stringify(opts.body) : undefined });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    let allUsers: any[] = [];
    let currentSlug = '';

    async function loadPaths() {
      const data = await api('/paths') as { paths: any[] };
      const paths = data.paths ?? [];
      const select = document.getElementById('path-select') as HTMLSelectElement;
      select.innerHTML = paths.length
        ? `<option value="">— Choisir un parcours —</option>` + paths.map((p: any) => `<option value="${p.slug}">${p.title}</option>`).join('')
        : `<option value="">Aucun parcours disponible</option>`;
    }

    async function loadUsers() {
      const data = await api('/admin/users') as { users: any[] };
      allUsers = data.users ?? [];
      const sel = document.getElementById('user-select') as HTMLSelectElement;
      sel.innerHTML = `<option value="">Sélectionner un utilisateur…</option>` +
        allUsers.map((u: any) => `<option value="${u.id}">${u.username} (${u.email})</option>`).join('');
    }

    async function loadEnrollments(slug: string) {
      const tbody = document.getElementById('enrollments-body')!;
      tbody.innerHTML = `<tr><td colspan="4" class="p-8 text-center"><div class="loading-state" style="padding:0"><div class="spinner"></div></div></td></tr>`;
      try {
        const data = await api(`/admin/paths/${slug}/enrollments`) as { users: any[] };
        const users = data.users ?? [];
        document.getElementById('enroll-count')!.textContent = `${users.length} inscrit${users.length > 1 ? 's' : ''}`;

        if (users.length === 0) {
          tbody.innerHTML = `<tr><td colspan="4" class="p-8 text-center text-soft">Aucun utilisateur inscrit à ce parcours</td></tr>`;
          return;
        }

        // Dynamic course status colors driven by data
        const statusColor: Record<string, string> = {
          completed: 'background:var(--good-soft);color:var(--good)',
          available:  'background:var(--blue-soft);color:var(--blue)',
          locked:     'background:var(--fill);color:var(--ink-soft)',
        };
        const statusIcon: Record<string, string> = { completed: '✓', available: '▶', locked: '🔒' };

        tbody.innerHTML = users.map((u: any) => {
          const pct = u.totalCourses > 0 ? Math.round(u.completedCourses / u.totalCourses * 100) : 0;
          const courses = (u.courses ?? []).map((c: any) =>
            `<span class="course-tag" style="${statusColor[c.status]}">${statusIcon[c.status]} ${c.slug}</span>`
          ).join(' ');
          const bar = u.totalCourses > 0 ? `
            <div class="path-progress-row">
              <div class="progress-track">
                <div class="progress-fill ${pct === 100 ? 'complete' : 'partial'}" style="width:${pct}%"></div>
              </div>
              <span class="path-progress-pct">${u.completedCourses}/${u.totalCourses}</span>
            </div>` : '';
          return `
          <tr class="admin-tr" data-uid="${u.userId}">
            <td class="admin-td">
              <div class="flex-row-gap3">
                <div class="user-avatar-sm">${(u.email||'?')[0].toUpperCase()}</div>
                <div>
                  <div class="username-text">${u.email.split('@')[0]}</div>
                  <div class="row-sub">${u.email}</div>
                </div>
              </div>
            </td>
            <td class="admin-td">
              <div class="flex flex-wrap gap-1">${courses}</div>
              ${bar}
            </td>
            <td class="admin-td text-soft text-sm whitespace-nowrap">${new Date(u.enrolledAt).toLocaleDateString('fr-FR')}</td>
            <td class="admin-td-right">
              <button class="btn btn-sm btn-danger unenroll-btn" data-uid="${u.userId}">Désinscrire</button>
            </td>
          </tr>`;
        }).join('');

        tbody.querySelectorAll<HTMLButtonElement>('.unenroll-btn').forEach(btn => {
          btn.addEventListener('click', () => unenroll(slug, btn.dataset.uid!));
        });
      } catch (e: any) {
        tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-bad">Erreur : ${e.message}</td></tr>`;
      }
    }

    async function enroll(slug: string, userId: string) {
      const btn = document.getElementById('enroll-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Inscription…';
      try {
        await api(`/admin/paths/${slug}/enrollments`, { method: 'POST', body: { userId: userId } });
        (window as any).showToast?.('Utilisateur inscrit au parcours', 'success');
        (document.getElementById('user-select') as HTMLSelectElement).value = '';
        await loadEnrollments(slug);
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Inscrire';
      }
    }

    async function unenroll(slug: string, userId: string) {
      if (!confirm('Désinscrire cet utilisateur du parcours ?')) return;
      try {
        await api(`/admin/paths/${slug}/enrollments/${userId}`, { method: 'DELETE' });
        (window as any).showToast?.('Utilisateur désinscrit', 'success');
        await loadEnrollments(slug);
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      }
    }

    document.getElementById('path-select')!.addEventListener('change', async (e) => {
      currentSlug = (e.target as HTMLSelectElement).value;
      const form = document.getElementById('enroll-form')!;
      if (!currentSlug) {
        form.style.display = 'none';
        document.getElementById('enroll-count')!.textContent = '';
        document.getElementById('enrollments-body')!.innerHTML = `<tr><td colspan="4" class="p-8 text-center text-soft">Sélectionnez un parcours</td></tr>`;
        return;
      }
      form.style.display = 'block';
      await loadEnrollments(currentSlug);
    });

    document.getElementById('enroll-btn')!.addEventListener('click', () => {
      const userId = (document.getElementById('user-select') as HTMLSelectElement).value;
      if (!userId) { (window as any).showToast?.('Sélectionnez un utilisateur', 'error'); return; }
      enroll(currentSlug, userId);
    });

    Promise.all([loadPaths(), loadUsers()]);
  </script>
</Admin>
