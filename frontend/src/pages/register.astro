---
import Base from '../layouts/Base.astro';
---
<Base title="Créer un compte">
  <div class="register-page">
    <div class="register-wrapper">
      <div class="register-header">
        <a href="/" class="register-logo">
          <img src="/pioupitre.png" alt="pioupitre" class="register-logo-img" />
          <span class="register-logo-text">pupitre</span>
        </a>
        <p class="text-soft text-sm">Créez votre compte pour commencer</p>
      </div>

      <div class="card">
        <div id="closed-msg" class="register-closed" style="display:none">
          <div class="register-closed-icon">🔒</div>
          <h2 class="mb-1.5">Inscriptions fermées</h2>
          <p class="text-soft text-sm">Les nouvelles inscriptions sont désactivées par l'administrateur.</p>
          <a href="/login" class="btn btn-primary mt-4 inline-flex">Retour à la connexion</a>
        </div>

        <form id="register-form" class="stack gap-4">
          <div class="form-group">
            <label class="label" for="username">Nom d'utilisateur</label>
            <input class="input" type="text" id="username" placeholder="johndoe" minlength="3" required autocomplete="username" />
          </div>
          <div class="form-group">
            <label class="label" for="email">Email</label>
            <input class="input" type="email" id="email" placeholder="vous@exemple.com" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label class="label" for="password">Mot de passe</label>
            <input class="input" type="password" id="password" placeholder="••••••••" required autocomplete="new-password" />
            <div id="password-rules" class="flex flex-col gap-1 mt-1.5" style="display:none"></div>
          </div>
          <div class="form-group">
            <label class="label" for="confirm">Confirmer le mot de passe</label>
            <input class="input" type="password" id="confirm" placeholder="••••••••" required autocomplete="new-password" />
            <p id="confirm-error" class="pw-error" style="display:none">Les mots de passe ne correspondent pas</p>
          </div>
          <button type="submit" class="btn btn-primary btn-lg w-full" id="register-btn">Créer un compte</button>
          <p id="register-error" class="text-bad text-[.85rem] text-center" style="display:none"></p>
        </form>

        <div class="register-footer">
          Déjà un compte ?
          <a href="/login" class="text-blue font-semibold">Se connecter</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function apiFetch(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error((err as any).error || `HTTP ${res.status}`);
      }
      return res.json();
    }

    let passwordMinLen = 8;
    let requireUppercase = false;
    let requireNumber = false;

    async function init() {
      try {
        const s = await apiFetch('/settings/public') as any;
        if (s.registration_enabled === 'false') {
          document.getElementById('register-form')!.style.display = 'none';
          document.getElementById('closed-msg')!.style.display = 'block';
          return;
        }
        passwordMinLen = parseInt(s.password_min_length, 10) || 8;
        requireUppercase = s.password_require_uppercase === 'true';
        requireNumber = s.password_require_number === 'true';
      } catch { /* defaults */ }
    }

    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const confirmInput = document.getElementById('confirm') as HTMLInputElement;
    const rulesDiv = document.getElementById('password-rules')!;

    function getRules(pw: string) {
      const rules = [
        { label: `Au moins ${passwordMinLen} caractères`, ok: pw.length >= passwordMinLen },
      ];
      if (requireUppercase) rules.push({ label: 'Au moins une majuscule', ok: /[A-Z]/.test(pw) });
      if (requireNumber) rules.push({ label: 'Au moins un chiffre', ok: /[0-9]/.test(pw) });
      return rules;
    }

    passwordInput.addEventListener('input', () => {
      const pw = passwordInput.value;
      if (!pw) { rulesDiv.style.display = 'none'; return; }
      rulesDiv.style.display = 'flex';
      const rules = getRules(pw);
      rulesDiv.innerHTML = rules.map(r =>
        `<div class="pw-rule ${r.ok ? 'ok' : ''}"><span>${r.ok ? '✓' : '○'}</span><span>${r.label}</span></div>`
      ).join('');
    });

    confirmInput.addEventListener('input', () => {
      const confirmErr = document.getElementById('confirm-error')!;
      if (confirmInput.value && confirmInput.value !== passwordInput.value) {
        confirmErr.style.display = 'block';
      } else {
        confirmErr.style.display = 'none';
      }
    });

    document.getElementById('register-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errEl = document.getElementById('register-error')!;
      errEl.style.display = 'none';

      const username = (document.getElementById('username') as HTMLInputElement).value;
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = passwordInput.value;
      const confirm = confirmInput.value;

      if (!username || !email || !password) { errEl.textContent = 'Veuillez remplir tous les champs'; errEl.style.display = 'block'; return; }
      if (password !== confirm) { errEl.textContent = 'Les mots de passe ne correspondent pas'; errEl.style.display = 'block'; return; }

      const rules = getRules(password);
      if (!rules.every(r => r.ok)) { errEl.textContent = 'Le mot de passe ne respecte pas les exigences'; errEl.style.display = 'block'; return; }

      const btn = document.getElementById('register-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Création…';

      try {
        const res = await apiFetch('/auth/register', { method: 'POST', body: { username, email, password } }) as any;
        localStorage.setItem('token', res.token);
        localStorage.setItem('user', JSON.stringify(res.user));
        window.location.href = '/courses';
      } catch (err: any) {
        errEl.textContent = err.message || 'Inscription échouée';
        errEl.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Créer un compte';
      }
    });

    if (localStorage.getItem('token')) {
      window.location.href = '/courses';
    } else {
      init();
    }
  </script>
</Base>
