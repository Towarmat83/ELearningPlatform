---
import App from '../../layouts/App.astro';
---
<App title="Administration">
  <div id="loading" class="loading-state"><div class="spinner"></div><span>Vérification…</span></div>
  <div id="admin-content" style="display:none">
    <div class="page-content">
      <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
          <div class="card-sm admin-sidebar-card">
            <div class="admin-sidebar-label">Administration</div>
            <nav class="sidebar-nav">
              <a href="/admin" class="sidebar-link active">📊 Tableau de bord</a>
              <a href="/admin/users" class="sidebar-link">👥 Utilisateurs</a>
              <a href="/admin/courses" class="sidebar-link">📚 Cours</a>
              <a href="/admin/groups" class="sidebar-link">🏷️ Groupes</a>
              <a href="/admin/patterns" class="sidebar-link">🔶 Patterns</a>
              <a href="/admin/leaderboard" class="sidebar-link">🏆 Classement</a>
              <a href="/admin/settings" class="sidebar-link">⚙️ Paramètres</a>
              <a href="/admin/monitoring" class="sidebar-link">📈 Monitoring</a>
            </nav>
          </div>
          <a href="/courses" class="btn btn-ghost btn-sm w-full justify-start">← Retour au catalogue</a>
        </aside>

        <!-- Main -->
        <div>
          <div class="mb-6">
            <h1>Administration</h1>
            <p class="text-soft mt-1">Panneau d'administration de la plateforme pupitre</p>
          </div>

          <!-- Stats cards -->
          <div class="stats-grid mb-7" id="stats-grid">
            <div class="card-sm text-center p-5">
              <div class="spinner mx-auto"></div>
            </div>
            <div class="card-sm text-center p-5">
              <div class="spinner mx-auto"></div>
            </div>
            <div class="card-sm text-center p-5">
              <div class="spinner mx-auto"></div>
            </div>
          </div>

          <!-- Notice -->
          <div class="card notice-box">
            <div class="notice-card">
              <img src="/pioupitre.png" alt="pioupitre" class="w-10 h-10 object-contain flex-none" />
              <div>
                <h3 class="notice-box-title">Interface d'administration pupitre</h3>
                <p class="text-soft text-sm leading-relaxed">
                  L'interface d'administration complète est accessible via les liens dans la barre latérale.
                  Les cours sont définis comme des CRDs Kubernetes — utilisez <code class="code-snippet">kubectl</code> pour gérer les ressources de cours directement.
                </p>
                <div class="notice-actions">
                  <a href="/admin/users" class="btn btn-primary btn-sm">Gérer les utilisateurs</a>
                  <a href="/admin/settings" class="btn btn-secondary btn-sm">Paramètres</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent leaderboard -->
          <div class="card mt-5">
            <h3 class="mb-4">Classement</h3>
            <div id="leaderboard-list">
              <div class="loading-state" style="padding:24px"><div class="spinner"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div id="forbidden" class="forbidden-page" style="display:none">
    <div class="forbidden-content">
      <div class="forbidden-icon">🔒</div>
      <h2 class="forbidden-title">Accès refusé</h2>
      <p class="text-soft text-sm forbidden-text">Vous devez être administrateur pour accéder à cette page.</p>
      <a href="/courses" class="btn btn-primary">Retour au catalogue</a>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user') || 'null');

    if (!token) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
    } else if (user?.role !== 'admin') {
      document.getElementById('loading')!.style.display = 'none';
      document.getElementById('forbidden')!.style.display = 'flex';
    } else {
      document.getElementById('loading')!.style.display = 'none';
      document.getElementById('admin-content')!.style.display = 'block';
      loadStats();
      loadLeaderboard();
    }

    async function apiFetch(path: string, opts: { method?: string; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers });
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error((err as any).error || `HTTP ${res.status}`); }
      return res.json();
    }

    async function loadStats() {
      try {
        const stats = await apiFetch('/admin/stats', { token: token! }) as any;
        const grid = document.getElementById('stats-grid')!;
        grid.innerHTML = `
          <div class="card-sm stat-card">
            <div class="stat-card-value" style="color:var(--blue)">${stats.total_users ?? '—'}</div>
            <div class="stat-card-label">Utilisateurs</div>
          </div>
          <div class="card-sm stat-card">
            <div class="stat-card-value" style="color:var(--blue)">${stats.totalCourses ?? '—'}</div>
            <div class="stat-card-label">Cours</div>
          </div>
          <div class="card-sm stat-card">
            <div class="stat-card-value" style="color:var(--good)">${stats.success_rate ?? '—'}</div>
            <div class="stat-card-label">Taux de réussite</div>
          </div>
        `;
      } catch {
        document.getElementById('stats-grid')!.innerHTML = '<div class="text-soft text-sm">Statistiques indisponibles</div>';
      }
    }

    async function loadLeaderboard() {
      try {
        const res = await apiFetch('/admin/leaderboard', { token: token! }) as any;
        const entries = (res.leaderboard || []).slice(0, 10);
        const list = document.getElementById('leaderboard-list')!;
        if (entries.length === 0) {
          list.innerHTML = '<p class="text-soft text-sm">Aucune donnée disponible.</p>';
          return;
        }
        list.innerHTML = entries.map((e: any, i: number) => `
          <div class="lb-row">
            <span class="lb-rank ${i < 3 ? 'top' : ''}">${i + 1}</span>
            <div class="lb-avatar">${(e.username || '?')[0].toUpperCase()}</div>
            <div class="lb-info">
              <div class="lb-name">${e.username}</div>
              <div class="lb-sub">${e.passedModules} modules · ${e.enrolledCourses} cours</div>
            </div>
            <span class="lb-score">${e.totalScore} pts</span>
          </div>
        `).join('');
      } catch {
        document.getElementById('leaderboard-list')!.innerHTML = '<p class="text-soft text-sm">Classement indisponible.</p>';
      }
    }
  </script>
</App>
