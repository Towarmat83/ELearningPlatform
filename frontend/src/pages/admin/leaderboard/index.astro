---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Classement">
  <div class="admin-page-header">
    <div>
      <h1 class="text-2xl">Classement</h1>
      <p class="text-soft text-sm mt-1">Progression globale des apprenants sur la plateforme</p>
    </div>
    <button class="btn btn-secondary btn-sm" id="sync-btn">⟳ Recalculer la progression</button>
  </div>

  <div class="card !p-0 overflow-hidden">
    <div class="flex items-center justify-between px-5 py-[18px] border-b border-line">
      <h2 class="text-[1.1rem]">Classement général</h2>
      <span id="lb-count" class="badge badge-gray"></span>
    </div>
    <div id="leaderboard-body">
      <div class="loading-state"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    async function api(path: string, opts: { method?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    async function loadLeaderboard() {
      const body = document.getElementById('leaderboard-body')!;
      const countEl = document.getElementById('lb-count')!;
      try {
        const { leaderboard } = await api('/admin/leaderboard');
        const entries: any[] = leaderboard || [];
        countEl.textContent = `${entries.length} participants`;
        if (!entries.length) {
          body.innerHTML = '<p class="text-soft text-sm p-6">Aucune donnée de classement.</p>';
          return;
        }
        body.innerHTML = entries.map((e: any, i: number) => `
          <div class="lb-row-padded">
            <span class="lb-rank-lg ${i < 3 ? 'top' : ''}">${i < 3 ? ['🥇','🥈','🥉'][i] : i + 1}</span>
            <div class="lb-avatar-lg ${e.role === 'admin' ? 'lb-avatar-admin' : 'lb-avatar-user'}">${(e.username || '?')[0].toUpperCase()}</div>
            <div class="lb-info">
              <div class="lb-name">${e.username}</div>
              <div class="lb-sub">${e.email || ''}</div>
              <div class="lb-stats">${e.enrolledCourses ?? 0} cours · ${e.passedModules ?? 0} modules validés</div>
            </div>
            <div class="lb-score-col">
              <div class="lb-score-main">${e.totalScore ?? 0} pts</div>
              ${e.success_rate != null ? `<div class="lb-score-rate">${e.success_rate}% réussite</div>` : ''}
            </div>
          </div>
        `).join('');
      } catch (err: any) {
        body.innerHTML = `<p class="text-bad p-6">${err.message}</p>`;
      }
    }

    document.getElementById('sync-btn')!.addEventListener('click', async () => {
      const btn = document.getElementById('sync-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Recalcul…';
      try {
        await api('/admin/sync-progress', { method: 'POST' });
        (window as any).showToast?.('Progression recalculée', 'success');
        loadLeaderboard();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = '⟳ Recalculer la progression';
      }
    });

    loadLeaderboard();
  </script>
</Admin>
