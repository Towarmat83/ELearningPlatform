---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Labs — Suivi apprenant">
  <div class="admin-page-header">
    <div>
      <h1 class="text-2xl">Suivi des Labs</h1>
      <p class="text-soft text-sm mt-1" id="result-count">Chargement…</p>
    </div>
    <div class="flex gap-2 items-center flex-wrap">
      <select id="course-filter" class="input select-sm min-w-[200px]">
        <option value="">Tous les cours</option>
      </select>
      <button id="refresh-btn" class="btn btn-secondary">Actualiser</button>
    </div>
  </div>

  <!-- Stats rapides -->
  <div id="stats-row" class="auto-grid-160"></div>

  <!-- Table -->
  <div class="card !p-0 overflow-x-auto">
    <table class="admin-table" id="lab-table">
      <thead>
        <tr class="admin-tr-head">
          <th class="admin-th">Apprenant</th>
          <th class="admin-th">Cours</th>
          <th class="admin-th">Lab</th>
          <th class="admin-th">Statut</th>
          <th class="admin-th">Violations</th>
          <th class="admin-th">Vérifié le</th>
        </tr>
      </thead>
      <tbody id="lab-body">
        <tr><td colspan="6" class="p-8 text-center"><div class="loading-state !p-0"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div></td></tr>
      </tbody>
    </table>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string) {
      const res = await fetch('/api' + path, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    function fmt(dt: string) {
      return new Date(dt).toLocaleString('fr-FR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
    }

    function statusBadge(allow: boolean) {
      return allow
        ? `<span class="labs-status-ok">✓ Validé</span>`
        : `<span class="labs-status-fail">✗ Échec</span>`;
    }

    let allRows: any[] = [];
    let allCourses: string[] = [];

    async function populateCourseFilter(current: string) {
      if (allCourses.length === 0) {
        const rows = await api('/admin/lab-checks');
        allCourses = [...new Set(rows.map((r: any) => r.courseSlug))].sort() as string[];
      }
      const sel = document.getElementById('course-filter') as HTMLSelectElement;
      sel.innerHTML = `<option value="">Tous les cours</option>` +
        allCourses.map((c: string) => `<option value="${c}" ${c === current ? 'selected' : ''}>${c}</option>`).join('');
    }

    async function load(course = '') {
      const body = document.getElementById('lab-body')!;
      body.innerHTML = `<tr><td colspan="6" class="p-8 text-center"><div class="loading-state !p-0"><div class="spinner"></div></div></td></tr>`;

      const qs = course ? `?course=${encodeURIComponent(course)}` : '';
      allRows = await api(`/admin/lab-checks${qs}`);

      await populateCourseFilter(course);
      render(allRows);
    }

    function render(rows: any[]) {
      const body = document.getElementById('lab-body')!;
      const count = document.getElementById('result-count')!;
      const stats = document.getElementById('stats-row')!;

      const total = rows.length;
      const passed = rows.filter((r: any) => r.allow).length;
      const failed = total - passed;
      const unique = new Set(rows.map((r: any) => r.username)).size;

      count.textContent = `${total} vérification${total > 1 ? 's' : ''} — ${unique} apprenant${unique > 1 ? 's' : ''}`;

      stats.innerHTML = [
        { label: 'Total vérifications', value: total,  cls: 'text-blue'  },
        { label: 'Labs validés',        value: passed, cls: 'text-good'  },
        { label: 'Labs échoués',        value: failed, cls: 'text-bad'   },
        { label: 'Apprenants actifs',   value: unique, cls: 'text-ink'   },
      ].map(s => `
        <div class="card stat-card">
          <div class="stat-card-value ${s.cls}">${s.value}</div>
          <div class="stat-card-label">${s.label}</div>
        </div>
      `).join('');

      if (rows.length === 0) {
        body.innerHTML = `<tr><td colspan="6" class="p-10 text-center text-soft">Aucune vérification enregistrée.</td></tr>`;
        return;
      }

      body.innerHTML = rows.map((r: any) => `
        <tr class="admin-tr">
          <td class="admin-td">
            <div class="flex-row-gap2">
              <div class="user-avatar-sm">${r.username[0].toUpperCase()}</div>
              <span class="font-medium">${r.username}</span>
            </div>
          </td>
          <td class="admin-td text-soft text-sm">${r.courseSlug}</td>
          <td class="admin-td text-sm">${r.moduleName}</td>
          <td class="admin-td">${statusBadge(r.allow)}</td>
          <td class="admin-td max-w-[340px]">
            ${r.violations && r.violations.length
              ? r.violations.map((v: string) => `<div class="violation-item">• ${v}</div>`).join('')
              : `<span class="text-soft text-sm">—</span>`}
          </td>
          <td class="admin-td text-soft text-sm whitespace-nowrap">${fmt(r.checkedAt)}</td>
        </tr>
      `).join('');
    }

    document.getElementById('course-filter')!.addEventListener('change', (e) => {
      load((e.target as HTMLSelectElement).value);
    });

    document.getElementById('refresh-btn')!.addEventListener('click', () => {
      const sel = document.getElementById('course-filter') as HTMLSelectElement;
      load(sel.value);
    });

    load();
  </script>
</Admin>
