---
import Admin from '../../layouts/Admin.astro';
---
<Admin title="Tableau de bord">
  <div>
    <div style="margin-bottom:28px">
      <h1 style="font-size:1.5rem">Tableau de bord</h1>
      <p class="text-soft text-sm" style="margin-top:4px">Vue d'ensemble de la plateforme pupitre</p>
    </div>

    <!-- Stats grid -->
    <div id="stats-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:32px">
      {[0,1,2,3,4,5].map(() => (
        <div class="card-sm" style="text-align:center;padding:20px">
          <div class="spinner" style="margin:0 auto 8px"></div>
          <div class="text-soft text-xs">Chargement…</div>
        </div>
      ))}
    </div>

    <!-- Leaderboard -->
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
        <h2 style="font-size:1.1rem">Classement</h2>
        <a href="/admin/monitoring" class="btn btn-secondary btn-sm">Voir tout →</a>
      </div>
      <div id="leaderboard"></div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string) {
      const res = await fetch('/api' + path, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    const STAT_LABELS: Record<string, { label: string; color: string }> = {
      total_users:       { label: 'Utilisateurs',   color: 'var(--blue)'  },
      totalCourses:     { label: 'Cours',           color: 'var(--blue)'  },
      total_labs:        { label: 'Labs',            color: 'var(--blue)'  },
      total_enrollments: { label: 'Inscriptions',    color: 'var(--orange)'},
      total_submissions: { label: 'Soumissions',     color: 'var(--ink)'   },
      success_rate:      { label: 'Taux de réussite',color: 'var(--good)'  },
    };

    async function loadStats() {
      const grid = document.getElementById('stats-grid')!;
      try {
        const s = await api('/admin/stats');
        grid.innerHTML = Object.entries(STAT_LABELS).map(([k, { label, color }]) => `
          <div class="card-sm" style="text-align:center;padding:20px">
            <div style="font-size:2rem;font-weight:700;color:${color}">${s[k] ?? '—'}</div>
            <div class="text-soft text-sm" style="margin-top:4px">${label}</div>
          </div>
        `).join('');
      } catch {
        grid.innerHTML = '<div class="text-soft text-sm" style="grid-column:1/-1">Statistiques indisponibles</div>';
      }
    }

    async function loadLeaderboard() {
      const el = document.getElementById('leaderboard')!;
      try {
        const { leaderboard } = await api('/admin/leaderboard');
        const top = (leaderboard || []).slice(0, 8);
        if (!top.length) { el.innerHTML = '<p class="text-soft text-sm">Aucune donnée.</p>'; return; }
        el.innerHTML = top.map((e: any, i: number) => `
          <div style="display:flex;align-items:center;gap:12px;padding:10px 0;${i < top.length - 1 ? 'border-bottom:1px solid var(--line)' : ''}">
            <span style="width:24px;text-align:center;font-weight:700;font-size:.9rem;color:${i < 3 ? 'var(--orange)' : 'var(--ink-soft)'}">${i + 1}</span>
            <div style="width:32px;height:32px;border-radius:50%;background:var(--blue-soft);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--blue);font-size:.82rem;flex-shrink:0">${(e.username||'?')[0].toUpperCase()}</div>
            <div style="flex:1;min-width:0">
              <div style="font-weight:500;font-size:.875rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${e.username}</div>
              <div style="font-size:.75rem;color:var(--ink-soft)">${e.passedModules} modules · ${e.enrolledCourses} cours</div>
            </div>
            <span style="font-weight:700;color:var(--blue);flex-shrink:0">${e.totalScore} pts</span>
          </div>
        `).join('');
      } catch {
        el.innerHTML = '<p class="text-soft text-sm">Classement indisponible.</p>';
      }
    }

    loadStats();
    loadLeaderboard();
  </script>
</Admin>
