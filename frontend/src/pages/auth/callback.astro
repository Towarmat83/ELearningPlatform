---
import Base from '../../layouts/Base.astro';
---
<Base title="Connexion…">
  <div class="min-h-screen bg-page flex items-center justify-center p-6">
    <div class="card w-full max-w-[380px] text-center px-10 py-12">
      <div id="loading-state">
        <div class="spinner w-12 h-12 border-[3px] mx-auto mb-5"></div>
        <h2 class="mb-2">Finalisation de la connexion…</h2>
        <p class="text-ink-soft text-[.875rem]">Veuillez patienter pendant la vérification de votre identité.</p>
      </div>
      <div id="error-state" class="hidden">
        <div class="text-[2.5rem] mb-4">✕</div>
        <h2 class="text-bad mb-2">Connexion échouée</h2>
        <p id="error-msg" class="text-ink-soft text-[.875rem] mb-6"></p>
        <a href="/login" class="btn btn-primary">Retour à la connexion</a>
      </div>
    </div>
  </div>

  <script>
    function showError(msg: string) {
      document.getElementById('loading-state')!.classList.add('hidden');
      document.getElementById('error-state')!.classList.remove('hidden');
      document.getElementById('error-msg')!.textContent = msg;
    }

    async function apiFetch(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error((err as any).error || `HTTP ${res.status}`);
      }
      return res.json();
    }

    function decodeStateProvider(state: string): string {
      try {
        const payload = JSON.parse(atob(state.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
        return payload.provider || '';
      } catch {
        return '';
      }
    }

    async function handleCallback() {
      const params = new URLSearchParams(window.location.search);
      const code = params.get('code');
      const state = params.get('state');
      const error = params.get('error');

      if (error) {
        showError(error === 'access_denied'
          ? 'Accès refusé — vous avez annulé la connexion.'
          : `Erreur OAuth : ${error}`);
        return;
      }

      if (!code || !state) {
        showError('Paramètres OAuth manquants. Veuillez réessayer.');
        return;
      }

      try {
        const provider = decodeStateProvider(state);
        const res = provider === 'oidc'
          ? await apiFetch('/auth/oidc/callback', { method: 'POST', body: { code, state } })
          : await apiFetch('/auth/oauth/callback', { method: 'POST', body: { code, state } });

        localStorage.setItem('token', (res as any).token);
        localStorage.setItem('user', JSON.stringify((res as any).user));

        const user = (res as any).user;
        window.location.href = user?.role === 'admin' ? '/admin' : '/courses';
      } catch (e: any) {
        showError(e.message || 'Authentification SSO échouée. Veuillez réessayer.');
      }
    }

    handleCallback();
  </script>
</Base>
