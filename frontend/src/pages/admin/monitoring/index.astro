---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Monitoring">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px">
    <div>
      <h1 style="font-size:1.5rem">Monitoring</h1>
      <p class="text-soft text-sm" style="margin-top:4px">Statistiques et activité de la plateforme</p>
    </div>
    <div style="display:flex;gap:8px">
      <a href="/admin/leaderboard" class="btn btn-secondary btn-sm">🏆 Classement complet</a>
      <button class="btn btn-secondary btn-sm" id="sync-btn">⟳ Recalculer la progression</button>
    </div>
  </div>

  <!-- Stats grid -->
  <div id="stats-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:28px">
    {[0,1,2,3,4,5].map(() => (
      <div class="card-sm" style="text-align:center;padding:20px">
        <div class="spinner" style="margin:0 auto 8px"></div>
        <div class="text-soft text-xs">Chargement…</div>
      </div>
    ))}
  </div>

  <!-- Courses overview -->
  <div class="card" style="padding:0;overflow:hidden;margin-bottom:28px">
    <div style="padding:18px 20px;border-bottom:1px solid var(--line)">
      <h2 style="font-size:1.1rem">Aperçu des cours</h2>
    </div>
    <div id="courses-overview">
      <div class="loading-state"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div>
    </div>
  </div>

  <!-- Top leaderboard (preview) -->
  <div class="card" style="padding:0;overflow:hidden">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line)">
      <h2 style="font-size:1.1rem">Top 10 — Classement</h2>
      <a href="/admin/leaderboard" class="text-soft text-sm" style="color:var(--blue)">Voir tout →</a>
    </div>
    <div id="leaderboard-body">
      <div class="loading-state"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string, opts: { method?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    const STAT_DEFS: { key: string; label: string; color: string; fmt?: (v: any) => string }[] = [
      { key: 'total_users',       label: 'Utilisateurs',    color: 'var(--blue)'   },
      { key: 'total_courses',     label: 'Cours',           color: 'var(--blue)'   },
      { key: 'total_enrollments', label: 'Inscriptions',    color: 'var(--orange)' },
      { key: 'total_submissions', label: 'Soumissions',     color: 'var(--ink)'    },
      { key: 'total_labs',        label: 'Labs',            color: 'var(--blue)'   },
      { key: 'success_rate',      label: 'Taux de réussite',color: 'var(--good)',  fmt: (v) => v != null ? `${v}%` : '—' },
    ];

    async function loadStats() {
      const grid = document.getElementById('stats-grid')!;
      try {
        const s = await api('/admin/stats');
        grid.innerHTML = STAT_DEFS.map(({ key, label, color, fmt }) => {
          const raw = s[key];
          const val = raw != null ? (fmt ? fmt(raw) : raw) : '—';
          return `
            <div class="card-sm" style="text-align:center;padding:20px">
              <div style="font-size:2rem;font-weight:700;color:${color};line-height:1">${val}</div>
              <div class="text-soft text-sm" style="margin-top:6px">${label}</div>
            </div>
          `;
        }).join('');
      } catch {
        grid.innerHTML = '<div class="text-soft text-sm" style="grid-column:1/-1;padding:16px">Statistiques indisponibles</div>';
      }
    }

    async function loadCoursesOverview() {
      const el = document.getElementById('courses-overview')!;
      try {
        const res = await api('/admin/courses');
        const courses: any[] = res.courses || [];
        if (!courses.length) {
          el.innerHTML = '<p class="text-soft text-sm" style="padding:20px">Aucun cours.</p>';
          return;
        }
        el.innerHTML = `
          <table style="width:100%;border-collapse:collapse;font-size:.85rem">
            <thead>
              <tr style="border-bottom:1px solid var(--line);background:var(--fill)">
                <th style="padding:10px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">Titre</th>
                <th style="padding:10px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">Catégorie</th>
                <th style="padding:10px 16px;text-align:center;font-weight:600;color:var(--ink-soft);font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">Labs</th>
                <th style="padding:10px 16px;text-align:center;font-weight:600;color:var(--ink-soft);font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">Inscrits</th>
                <th style="padding:10px 16px;text-align:center;font-weight:600;color:var(--ink-soft);font-size:.75rem;text-transform:uppercase;letter-spacing:.05em">Accès</th>
              </tr>
            </thead>
            <tbody>
              ${courses.map((c: any, i: number) => `
                <tr style="${i < courses.length - 1 ? 'border-bottom:1px solid var(--line)' : ''}">
                  <td style="padding:10px 16px">
                    <div style="font-weight:500">${c.title}</div>
                    <div style="font-size:.72rem;color:var(--ink-soft);margin-top:1px;font-family:monospace">${c.id}</div>
                  </td>
                  <td style="padding:10px 16px;color:var(--ink-soft)">${c.category || '—'}</td>
                  <td style="padding:10px 16px;text-align:center">${c.lab_count ?? '—'}</td>
                  <td style="padding:10px 16px;text-align:center">${c.enrollment_count ?? 0}</td>
                  <td style="padding:10px 16px;text-align:center"><span class="badge ${c.is_public ? 'badge-green' : 'badge-gray'}" style="font-size:.72rem">${c.is_public ? 'Public' : 'Privé'}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      } catch (e: any) {
        el.innerHTML = `<p style="color:var(--bad);padding:20px">${e.message}</p>`;
      }
    }

    async function loadLeaderboard() {
      const body = document.getElementById('leaderboard-body')!;
      try {
        const { leaderboard } = await api('/admin/leaderboard');
        const entries: any[] = (leaderboard || []).slice(0, 10);
        if (!entries.length) {
          body.innerHTML = '<p class="text-soft text-sm" style="padding:24px">Aucune donnée.</p>';
          return;
        }
        body.innerHTML = entries.map((e: any, i: number) => `
          <div style="display:flex;align-items:center;gap:14px;padding:13px 20px;${i < entries.length - 1 ? 'border-bottom:1px solid var(--line)' : ''}">
            <span style="width:28px;text-align:center;font-weight:700;font-size:.9rem;flex-shrink:0;color:${i < 3 ? 'var(--orange)' : 'var(--ink-soft)'}">${i < 3 ? ['🥇','🥈','🥉'][i] : i + 1}</span>
            <div style="width:36px;height:36px;border-radius:50%;background:${e.role === 'admin' ? 'var(--bad-soft)' : 'var(--blue-soft)'};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.82rem;color:${e.role === 'admin' ? 'var(--bad)' : 'var(--blue)'};flex-shrink:0">${(e.username || '?')[0].toUpperCase()}</div>
            <div style="flex:1;min-width:0">
              <div style="font-weight:500;font-size:.875rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${e.username}</div>
              <div style="font-size:.72rem;color:var(--ink-soft);margin-top:1px">${e.enrolled_courses ?? 0} cours · ${e.passed_modules ?? 0} modules validés</div>
            </div>
            <div style="text-align:right;flex-shrink:0">
              <div style="font-weight:700;color:var(--blue);font-size:.95rem">${e.total_score ?? 0} pts</div>
              ${e.success_rate != null ? `<div style="font-size:.72rem;color:var(--ink-soft)">${e.success_rate}% réussite</div>` : ''}
            </div>
          </div>
        `).join('');
      } catch (err: any) {
        body.innerHTML = `<p style="color:var(--bad);padding:24px">${err.message}</p>`;
      }
    }

    document.getElementById('sync-btn')!.addEventListener('click', async () => {
      const btn = document.getElementById('sync-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Recalcul…';
      try {
        await api('/admin/sync-progress', { method: 'POST' });
        (window as any).showToast?.('Progression recalculée', 'success');
        loadLeaderboard();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = '⟳ Recalculer la progression';
      }
    });

    loadStats();
    loadCoursesOverview();
    loadLeaderboard();
  </script>
</Admin>
