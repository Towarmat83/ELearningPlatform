---
import Base from '../layouts/Base.astro';
---
<Base title="Connexion">
  <style is:global>
    .lbg {
      min-height: 100vh;
      background: var(--fill);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 16px;
    }
    .lcard {
      width: 430px;
      max-width: 100%;
      background: var(--paper);
      border: 1.5px solid var(--line);
      border-radius: 18px;
      padding: 36px 36px 30px;
      box-shadow: 0 20px 50px -28px rgba(30,60,120,.45);
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .l-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }
    .l-logo img { width: 60px; height: 60px; object-fit: contain; }
    .l-logo .l-name { font-family: 'Caveat', cursive; font-size: 2.2rem; font-weight: 700; color: var(--ink); line-height: 1; }
    .l-seg {
      display: flex;
      background: var(--fill);
      border-radius: 11px;
      padding: 4px;
      gap: 3px;
    }
    .l-seg .seg-btn {
      flex: 1;
      height: 34px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      color: var(--ink-soft);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: .12s;
    }
    .l-seg .seg-btn.active {
      background: var(--blue);
      color: #fff;
    }
    .l-fields {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .l-fields .input { height: 44px; }
    .l-err {
      background: var(--bad-soft);
      border: 1px solid var(--bad);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: .875rem;
      color: var(--bad);
    }
    .sso-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      height: 46px;
      padding: 0 16px;
      border-radius: 9px;
      border: 1.5px solid var(--line);
      background: var(--paper);
      font-size: 14px;
      font-weight: 500;
      color: var(--ink);
      width: 100%;
      cursor: pointer;
      transition: .12s;
      text-align: left;
    }
    .sso-btn:hover { border-color: var(--blue); background: var(--blue-soft); }
    .sso-btn:disabled { opacity: .5; cursor: not-allowed; }
    .l-register {
      text-align: center;
      font-size: .875rem;
      color: var(--ink-soft);
    }
    .l-register a { color: var(--blue); font-weight: 600; }

    /* ── Responsive ── */
    @media (max-width: 480px) {
      .lbg { padding: 20px 12px; align-items: flex-start; padding-top: 32px; }
      .lcard { padding: 28px 20px 22px; border-radius: 14px; }
      .l-logo img { width: 48px; height: 48px; }
      .l-logo .l-name { font-size: 1.8rem; }
    }
  </style>

  <div class="lbg">
    <div class="lcard">
      <div class="l-logo">
        <img src="/pioupitre.png" alt="pioupitre" />
        <span class="l-name">pupitre</span>
      </div>

      <div class="l-seg" id="login-seg">
        <button class="seg-btn active" data-tab="password">Mot de passe</button>
        <button class="seg-btn" data-tab="sso" id="seg-sso" style="display:none">SSO</button>
        <button class="seg-btn" data-tab="ldap" id="seg-ldap" style="display:none">LDAP</button>
      </div>

      <div class="l-err" id="login-error" style="display:none"></div>

      <!-- Tab: Password -->
      <div id="tab-password">
        <form id="login-form" class="l-fields">
          <input class="input" type="email" id="email" placeholder="identifiant ou e-mail" required autocomplete="email" />
          <input class="input" type="password" id="password" placeholder="mot de passe" required autocomplete="current-password" />
          <button type="submit" class="btn btn-primary btn-lg w-full" id="login-btn">Se connecter</button>
        </form>
      </div>

      <!-- Tab: SSO -->
      <div id="tab-sso" style="display:none">
        <div id="sso-list" class="l-fields"></div>
      </div>

      <!-- Tab: LDAP -->
      <div id="tab-ldap" style="display:none">
        <form id="ldap-form" class="l-fields">
          <input class="input" type="text" id="ldap-user" placeholder="identifiant LDAP" required />
          <input class="input" type="password" id="ldap-pass" placeholder="mot de passe" required autocomplete="current-password" />
          <button type="submit" class="btn btn-primary btn-lg w-full" id="ldap-btn">Se connecter</button>
        </form>
      </div>

      <div class="divider"></div>
      <div class="l-register" id="register-link">
        Pas encore de compte ? <a href="/register">Créer un compte</a>
      </div>
    </div>
  </div>

  <script>
    async function apiFetch(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error((err as any).error || `HTTP ${res.status}`);
      }
      return res.json();
    }

    function showError(msg: string) {
      const el = document.getElementById('login-error')!;
      el.textContent = msg;
      el.style.display = 'block';
    }
    function hideError() {
      document.getElementById('login-error')!.style.display = 'none';
    }

    // Tab switching
    const seg = document.getElementById('login-seg')!;
    seg.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.seg-btn') as HTMLButtonElement;
      if (!btn || !btn.dataset.tab) return;
      hideError();
      const tab = btn.dataset.tab;
      seg.querySelectorAll('.seg-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      ['password', 'sso', 'ldap'].forEach(t => {
        const el = document.getElementById(`tab-${t}`)!;
        if (el) el.style.display = t === tab ? 'block' : 'none';
      });
    });

    async function init() {
      let oidcEnabled = false;
      let ldapEnabled = false;
      let registrationEnabled = true;

      try {
        const settings = await apiFetch('/settings/public') as any;
        oidcEnabled = settings.oidc_enabled === 'true';
        ldapEnabled = settings.ldap_enabled === 'true';
        registrationEnabled = settings.registration_enabled !== 'false';
      } catch { /* use defaults */ }

      if (!registrationEnabled) {
        const rl = document.getElementById('register-link');
        if (rl) rl.style.display = 'none';
      }

      // SSO providers
      let providers: { id: string; name: string }[] = [];
      try {
        const res = await apiFetch('/auth/oauth/providers') as any;
        providers = res.providers || [];
      } catch { /* no providers */ }

      const hasSso = providers.length > 0 || oidcEnabled;
      if (hasSso) {
        document.getElementById('seg-sso')!.style.display = '';
        const ssoList = document.getElementById('sso-list')!;
        const providerIcons: Record<string, string> = {
          github: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
          google: `<svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>`,
          gitlab: `<svg width="18" height="18" viewBox="0 0 24 24" fill="#FC6D26"><path d="M22.65 14.39L12 22.13 1.35 14.39a.84.84 0 0 1-.3-.94l1.22-3.78 2.44-7.51A.42.42 0 0 1 4.82 2a.43.43 0 0 1 .58 0 .42.42 0 0 1 .11.18l2.44 7.49h8.1l2.44-7.49a.42.42 0 0 1 .11-.18.43.43 0 0 1 .58 0 .42.42 0 0 1 .11.18l2.44 7.51L23 13.45a.84.84 0 0 1-.35.94z"/></svg>`,
        };

        for (const p of providers) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'sso-btn';
          btn.innerHTML = `${providerIcons[p.id] ?? '<span style="width:18px;height:18px;border-radius:4px;background:var(--fill);display:inline-block"></span>'}<span>Continuer avec ${p.name}</span>`;
          btn.addEventListener('click', () => loginWithProvider(p.id));
          ssoList.appendChild(btn);
        }

        if (oidcEnabled) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'sso-btn';
          btn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg><span>Continuer avec SSO (OIDC)</span>`;
          btn.addEventListener('click', loginWithOIDC);
          ssoList.appendChild(btn);
        }
      }

      if (ldapEnabled) {
        document.getElementById('seg-ldap')!.style.display = '';
      }

      // Hide the tab switcher when only one tab is visible (avoids a lone blue button)
      const visibleTabs = [hasSso, ldapEnabled].filter(Boolean).length;
      if (visibleTabs === 0) {
        document.getElementById('login-seg')!.style.display = 'none';
      }
    }

    async function loginWithProvider(id: string) {
      document.querySelectorAll<HTMLButtonElement>('.sso-btn').forEach(b => { b.disabled = true; });
      try {
        const res = await apiFetch(`/auth/oauth/${id}/authorize`) as any;
        window.location.href = res.url;
      } catch (e: any) {
        document.querySelectorAll<HTMLButtonElement>('.sso-btn').forEach(b => { b.disabled = false; });
        showError(e.message || 'Erreur SSO');
      }
    }

    async function loginWithOIDC() {
      document.querySelectorAll<HTMLButtonElement>('.sso-btn').forEach(b => { b.disabled = true; });
      try {
        const res = await apiFetch('/auth/oidc/authorize') as any;
        window.location.href = res.url;
      } catch (e: any) {
        document.querySelectorAll<HTMLButtonElement>('.sso-btn').forEach(b => { b.disabled = false; });
        showError(e.message || 'Erreur OIDC');
      }
    }

    document.getElementById('login-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      if (!email || !password) { showError('Veuillez remplir tous les champs'); return; }

      const btn = document.getElementById('login-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Connexion…';
      const redirect = new URLSearchParams(window.location.search).get('redirect') || '/courses';

      try {
        const res = await apiFetch('/auth/login', { method: 'POST', body: { email, password } }) as any;
        localStorage.setItem('token', res.token);
        localStorage.setItem('user', JSON.stringify(res.user));
        window.location.href = res.user?.role === 'admin' ? '/admin' : redirect;
      } catch (e: any) {
        showError(e.message || 'Connexion échouée');
        btn.disabled = false; btn.textContent = 'Se connecter';
      }
    });

    document.getElementById('ldap-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      const username = (document.getElementById('ldap-user') as HTMLInputElement).value;
      const password = (document.getElementById('ldap-pass') as HTMLInputElement).value;
      if (!username || !password) { showError('Veuillez remplir tous les champs'); return; }

      const btn = document.getElementById('ldap-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Connexion…';
      const redirect = new URLSearchParams(window.location.search).get('redirect') || '/courses';

      try {
        const res = await apiFetch('/auth/ldap/login', { method: 'POST', body: { email: username, password } }) as any;
        localStorage.setItem('token', res.token);
        localStorage.setItem('user', JSON.stringify(res.user));
        window.location.href = res.user?.role === 'admin' ? '/admin' : redirect;
      } catch (e: any) {
        showError(e.message || 'Identifiants LDAP invalides');
        btn.disabled = false; btn.textContent = 'Se connecter';
      }
    });

    if (localStorage.getItem('token')) {
      const user = JSON.parse(localStorage.getItem('user') || '{}');
      window.location.href = user?.role === 'admin' ? '/admin' : '/courses';
    } else {
      init();
    }
  </script>
</Base>
