---
import Manager from '../../../layouts/Manager.astro';
---
<Manager title="Mes membres">
  <div class="flex items-baseline justify-between gap-4 mb-7 flex-wrap">
    <div>
      <h1 class="mu-title">Mes membres</h1>
      <p class="mu-subtitle" id="member-count">Chargement…</p>
      <div id="scope-groups" class="flex flex-wrap gap-1.5 mt-2 items-center">
        <span class="text-soft text-[.75rem]">Filtrer :</span>
      </div>
    </div>
  </div>

  <!-- Members table -->
  <div class="mu-table-wrap">
    <table class="mu-table" id="members-table">
      <thead>
        <tr>
          <th>Membre</th>
          <th>Cours inscrits</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="members-body">
        <tr><td colspan="3" class="mu-empty-td"><div class="loading-state !p-0"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div></td></tr>
      </tbody>
    </table>
  </div>

  <!-- Enrollment modal -->
  <div id="enroll-modal" class="mu-modal-overlay">
    <div class="card mu-modal-box">
      <div class="mu-modal-header">
        <h3 id="modal-title">Gérer les inscriptions</h3>
        <button id="modal-close" class="mu-modal-close">✕</button>
      </div>

      <!-- Current course enrollments -->
      <div class="mu-section">
        <h4 class="mu-section-title">Cours actuels</h4>
        <div id="current-enrollments">
          <div class="loading-state !py-3 !px-0"><div class="spinner w-5 h-5"></div></div>
        </div>
      </div>

      <!-- Current path enrollments -->
      <div class="mu-section-divider">
        <h4 class="mu-section-title">Parcours actuels</h4>
        <div id="current-path-enrollments">
          <div class="loading-state !py-3 !px-0"><div class="spinner w-5 h-5"></div></div>
        </div>
      </div>

      <!-- Enroll in a new course -->
      <div class="mu-section-divider mb-4">
        <h4 class="mu-section-title">Inscrire à un cours</h4>
        <div class="mu-select-row">
          <select id="course-select" class="input mu-select-input">
            <option value="">Choisir un cours…</option>
          </select>
          <button class="btn btn-primary" id="enroll-btn">Inscrire</button>
        </div>
      </div>

      <!-- Enroll in a new path -->
      <div class="mu-section-divider">
        <h4 class="mu-section-title">Inscrire à un parcours</h4>
        <div class="mu-select-row">
          <select id="path-select" class="input mu-select-input">
            <option value="">Choisir un parcours…</option>
          </select>
          <button class="btn btn-primary" id="enroll-path-btn">Inscrire</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const token = localStorage.getItem('token');
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers, body: opts.body ? JSON.stringify(opts.body) : undefined });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    let allMembers: any[] = [];
    let allCourses: any[] = [];
    let allPaths: any[] = [];
    let scopeGroupsData: any[] = [];
    let activeGroupFilter: string | null = null;
    let selectedUserId = '';
    let enrolledCourseSlugs = new Set<string>();
    let enrolledPathSlugs = new Set<string>();

    function populateCourseSelect() {
      const sel = document.getElementById('course-select') as HTMLSelectElement;
      if (!sel) return;
      sel.innerHTML = '<option value="">Choisir un cours…</option>' + allCourses
        .filter((c: any) => !enrolledCourseSlugs.has(c.slug))
        .map((c: any) => `<option value="${c.slug}">${c.title}${c.scope ? ` [${c.scope}]` : ''}</option>`)
        .join('');
    }

    function populatePathSelect() {
      const sel = document.getElementById('path-select') as HTMLSelectElement;
      if (!sel) return;
      sel.innerHTML = '<option value="">Choisir un parcours…</option>' + allPaths
        .filter((p: any) => !enrolledPathSlugs.has(p.slug))
        .map((p: any) => `<option value="${p.slug}">${p.title}</option>`)
        .join('');
    }

    async function load() {
      try {
        const [membersRes, coursesRes, pathsRes] = await Promise.all([
          api('/manager/users'),
          api('/courses'),
          api('/paths'),
        ]);
        allMembers = membersRes.users || [];
        allCourses = coursesRes.courses || [];
        allPaths = pathsRes.paths || [];
        scopeGroupsData = membersRes.groups || [];

        updateCountLabel();
        renderGroupBadges();
        renderMembers();

        populateCourseSelect();
        populatePathSelect();
      } catch (e: any) {
        document.getElementById('members-body')!.innerHTML =
          `<tr><td colspan="3" class="mu-error-td">Erreur : ${e.message}</td></tr>`;
      }
    }

    function updateCountLabel() {
      const filtered = activeGroupFilter
        ? allMembers.filter((u: any) => {
            const g = scopeGroupsData.find((g: any) => g.id === activeGroupFilter);
            return g && g.memberIds.includes(u.id);
          })
        : allMembers;
      document.getElementById('member-count')!.textContent =
        `${filtered.length} membre${filtered.length !== 1 ? 's' : ''}${activeGroupFilter ? ' dans ce groupe' : ' dans vos groupes'}`;
    }

    function renderGroupBadges() {
      const scopeEl = document.getElementById('scope-groups')!;
      if (!scopeGroupsData.length) {
        scopeEl.innerHTML = '<span class="text-soft text-sm italic">Aucun groupe assigné</span>';
        return;
      }
      scopeEl.innerHTML = '<span class="text-soft text-[.75rem] mr-0.5">Filtrer :</span>' +
        scopeGroupsData.map((g: any) => {
          const isActive = activeGroupFilter === g.id;
          return `<button class="badge badge-orange mu-group-filter-btn${isActive ? ' active' : ''}" data-gid="${g.id}">${g.name}</button>`;
        }).join('');
      scopeEl.querySelectorAll<HTMLButtonElement>('.group-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeGroupFilter = activeGroupFilter === btn.dataset.gid! ? null : btn.dataset.gid!;
          renderGroupBadges();
          updateCountLabel();
          renderMembers();
        });
      });
    }

    function renderMembers() {
      const tbody = document.getElementById('members-body')!;
      const visible = activeGroupFilter
        ? allMembers.filter((u: any) => {
            const g = scopeGroupsData.find((g: any) => g.id === activeGroupFilter);
            return g && g.memberIds.includes(u.id);
          })
        : allMembers;
      if (!visible.length) {
        tbody.innerHTML = `<tr><td colspan="3" class="mu-empty-td text-ink-soft">Aucun membre${activeGroupFilter ? ' dans ce groupe' : ' dans vos groupes'}</td></tr>`;
        return;
      }
      tbody.innerHTML = visible.map((u: any) => `
        <tr data-uid="${u.id}">
          <td class="mu-td-member">
            <div class="mu-member-info">
              <div class="mu-avatar">${(u.username || '?')[0].toUpperCase()}</div>
              <div>
                <div class="mu-member-name">${u.username}</div>
                <div class="mu-member-email">${u.email}</div>
              </div>
            </div>
          </td>
          <td class="mu-td-count">${u.enrolledCourses ?? 0} cours</td>
          <td class="mu-td-action">
            <button class="btn btn-secondary btn-sm manage-btn" data-uid="${u.id}" data-name="${u.username}">Gérer les inscriptions</button>
          </td>
        </tr>
      `).join('');

      tbody.querySelectorAll<HTMLButtonElement>('.manage-btn').forEach(btn => {
        btn.addEventListener('click', () => openModal(btn.dataset.uid!, btn.dataset.name!));
      });
    }

    async function openModal(userId: string, name: string) {
      selectedUserId = userId;
      document.getElementById('modal-title')!.textContent = `${name} — Inscriptions`;
      document.getElementById('enroll-modal')!.style.display = 'flex';
      await Promise.all([refreshEnrollments(), refreshPathEnrollments()]);
    }

    async function refreshEnrollments() {
      const el = document.getElementById('current-enrollments')!;
      el.innerHTML = '<div class="loading-state !py-3 !px-0"><div class="spinner w-5 h-5"></div></div>';
      try {
        const { enrollments } = await api(`/manager/users/${selectedUserId}/enrollments`);
        const list: any[] = enrollments || [];
        enrolledCourseSlugs = new Set(list.map((e: any) => e.courseSlug));
        populateCourseSelect();
        if (!list.length) {
          el.innerHTML = '<p class="text-soft text-sm">Aucun cours inscrit.</p>';
          return;
        }
        el.innerHTML = list.map((e: any) => `
          <div class="mu-enroll-item">
            <div class="mu-enroll-name">
              <span class="font-medium">${e.courseSlug}</span>
            </div>
            <button class="btn btn-sm unenroll-btn btn-remove" data-slug="${e.courseSlug}">Retirer</button>
          </div>
        `).join('');
        el.querySelectorAll<HTMLButtonElement>('.unenroll-btn').forEach(btn => {
          btn.addEventListener('click', () => unenroll(btn.dataset.slug!));
        });
      } catch (e: any) {
        el.innerHTML = `<p class="text-bad text-[.875rem]">${e.message}</p>`;
      }
    }

    async function unenroll(slug: string) {
      try {
        await api(`/manager/courses/${slug}/enrollments/${selectedUserId}`, { method: 'DELETE' });
        (window as any).showToast?.('Inscription retirée', 'success');
        await refreshEnrollments();
        await load();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      }
    }

    async function refreshPathEnrollments() {
      const el = document.getElementById('current-path-enrollments')!;
      el.innerHTML = '<div class="loading-state !py-3 !px-0"><div class="spinner w-5 h-5"></div></div>';
      try {
        const { pathEnrollments } = await api(`/manager/users/${selectedUserId}/path-enrollments`);
        const list: any[] = pathEnrollments || [];
        enrolledPathSlugs = new Set(list.map((e: any) => e.Slug));
        populatePathSelect();
        if (!list.length) {
          el.innerHTML = '<p class="text-soft text-sm">Aucun parcours inscrit.</p>';
          return;
        }
        el.innerHTML = list.map((e: any) => {
          const path = allPaths.find((p: any) => p.slug === e.Slug);
          return `
          <div class="mu-enroll-item">
            <div class="mu-enroll-name">
              <span class="font-medium">${path?.title || e.Slug}</span>
            </div>
            <button class="btn btn-sm unenroll-path-btn btn-remove" data-slug="${e.Slug}">Retirer</button>
          </div>`;
        }).join('');
        el.querySelectorAll<HTMLButtonElement>('.unenroll-path-btn').forEach(btn => {
          btn.addEventListener('click', () => unenrollPath(btn.dataset.slug!));
        });
      } catch (e: any) {
        el.innerHTML = `<p class="text-bad text-[.875rem]">${e.message}</p>`;
      }
    }

    async function unenrollPath(slug: string) {
      try {
        await api(`/manager/paths/${slug}/enrollments/${selectedUserId}`, { method: 'DELETE' });
        (window as any).showToast?.('Parcours retiré', 'success');
        await refreshPathEnrollments();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      }
    }

    document.getElementById('enroll-btn')!.addEventListener('click', async () => {
      const slug = (document.getElementById('course-select') as HTMLSelectElement).value;
      if (!slug) { (window as any).showToast?.('Choisissez un cours', 'error'); return; }
      const btn = document.getElementById('enroll-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '…';
      try {
        await api(`/manager/courses/${slug}/enrollments`, { method: 'POST', body: { userId: selectedUserId } });
        (document.getElementById('course-select') as HTMLSelectElement).value = '';
        (window as any).showToast?.('Inscrit avec succès', 'success');
        await refreshEnrollments();
        await load();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Inscrire';
      }
    });

    document.getElementById('enroll-path-btn')!.addEventListener('click', async () => {
      const slug = (document.getElementById('path-select') as HTMLSelectElement).value;
      if (!slug) { (window as any).showToast?.('Choisissez un parcours', 'error'); return; }
      const btn = document.getElementById('enroll-path-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '…';
      try {
        await api(`/manager/paths/${slug}/enrollments`, { method: 'POST', body: { userId: selectedUserId } });
        (document.getElementById('path-select') as HTMLSelectElement).value = '';
        (window as any).showToast?.('Inscrit au parcours', 'success');
        await refreshPathEnrollments();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Inscrire';
      }
    });

    document.getElementById('modal-close')!.addEventListener('click', () => {
      document.getElementById('enroll-modal')!.style.display = 'none';
    });
    document.getElementById('enroll-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('enroll-modal')) document.getElementById('enroll-modal')!.style.display = 'none';
    });

    load();
  </script>
</Manager>
