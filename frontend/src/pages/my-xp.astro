---
import App from '../layouts/App.astro';
---
<App title="Mon XP" activePage="xp">
  <style is:global>
    .xp-page { padding: 28px 36px 80px; max-width: 760px; margin: 0 auto; }

    .xp-hero {
      display: flex;
      align-items: center;
      gap: 28px;
      background: var(--paper);
      border: 1.5px solid var(--line);
      border-radius: 16px;
      padding: 28px 32px;
      margin-bottom: 28px;
    }

    .xp-orb {
      width: 88px; height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, #fef3c7, #fde68a);
      border: 3px solid #f59e0b44;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.4rem;
      flex-shrink: 0;
    }

    .xp-total { font-size: 2.6rem; font-weight: 800; color: var(--blue); line-height: 1; }
    .xp-total-label { font-size: .8rem; color: var(--ink-soft); margin-top: 2px; }

    .xp-level-chip {
      display: inline-flex; align-items: center; gap: 6px;
      background: #fef3c7; color: #92400e;
      border: 1.5px solid #f59e0b55;
      border-radius: 20px; padding: 4px 14px;
      font-size: .85rem; font-weight: 600; margin-top: 8px;
    }

    .xp-progress-bar {
      height: 8px; background: var(--fill);
      border-radius: 4px; overflow: hidden; margin-top: 16px;
    }
    .xp-progress-fill {
      height: 100%; border-radius: 4px;
      background: linear-gradient(90deg, #f59e0b, #fbbf24);
      transition: width .4s ease;
    }
    .xp-next-label { font-size: .75rem; color: var(--ink-soft); margin-top: 6px; }

    .xp-levels {
      display: grid; grid-template-columns: repeat(5, 1fr);
      gap: 10px; margin-bottom: 28px;
    }
    .xp-level-card {
      background: var(--paper); border: 1.5px solid var(--line);
      border-radius: 12px; padding: 14px 10px;
      text-align: center; transition: border-color .15s;
    }
    .xp-level-card.current {
      border-color: #f59e0b; background: #fffbeb;
    }
    .xp-level-icon { font-size: 1.6rem; margin-bottom: 4px; }
    .xp-level-name { font-size: .8rem; font-weight: 600; }
    .xp-level-thresh { font-size: .72rem; color: var(--ink-soft); margin-top: 2px; }

    .xp-history { }
    .xp-hist-title { font-size: 1rem; font-weight: 700; margin-bottom: 14px; }
    .xp-hist-item {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 0; border-bottom: 1px solid var(--line);
    }
    .xp-hist-item:last-child { border-bottom: none; }
    .xp-hist-icon {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--fill); display: flex; align-items: center;
      justify-content: center; font-size: 1.1rem; flex-shrink: 0;
    }
    .xp-hist-meta { flex: 1; min-width: 0; }
    .xp-hist-slug { font-size: .85rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .xp-hist-source { font-size: .75rem; color: var(--ink-soft); }
    .xp-hist-amount { font-size: .95rem; font-weight: 700; color: #f59e0b; white-space: nowrap; }
    .xp-empty { text-align: center; color: var(--ink-soft); padding: 48px 0; font-size: .95rem; }
  </style>

  <div class="xp-page">
    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

    <div id="xp-content" style="display:none">
      <!-- Hero XP total + level -->
      <div class="xp-hero">
        <div class="xp-orb">⚡</div>
        <div style="flex:1;min-width:0">
          <div class="xp-total" id="xp-total">0</div>
          <div class="xp-total-label">points d'expérience</div>
          <div class="xp-level-chip" id="xp-level-chip">Niveau 1 — Novice</div>
          <div class="xp-progress-bar">
            <div class="xp-progress-fill" id="xp-bar" style="width:0%"></div>
          </div>
          <div class="xp-next-label" id="xp-next-label"></div>
        </div>
      </div>

      <!-- Level tiers -->
      <div class="xp-levels" id="xp-levels"></div>

      <!-- History -->
      <div class="xp-history">
        <div class="xp-hist-title">Historique des gains</div>
        <div id="xp-hist-list"></div>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=/my-xp'; }

    const LEVELS = [
      { level: 1, name: 'Novice',    icon: '🌱', threshold: 0    },
      { level: 2, name: 'Apprenant', icon: '📘', threshold: 200  },
      { level: 3, name: 'Confirmé',  icon: '⚙️',  threshold: 600  },
      { level: 4, name: 'Expert',    icon: '🔥', threshold: 1500 },
      { level: 5, name: 'Maître',    icon: '🏆', threshold: 3500 },
    ];

    const SOURCE_ICONS: Record<string, string> = { lesson: '📖', module: '🎯', course: '🎓' };
    const SOURCE_LABELS: Record<string, string> = { lesson: 'Leçon', module: 'Module', course: 'Cours' };

    async function apiFetch(path: string) {
      const res = await fetch('/api' + path, { headers: { Authorization: `Bearer ${token}` } });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    async function init() {
      try {
        const data = await apiFetch('/my/xp') as any;

        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('xp-content')!.style.display = 'block';

        const total: number = data.total ?? 0;
        const level: number = data.level ?? 1;
        const levelName: string = data.levelName ?? 'Novice';

        // Hero
        document.getElementById('xp-total')!.textContent = total.toLocaleString('fr-FR');
        document.getElementById('xp-level-chip')!.textContent = `Niveau ${level} — ${levelName}`;

        // Progress bar toward next level
        const cur = LEVELS[level - 1];
        const next = LEVELS[level]; // undefined at max level
        if (next) {
          const progress = Math.min(100, Math.round(((total - cur.threshold) / (next.threshold - cur.threshold)) * 100));
          (document.getElementById('xp-bar') as HTMLElement).style.width = `${progress}%`;
          document.getElementById('xp-next-label')!.textContent =
            `${next.threshold - total} XP jusqu'au niveau ${next.level} (${next.name})`;
        } else {
          (document.getElementById('xp-bar') as HTMLElement).style.width = '100%';
          document.getElementById('xp-next-label')!.textContent = 'Niveau maximum atteint 🏆';
        }

        // Level cards
        const levelsEl = document.getElementById('xp-levels')!;
        levelsEl.innerHTML = LEVELS.map(l => `
          <div class="xp-level-card${l.level === level ? ' current' : ''}">
            <div class="xp-level-icon">${l.icon}</div>
            <div class="xp-level-name">${l.name}</div>
            <div class="xp-level-thresh">${l.threshold === 0 ? 'Départ' : `${l.threshold.toLocaleString('fr-FR')} XP`}</div>
          </div>
        `).join('');

        // History
        const histEl = document.getElementById('xp-hist-list')!;
        const history: any[] = data.history ?? [];
        if (history.length === 0) {
          histEl.innerHTML = '<div class="xp-empty">Aucun XP gagné pour l\'instant.<br>Complète des leçons, modules et cours pour en gagner !</div>';
        } else {
          histEl.innerHTML = history.map((e: any) => {
            const icon = SOURCE_ICONS[e.source] ?? '⚡';
            const label = SOURCE_LABELS[e.source] ?? e.source;
            const date = new Date(e.earnedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
            return `
              <div class="xp-hist-item">
                <div class="xp-hist-icon">${icon}</div>
                <div class="xp-hist-meta">
                  <div class="xp-hist-slug">${e.sourceSlug}</div>
                  <div class="xp-hist-source">${label} · ${date}</div>
                </div>
                <div class="xp-hist-amount">+${e.amount} XP</div>
              </div>
            `;
          }).join('');
        }
      } catch {
        (window as any).showToast?.('Erreur lors du chargement', 'error');
      }
    }

    init();
  </script>
</App>
