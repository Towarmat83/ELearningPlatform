---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Monitoring">
  <div class="admin-page-header">
    <div>
      <h1 class="text-2xl">Monitoring</h1>
      <p class="text-soft text-sm mt-1">Statistiques et activité de la plateforme</p>
    </div>
    <div class="flex gap-2">
      <a href="/admin/leaderboard" class="btn btn-secondary btn-sm">🏆 Classement complet</a>
      <button class="btn btn-secondary btn-sm" id="sync-btn">⟳ Recalculer la progression</button>
    </div>
  </div>

  <!-- Stats grid -->
  <div id="stats-grid" class="stats-grid mb-7">
    {[0,1,2,3,4,5].map(() => (
      <div class="card-sm text-center p-5">
        <div class="spinner mx-auto mb-2"></div>
        <div class="text-soft text-xs">Chargement…</div>
      </div>
    ))}
  </div>

  <!-- Courses overview -->
  <div class="card !p-0 overflow-x-auto mb-7">
    <div class="px-5 py-[18px] border-b border-line">
      <h2 class="text-[1.1rem]">Aperçu des cours</h2>
    </div>
    <div id="courses-overview">
      <div class="loading-state"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div>
    </div>
  </div>

  <!-- Top leaderboard (preview) -->
  <div class="card !p-0 overflow-hidden">
    <div class="flex items-center justify-between px-5 py-[18px] border-b border-line">
      <h2 class="text-[1.1rem]">Top 10 — Classement</h2>
      <a href="/admin/leaderboard" class="text-blue text-sm">Voir tout →</a>
    </div>
    <div id="leaderboard-body">
      <div class="loading-state"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string, opts: { method?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    const STAT_DEFS: { key: string; label: string; cls: string; fmt?: (v: any) => string }[] = [
      { key: 'total_users',       label: 'Utilisateurs',    cls: 'text-blue'   },
      { key: 'totalCourses',     label: 'Cours',           cls: 'text-blue'   },
      { key: 'total_enrollments', label: 'Inscriptions',    cls: 'text-orange' },
      { key: 'total_submissions', label: 'Soumissions',     cls: 'text-ink'    },
      { key: 'total_labs',        label: 'Labs',            cls: 'text-blue'   },
      { key: 'success_rate',      label: 'Taux de réussite',cls: 'text-good',  fmt: (v) => v != null ? `${v}%` : '—' },
    ];

    async function loadStats() {
      const grid = document.getElementById('stats-grid')!;
      try {
        const s = await api('/admin/stats');
        grid.innerHTML = STAT_DEFS.map(({ key, label, cls, fmt }) => {
          const raw = s[key];
          const val = raw != null ? (fmt ? fmt(raw) : raw) : '—';
          return `
            <div class="card-sm stat-card">
              <div class="stat-card-value ${cls}">${val}</div>
              <div class="stat-card-label">${label}</div>
            </div>
          `;
        }).join('');
      } catch {
        grid.innerHTML = '<div class="text-soft text-sm p-4 col-span-full">Statistiques indisponibles</div>';
      }
    }

    async function loadCoursesOverview() {
      const el = document.getElementById('courses-overview')!;
      try {
        const res = await api('/admin/courses');
        const courses: any[] = res.courses || [];
        if (!courses.length) {
          el.innerHTML = '<p class="text-soft text-sm p-5">Aucun cours.</p>';
          return;
        }
        el.innerHTML = `
          <table class="admin-table">
            <thead>
              <tr class="admin-tr-head">
                <th class="admin-th-sm">Titre</th>
                <th class="admin-th-sm">Catégorie</th>
                <th class="admin-th-center">Labs</th>
                <th class="admin-th-center">Inscrits</th>
                <th class="admin-th-center">Accès</th>
              </tr>
            </thead>
            <tbody>
              ${courses.map((c: any, i: number) => `
                <tr ${i < courses.length - 1 ? 'class="admin-tr"' : ''}>
                  <td class="admin-td">
                    <div class="username-text">${c.title}</div>
                    <div class="mono-id">${c.id}</div>
                  </td>
                  <td class="admin-td text-soft">${c.category || '—'}</td>
                  <td class="admin-td-center">${c.labCount ?? '—'}</td>
                  <td class="admin-td-center">${c.enrollmentCount ?? 0}</td>
                  <td class="admin-td-center"><span class="badge ${c.isPublic ? 'badge-green' : 'badge-gray'} badge-xs">${c.isPublic ? 'Public' : 'Privé'}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      } catch (e: any) {
        el.innerHTML = `<p class="text-bad p-5">${e.message}</p>`;
      }
    }

    async function loadLeaderboard() {
      const body = document.getElementById('leaderboard-body')!;
      try {
        const { leaderboard } = await api('/admin/leaderboard');
        const entries: any[] = (leaderboard || []).slice(0, 10);
        if (!entries.length) {
          body.innerHTML = '<p class="text-soft text-sm p-6">Aucune donnée.</p>';
          return;
        }
        body.innerHTML = entries.map((e: any, i: number) => `
          <div class="lb-row-padded">
            <span class="lb-rank-lg ${i < 3 ? 'top' : ''}">${i < 3 ? ['🥇','🥈','🥉'][i] : i + 1}</span>
            <div class="lb-avatar-lg ${e.role === 'admin' ? 'lb-avatar-admin' : 'lb-avatar-user'}">${(e.username || '?')[0].toUpperCase()}</div>
            <div class="lb-info">
              <div class="lb-name">${e.username}</div>
              <div class="lb-stats">${e.enrolledCourses ?? 0} cours · ${e.passedModules ?? 0} modules validés</div>
            </div>
            <div class="lb-score-col">
              <div class="lb-score-main">${e.totalScore ?? 0} pts</div>
              ${e.success_rate != null ? `<div class="lb-score-rate">${e.success_rate}% réussite</div>` : ''}
            </div>
          </div>
        `).join('');
      } catch (err: any) {
        body.innerHTML = `<p class="text-bad p-6">${err.message}</p>`;
      }
    }

    document.getElementById('sync-btn')!.addEventListener('click', async () => {
      const btn = document.getElementById('sync-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Recalcul…';
      try {
        await api('/admin/sync-progress', { method: 'POST' });
        (window as any).showToast?.('Progression recalculée', 'success');
        loadLeaderboard();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = '⟳ Recalculer la progression';
      }
    });

    loadStats();
    loadCoursesOverview();
    loadLeaderboard();
  </script>
</Admin>
