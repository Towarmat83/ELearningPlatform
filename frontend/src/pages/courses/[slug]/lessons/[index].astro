---
import App from '../../../../layouts/App.astro';
---
<App title="Leçon">
  <style is:global>
    /* ── Mode A: 3-column docs layout ─────────────────────────────── */
    .lesson-layout {
      display: grid;
      grid-template-columns: 230px 1fr 210px;
      min-height: calc(100vh - 56px);
      gap: 0;
    }
    .lesson-left {
      border-right: 1px solid var(--line);
      background: var(--paper);
      position: sticky;
      top: 56px;
      height: calc(100vh - 56px);
      overflow-y: auto;
      padding: 20px 0;
    }
    .lesson-center {
      padding: 34px 48px;
      max-width: 680px;
      width: 100%;
    }
    .lesson-right {
      border-left: 1px solid var(--line);
      position: sticky;
      top: 56px;
      height: calc(100vh - 56px);
      overflow-y: auto;
      padding: 24px 18px;
    }

    /* ── Mode B: Focus reading ─────────────────────────────────────── */
    body.focus-mode .lesson-layout {
      grid-template-columns: 1fr;
    }
    body.focus-mode .lesson-left { display: none; }
    body.focus-mode .lesson-center {
      width: 620px;
      max-width: 620px;
      margin: 0 auto;
      padding: 40px 0;
    }
    body.focus-mode .lesson-right { display: none; }
    body.focus-mode .lesson-mobile-open { display: none !important; }

    /* ── Floating mode toggle (always visible, décorrélé de la sidebar) ── */
    .floating-mode-btn {
      position: fixed;
      left: 24px;
      bottom: 24px;
      z-index: 60;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      height: 34px;
      padding: 0 14px;
      border-radius: 999px;
      font-size: .78rem;
      font-weight: 600;
      color: var(--ink-soft);
      background: var(--paper);
      border: 1.5px solid var(--line);
      box-shadow: 0 4px 16px rgba(30,60,120,.10);
      cursor: pointer;
      transition: border-color .14s, color .14s, box-shadow .14s, transform .12s;
      white-space: nowrap;
      user-select: none;
    }
    .floating-mode-btn:hover {
      border-color: var(--blue);
      color: var(--blue-deep);
      box-shadow: 0 6px 20px rgba(30,60,120,.18);
      transform: translateY(-1px);
    }
    body.focus-mode .floating-mode-btn {
      background: var(--blue-soft);
      border-color: var(--blue);
      color: var(--blue-deep);
    }
    /* on mobile, hide the floating mode btn to avoid clutter */
    @media (max-width: 640px) { .floating-mode-btn { display: none; } }

    /* Floating progress indicator (mode B) */
    .floating-progress {
      display: none;
      position: fixed;
      right: 24px;
      bottom: 24px;
      background: var(--paper);
      border: 1.5px solid var(--line);
      border-radius: 999px;
      padding: 8px 14px;
      box-shadow: 0 8px 24px rgba(30,60,120,.18);
      align-items: center;
      gap: 10px;
      font-size: .8rem;
      color: var(--ink-soft);
      z-index: 50;
    }
    body.focus-mode .floating-progress { display: flex; }

    .floating-prog-bar { width: 80px; height: 6px; background: var(--fill); border-radius: 3px; overflow: hidden; }
    .floating-prog-fill { height: 100%; background: var(--blue); border-radius: 3px; }

    /* Mini-quiz styling */
    .mini-quiz-block {
      background: var(--blue-soft);
      border: 1.5px solid var(--blue);
      border-radius: 14px;
      padding: 24px;
      margin-top: 32px;
    }
    .mini-quiz-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .mini-quiz-header img { width: 36px; height: 36px; object-fit: contain; }
    .mini-quiz-title { font-weight: 700; color: var(--blue-deep); font-size: .9rem; }
    .mini-quiz-subtitle { font-size: .8rem; color: var(--ink-soft); }

    /* ── Responsive ── */
    /* Tablet: hide TOC */
    @media (max-width: 900px) {
      .lesson-layout { grid-template-columns: 230px 1fr; }
      .lesson-right { display: none; }
      .lesson-center { max-width: 100%; }
    }
    /* Mobile: nav becomes a slide-out drawer */
    @media (max-width: 640px) {
      .lesson-layout { grid-template-columns: 1fr; }
      .lesson-left {
        position: fixed;
        left: -264px;
        top: 56px;
        width: 264px;
        height: calc(100vh - 56px);
        z-index: 200;
        background: var(--paper);
        border-right: 1px solid var(--line);
        box-shadow: none;
        transition: left .22s ease, box-shadow .22s;
        padding: 16px 0;
      }
      .lesson-left.nav-open {
        left: 0;
        box-shadow: 8px 0 32px rgba(0,0,0,.2);
      }
      .lesson-center { padding: 20px 16px; max-width: 100%; }
      body.focus-mode .lesson-center { width: 100%; max-width: 100%; padding: 20px 16px; }
      .lesson-mobile-open { display: flex !important; }
    }
    /* Mobile nav overlay */
    .nav-overlay {
      display: none;
      position: fixed;
      inset: 0;
      top: 56px;
      background: rgba(0,0,0,.38);
      z-index: 190;
    }
    .nav-overlay.active { display: block; }
    /* Mobile open button (hidden on desktop) */
    .lesson-mobile-open {
      display: none;
      align-items: center;
      gap: 6px;
      height: 32px;
      padding: 0 12px;
      border-radius: 8px;
      background: var(--fill);
      border: 1.5px solid var(--line);
      font-size: .82rem;
      font-weight: 600;
      color: var(--ink-soft);
      cursor: pointer;
      margin-bottom: 16px;
      white-space: nowrap;
    }
    .lesson-mobile-open:hover { border-color: var(--blue); color: var(--blue-deep); }

    /* Mini-quiz: option buttons, order drag, cooldown */
    .quiz-options { display: flex; flex-direction: column; gap: 8px; }
    .quiz-option {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 14px; border: 1.5px solid var(--line); border-radius: 9px;
      cursor: pointer; font-size: .875rem; background: var(--paper);
      transition: .12s; text-align: left; width: 100%;
    }
    .quiz-option:hover { border-color: var(--blue); background: var(--blue-soft); }
    .quiz-option.selected { border-color: var(--blue); background: var(--blue-soft); }
    .quiz-option.selected .radio-circle { border-color: var(--blue); }
    .quiz-option.selected .radio-circle::after { background: var(--blue); }
    .quiz-option:disabled { opacity: .5; cursor: not-allowed; }
    .radio-circle {
      width: 18px; height: 18px; border-radius: 50%;
      border: 2px solid var(--line); flex: 0 0 auto; position: relative;
    }
    .radio-circle::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: transparent; }
    .cooldown-banner {
      padding: 8px 12px; background: var(--orange-soft);
      border: 1px solid var(--orange); border-radius: var(--radius);
      font-size: .82rem; color: #b86800; margin-bottom: 8px;
    }
    .order-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; border: 1.5px solid var(--line); border-radius: 9px;
      background: var(--paper); cursor: grab; user-select: none;
      transition: opacity .15s, border-color .12s, background .12s, box-shadow .12s;
      touch-action: none;
    }
    .order-item:active { cursor: grabbing; }
    .order-item.dragging { opacity: .35; }
    .order-item.drag-over { border-color: var(--blue) !important; background: var(--blue-soft) !important; box-shadow: 0 2px 12px rgba(27,134,242,.18); }
    .drag-handle { color: var(--ink-soft); font-size: 1.1rem; line-height: 1; flex-shrink: 0; cursor: grab; }
    .order-move-btn {
      padding: 2px 5px; color: var(--ink-soft); background: none; border: none;
      cursor: pointer; font-size: .85rem; border-radius: 4px; line-height: 1;
      transition: background .1s, color .1s;
    }
    .order-move-btn:hover:not(:disabled) { background: var(--fill); color: var(--ink); }
    .order-move-btn:disabled { opacity: .25; cursor: default; }
  </style>

  <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>
  <div id="lesson-layout" class="lesson-layout" style="display:none">

    <!-- Left: module tree -->
    <aside class="lesson-left">
      <div style="padding:0 16px;margin-bottom:10px">
        <a id="back-to-course" href="#" style="font-size:.75rem;color:var(--ink-soft);display:flex;align-items:center;gap:4px;text-decoration:none">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Retour
        </a>
      </div>

      <div class="left-inner">
        <div style="padding:0 16px;margin-bottom:12px">
          <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px">Modules</div>
          <div class="progress-bar" style="margin-bottom:4px"><div id="sidebar-progress" class="progress-bar-fill" style="width:0%"></div></div>
          <div id="sidebar-progress-text" style="font-size:.72rem;color:var(--ink-soft)"></div>
        </div>
        <nav id="module-tree" class="sidebar-nav" style="padding:0 8px"></nav>
      </div>
    </aside>

    <!-- Center: content -->
    <main class="lesson-center">
      <button class="lesson-mobile-open" id="mobile-nav-open">☰ Modules</button>
      <div id="breadcrumb" style="display:flex;align-items:center;gap:6px;font-size:.8rem;color:var(--ink-soft);margin-bottom:20px;flex-wrap:wrap"></div>
      <h1 id="lesson-title" style="margin-bottom:20px;font-size:1.5rem"></h1>
      <div id="content-body" class="prose"></div>
      <div id="mini-quiz" style="display:none;margin-top:8px"></div>
      <div id="lesson-nav" style="display:flex;align-items:center;justify-content:space-between;margin-top:40px;padding-top:24px;border-top:1px solid var(--line)"></div>
    </main>

    <!-- Right: TOC + resources -->
    <aside class="lesson-right">
      <div class="toc">
        <div class="toc-title">Sur cette page</div>
        <nav id="toc-nav"></nav>
      </div>
      <div class="divider" style="margin:16px 0"></div>
      <div id="git-resources" style="display:none">
        <div class="toc-title">Ressources</div>
        <div id="git-links" class="stack" style="gap:6px;margin-top:8px"></div>
      </div>
    </aside>
  </div>

  <!-- Mobile nav overlay -->
  <div class="nav-overlay" id="nav-overlay"></div>

  <!-- Floating progress (focus mode only) -->
  <div class="floating-progress" id="floating-progress">
    <div class="floating-prog-bar"><div class="floating-prog-fill" id="floating-prog-fill" style="width:0%"></div></div>
    <span id="floating-prog-text" style="font-size:.75rem;color:var(--ink-soft)"></span>
  </div>

  <!-- Floating mode toggle (always visible, décorrélé de la sidebar) -->
  <button class="floating-mode-btn" id="floating-mode-btn">
    <span id="fmb-icon" style="display:flex;align-items:center;flex-shrink:0"></span>
    <span id="fmb-label"></span>
  </button>

  <script>
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const slug = pathParts[1];
    const moduleIndex = parseInt(pathParts[3], 10);

    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname); }

    // Mode toggle
    const PREF_KEY = 'pupitre.readingMode';
    let focusMode = localStorage.getItem(PREF_KEY) === 'focus';

    const ICON_FOCUS = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>`;
    const ICON_DOCS  = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="6" height="18" rx="1"/><rect x="11" y="3" width="10" height="18" rx="1"/></svg>`;

    const floatingModeBtn = document.getElementById('floating-mode-btn')!;
    const fmbIcon  = document.getElementById('fmb-icon')!;
    const fmbLabel = document.getElementById('fmb-label')!;

    function applyMode() {
      document.body.classList.toggle('focus-mode', focusMode);
      if (focusMode) {
        fmbIcon.innerHTML  = ICON_DOCS;
        fmbLabel.textContent = 'Mode docs';
        floatingModeBtn.title = 'Revenir au mode 3 colonnes';
      } else {
        fmbIcon.innerHTML  = ICON_FOCUS;
        fmbLabel.textContent = 'Lecture focus';
        floatingModeBtn.title = 'Passer en mode lecture concentrée';
      }
    }
    applyMode();

    floatingModeBtn.addEventListener('click', () => {
      focusMode = !focusMode;
      localStorage.setItem(PREF_KEY, focusMode ? 'focus' : 'docs');
      applyMode();
    });

    // Mobile drawer
    const mobileNavOpen = document.getElementById('mobile-nav-open');
    const navOverlay = document.getElementById('nav-overlay');
    const lessonLeft = document.querySelector('.lesson-left') as HTMLElement | null;
    function openDrawer() { lessonLeft?.classList.add('nav-open'); navOverlay?.classList.add('active'); }
    function closeDrawer() { lessonLeft?.classList.remove('nav-open'); navOverlay?.classList.remove('active'); }
    mobileNavOpen?.addEventListener('click', openDrawer);
    navOverlay?.addEventListener('click', closeDrawer);
    // Close drawer when a module link is clicked
    document.querySelector('.lesson-left')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) closeDrawer();
    });

    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) { const err = await res.json().catch(() => ({})); const e = new Error((err as any).error || `HTTP ${res.status}`) as any; e.status = res.status; e.body = err; throw e; }
      return res.json();
    }

    // ── Pattern rendering ──────────────────────────────────────────────────────
    let _patternCache: Record<string, { html: string; css: string }> | null = null;

    async function loadPatterns(): Promise<Record<string, { html: string; css: string }>> {
      if (_patternCache) return _patternCache;
      try {
        const res = await fetch('/api/patterns');
        if (!res.ok) return (_patternCache = {});
        const data = await res.json() as any;
        const map: Record<string, { html: string; css: string }> = {};
        for (const p of (data.patterns || [])) {
          map[p.name] = { html: p.html || '', css: p.css || '' };
        }
        _patternCache = map;
      } catch { _patternCache = {}; }
      return _patternCache!;
    }

    function injectPatternCSS(patterns: Record<string, { html: string; css: string }>) {
      let styleEl = document.getElementById('pattern-styles') as HTMLStyleElement | null;
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'pattern-styles';
        document.head.appendChild(styleEl);
      }
      styleEl.textContent = Object.values(patterns).map(p => p.css).filter(Boolean).join('\n');
    }

    async function applyPatterns(md: string, patterns: Record<string, { html: string; css: string }>, markedInst: any): Promise<string> {
      if (!Object.keys(patterns).length) return md;
      const norm = md.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      let out = norm;

      // Block patterns: |||name\ncontent\n|||
      for (const [name, pat] of Object.entries(patterns)) {
        if (!pat.html) continue;
        const esc = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`\\|\\|\\|${esc}\\n([\\s\\S]*?)\\n\\|\\|\\|`, 'g');
        const hits: Array<{ full: string; content: string }> = [];
        let m: RegExpExecArray | null;
        while ((m = re.exec(norm)) !== null) hits.push({ full: m[0], content: m[1] });
        for (const hit of hits) {
          const inner = await markedInst.parseInline(hit.content.trim());
          out = out.replace(hit.full, pat.html.replace(/\{\{content\}\}/g, inner));
        }
      }

      // Inline patterns: |||name text|||
      for (const [name, pat] of Object.entries(patterns)) {
        if (!pat.html) continue;
        const esc = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        out = out.replace(
          new RegExp(`\\|\\|\\|${esc} ([^|\\n]+?)\\|\\|\\|`, 'g'),
          (_, content: string) => pat.html.replace(/\{\{content\}\}/g, content.trim())
        );
      }

      return out;
    }

    async function renderMarkdown(md: string): Promise<string> {
      const { marked } = await import('marked');
      const patterns = await loadPatterns();
      injectPatternCSS(patterns);
      const processed = await applyPatterns(md, patterns, marked);
      return marked.parse(processed) as string;
    }

    // ── Cookie-based cooldown persistence ──────────────────────────────────────
    function saveCooldownsToCookie(moduleIdx: number, cds: Record<string, { remaining: number; locked: boolean }>) {
      const data: Record<string, number> = {};
      const now = Date.now();
      for (const [qid, cd] of Object.entries(cds)) {
        if (cd.locked) data[qid] = -1;
        else if (cd.remaining > 0) data[qid] = now + cd.remaining * 1000;
      }
      const name = `pcd_${slug}_${moduleIdx}`;
      if (Object.keys(data).length === 0) {
        document.cookie = `${name}=; max-age=0; path=/; SameSite=Strict`;
      } else {
        document.cookie = `${name}=${encodeURIComponent(JSON.stringify(data))}; max-age=86400; path=/; SameSite=Strict`;
      }
    }

    function loadCooldownsFromCookie(moduleIdx: number): Record<string, any> | null {
      const name = `pcd_${slug}_${moduleIdx}`;
      const match = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith(name + '='));
      if (!match) return null;
      try {
        const data: Record<string, number> = JSON.parse(decodeURIComponent(match.slice(name.length + 1)));
        const now = Date.now();
        const out: Record<string, any> = {};
        let hasActive = false;
        for (const [qid, exp] of Object.entries(data)) {
          if (exp === -1) {
            out[qid] = { remaining_seconds: 0, locked: true }; hasActive = true;
          } else {
            const r = Math.max(0, Math.round((exp - now) / 1000));
            if (r > 0) { out[qid] = { remaining_seconds: r, locked: false }; hasActive = true; }
          }
        }
        return hasActive ? out : null;
      } catch { return null; }
    }
    // ───────────────────────────────────────────────────────────────────────────

    function moduleIcon(m: any) {
      if (m.locked) return '🔒';
      if (m.type === 'quiz') return '🧩';
      if (m.type === 'video') return '🎬';
      if (m.type === 'image') return '🖼️';
      if (m.type === 'lab') return '🧪';
      return '📝';
    }

    async function init() {
      if (!token) return;
      if (isNaN(moduleIndex)) { window.location.href = `/courses/${slug}`; return; }

      let allModules: any[] = [];
      let mod: any = null;

      try {
        const [modRes, moduleDetail] = await Promise.all([
          apiFetch(`/courses/${slug}/modules`, { token: token! }),
          apiFetch(`/courses/${slug}/modules/${moduleIndex}`, { token: token! }),
        ]);
        allModules = (modRes as any).modules || [];
        mod = moduleDetail;
      } catch (e: any) {
        if (e.status === 403) { window.location.href = `/courses/${slug}`; return; }
        document.getElementById('loading')!.innerHTML = '<div style="text-align:center;padding:64px"><h2>Module introuvable</h2><a href="/courses" class="btn btn-primary" style="margin-top:16px;display:inline-flex">Catalogue</a></div>';
        return;
      }

      if (mod.type === 'quiz') {
        window.location.replace(`/courses/${slug}/quiz/${moduleIndex}`);
        return;
      }

      document.title = `${mod.name} — pupitre`;
      (document.getElementById('back-to-course') as HTMLAnchorElement).href = `/courses/${slug}`;

      // Inline quizzes are embedded — exclude from sidebar and progress counts
      const navModules = allModules.filter((m: any) => !m.inline);

      // Progress
      const completed = navModules.filter((m: any) => m.type === 'quiz' ? m.passed : m.viewed).length;
      const pct = navModules.length > 0 ? Math.round(completed / navModules.length * 100) : 0;
      (document.getElementById('sidebar-progress') as HTMLElement).style.width = pct + '%';
      document.getElementById('sidebar-progress-text')!.textContent = `${completed}/${navModules.length} complétés`;
      (document.getElementById('floating-prog-fill') as HTMLElement).style.width = pct + '%';
      document.getElementById('floating-prog-text')!.textContent = `${completed}/${navModules.length}`;

      // Module tree
      const tree = document.getElementById('module-tree')!;
      tree.innerHTML = navModules.map((m: any) => {
        const href = m.type === 'quiz' ? `/courses/${slug}/quiz/${m.index}` : `/courses/${slug}/lessons/${m.index}`;
        const isCurrent = m.index === moduleIndex;
        return `
          <a href="${m.locked ? '#' : href}" class="sidebar-link${isCurrent ? ' active' : ''}" style="${m.locked ? 'opacity:.55;pointer-events:none' : ''}">
            <span style="flex-shrink:0">${moduleIcon(m)}</span>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.82rem">${m.name}</span>
            ${m.viewed || m.passed ? '<span style="margin-left:auto;color:var(--good);flex-shrink:0;font-size:.8rem">✓</span>' : ''}
          </a>
        `;
      }).join('');

      // Breadcrumb
      document.getElementById('breadcrumb')!.innerHTML = `
        <a href="/courses" style="color:var(--blue);text-decoration:none">Catalogue</a>
        <span>›</span>
        <a href="/courses/${slug}" style="color:var(--blue);text-decoration:none">${slug}</a>
        <span>›</span>
        <span>${mod.name}</span>
      `;

      document.getElementById('lesson-title')!.textContent = mod.name;

      // Render content
      const contentBody = document.getElementById('content-body')!;
      if (mod.type === 'lab' && mod.content) {
        contentBody.innerHTML = `
          <div style="text-align:center;padding:48px 24px;background:var(--blue-soft);border-radius:10px;margin:24px 0">
            <div style="font-size:3rem;margin-bottom:12px">🧪</div>
            <p style="color:var(--ink-soft);margin-bottom:20px">Ce module est un lab pratique hébergé sur un environnement externe.</p>
            <a href="${mod.content}" target="_blank" rel="noopener" class="btn btn-primary" style="display:inline-flex">Ouvrir le lab ↗</a>
          </div>
        `;
      } else if (mod.type === 'video' && mod.content) {
        contentBody.innerHTML = `<div style="display:flex;justify-content:center;margin:24px 0"><video controls style="max-width:100%;border-radius:10px"><source src="${mod.content}" type="video/mp4" /></video></div>`;
      } else if (mod.type === 'image' && mod.content) {
        contentBody.innerHTML = `<div style="display:flex;justify-content:center;margin:24px 0"><img src="${mod.content}" alt="${mod.name}" style="max-width:100%;border-radius:10px" /></div>`;
      } else if (mod.content) {
        try {
          contentBody.innerHTML = await renderMarkdown(mod.content);
        } catch {
          contentBody.textContent = mod.content;
        }
      } else {
        contentBody.innerHTML = '<p style="color:var(--ink-soft)">Aucun contenu disponible.</p>';
      }

      // TOC
      const tocNav = document.getElementById('toc-nav')!;
      const headings = [...contentBody.querySelectorAll('h2, h3')];
      headings.forEach((h, i) => { h.id = `heading-${i}`; });
      if (headings.length > 0) {
        tocNav.innerHTML = headings.map((h, i) => `<a href="#heading-${i}" class="${h.tagName === 'H3' ? 'toc-h3' : ''}">${h.textContent}</a>`).join('');
      }

      // If this module is an inline quiz, redirect to the previous module where it's embedded
      if (mod.inline && moduleIndex > 0) {
        const prevIdx = allModules.filter((m: any) => m.index < moduleIndex && !m.inline).at(-1)?.index ?? moduleIndex - 1;
        window.location.replace(`/courses/${slug}/lessons/${prevIdx}`);
        return;
      }

      // Skip inline modules in nav (they are embedded, not standalone pages)
      function modHref(m: any): string {
        return m.type === 'quiz' ? `/courses/${slug}/quiz/${m.index}` : `/courses/${slug}/lessons/${m.index}`;
      }
      const currentIdx = allModules.findIndex((m: any) => m.index === moduleIndex);
      const prevMod = allModules.slice(0, currentIdx).filter((m: any) => !m.inline).at(-1) ?? null;
      const nextMod = allModules.slice(currentIdx + 1).filter((m: any) => !m.inline)[0] ?? null;

      const prevBtn = prevMod
        ? `<a href="${modHref(prevMod)}" class="btn btn-secondary">◂ Précédent</a>`
        : `<a href="/courses/${slug}" class="btn btn-secondary">◂ Cours</a>`;

      const navDiv = document.getElementById('lesson-nav')!;

      let rightBtn = '';
      if (!mod.viewed) {
        rightBtn = `<button class="btn btn-primary" id="mark-complete-btn">Terminer le module ▸</button>`;
      } else if (nextMod) {
        rightBtn = `<a href="${modHref(nextMod)}" class="btn btn-primary">Module suivant ▸</a>`;
      } else {
        rightBtn = `<a href="/courses/${slug}" class="btn btn-primary">Terminer le cours ▸</a>`;
      }

      navDiv.innerHTML = `${prevBtn}${rightBtn}`;

      document.getElementById('mark-complete-btn')?.addEventListener('click', async () => {
        try {
          await apiFetch(`/courses/${slug}/lessons/${mod.slug}/complete`, { method: 'POST', body: {}, token: token! });
          const btn = document.getElementById('mark-complete-btn')!;
          btn.textContent = '✓ Terminé';
          btn.classList.remove('btn-primary');
          btn.classList.add('btn-secondary');
          (btn as HTMLButtonElement).disabled = true;

          const link = tree.querySelector<HTMLElement>(`a[href="/courses/${slug}/lessons/${moduleIndex}"]`);
          if (link && !link.querySelector('.done-check')) {
            const check = document.createElement('span');
            check.style.cssText = 'margin-left:auto;color:var(--good);flex-shrink:0;font-size:.8rem';
            check.textContent = '✓';
            link.appendChild(check);
          }

          navDiv.innerHTML = nextMod
            ? `${prevBtn}<a href="${modHref(nextMod)}" class="btn btn-primary">Module suivant ▸</a>`
            : `${prevBtn}<a href="/courses/${slug}" class="btn btn-primary">Terminer le cours ▸</a>`;
        } catch {
          (window as any).showToast?.('Erreur lors de la mise à jour', 'error');
        }
      });

      // Mini-quiz: use inline_quiz data already embedded in the module response
      if (mod.inline_quiz?.questions?.length > 0) {
        renderMiniQuiz(mod.inline_quiz, mod.inline_quiz.index);
      }

      document.getElementById('loading')!.style.display = 'none';
      document.getElementById('lesson-layout')!.style.display = 'grid';
    }

    function renderMiniQuiz(quizMod: any, quizIndex: number) {
      const container = document.getElementById('mini-quiz')!;
      container.style.display = 'block';
      const questions = quizMod.questions;

      let answers: Record<string, any> = {};
      let submitted = false;
      let result: any = null;
      let cooldowns: Record<string, { remaining: number; locked: boolean }> = {};
      let cooldownTimer: ReturnType<typeof setInterval> | null = null;

      function initAnswers() {
        answers = {};
        for (const q of questions) {
          if (q.type === 'multiple') answers[q.id] = [];
          else if (q.type === 'order') answers[q.id] = (q.items || []).map((i: any) => i.id);
          else if (q.type === 'boolean') answers[q.id] = null;
          else answers[q.id] = '';
        }
      }
      initAnswers();

      function startCooldowns(cds: Record<string, any>) {
        cooldowns = {};
        for (const [k, cd] of Object.entries(cds)) {
          cooldowns[k] = { remaining: (cd as any).remaining_seconds, locked: (cd as any).locked };
        }
        saveCooldownsToCookie(quizIndex, cooldowns);
        if (cooldownTimer) clearInterval(cooldownTimer);
        cooldownTimer = setInterval(() => {
          let anyActive = false;
          for (const k of Object.keys(cooldowns)) {
            if (cooldowns[k].remaining > 0) { cooldowns[k].remaining--; anyActive = true; }
          }
          if (!anyActive && cooldownTimer) { clearInterval(cooldownTimer); cooldownTimer = null; }
          updateCooldownBanners();
        }, 1000);
      }

      function updateCooldownBanners() {
        for (const [qid, cd] of Object.entries(cooldowns)) {
          const banner = document.getElementById(`mini-cd-${qid}`);
          if (banner) {
            if (cd.locked) banner.textContent = '🔒 Question verrouillée';
            else if (cd.remaining > 0) banner.textContent = `⏳ Réessayez dans ${cd.remaining}s`;
            else banner.style.display = 'none';
          }
        }
      }

      function isAnswered(q: any): boolean {
        const v = answers[q.id];
        if (q.type === 'single') return !!v;
        if (q.type === 'multiple') return Array.isArray(v) && v.length > 0;
        if (q.type === 'boolean') return v !== null && v !== undefined;
        if (q.type === 'order') return Array.isArray(v) && v.length > 0;
        return false;
      }

      function canRetry(): boolean {
        if (!result || result.passed) return false;
        for (const cd of Object.values(cooldowns)) { if (cd.remaining > 0 || cd.locked) return false; }
        return true;
      }

      function renderOptions(q: any): string {
        const cd = cooldowns[q.id];
        const dis = (submitted && !canRetry()) || !!(cd && (cd.locked || cd.remaining > 0));
        if (q.type === 'single') {
          return `<div class="quiz-options">${(q.answers || []).map((a: any) => `
            <button type="button" class="quiz-option${answers[q.id] === a.id ? ' selected' : ''}" data-qid="${q.id}" data-aid="${a.id}" data-type="single"${dis ? ' disabled' : ''}>
              <span class="radio-circle"></span><span>${a.text}</span>
            </button>`).join('')}</div>`;
        }
        if (q.type === 'multiple') {
          return `<div class="quiz-options">${(q.answers || []).map((a: any) => {
            const chk = Array.isArray(answers[q.id]) && answers[q.id].includes(a.id);
            return `<button type="button" class="quiz-option${chk ? ' selected' : ''}" data-qid="${q.id}" data-aid="${a.id}" data-type="multiple"${dis ? ' disabled' : ''}>
              <span style="width:18px;height:18px;border-radius:4px;border:2px solid ${chk ? 'var(--blue)' : 'var(--line)'};background:${chk ? 'var(--blue)' : 'transparent'};flex:0 0 auto;display:flex;align-items:center;justify-content:center">${chk ? '<span style="color:#fff;font-size:.7rem;font-weight:700">✓</span>' : ''}</span>
              <span>${a.text}</span>
            </button>`;
          }).join('')}</div>`;
        }
        if (q.type === 'boolean') {
          return `<div style="display:flex;gap:12px">${[{v:'true',l:'Vrai'},{v:'false',l:'Faux'}].map(o => `
            <button type="button" class="quiz-option${answers[q.id] === (o.v === 'true') ? ' selected' : ''}" data-qid="${q.id}" data-bool="${o.v}" data-type="boolean" style="flex:1;justify-content:center"${dis ? ' disabled' : ''}>${o.l}</button>`).join('')}</div>`;
        }
        if (q.type === 'order') {
          const items = q.items || [];
          const order: string[] = Array.isArray(answers[q.id]) ? answers[q.id] : items.map((i: any) => i.id);
          return `<div class="quiz-options" id="order-${q.id}">${order.map((id: string, idx: number) => {
            const item = items.find((i: any) => i.id === id);
            return `<div class="order-item" draggable="true" data-qid="${q.id}" data-id="${id}">
              <span class="drag-handle">⠿</span>
              <span style="font-size:.8rem;font-weight:600;color:var(--ink-soft);width:20px;flex-shrink:0">${idx+1}.</span>
              <span style="flex:1;font-size:.875rem">${item?.text || id}</span>
              <div style="display:flex;gap:2px">
                <button type="button" class="order-move-btn" data-moveid="${q.id}" data-moveidx="${idx}" data-movedir="-1"${idx===0?' disabled':''}>↑</button>
                <button type="button" class="order-move-btn" data-moveid="${q.id}" data-moveidx="${idx}" data-movedir="1"${idx===order.length-1?' disabled':''}>↓</button>
              </div>
            </div>`;
          }).join('')}</div>`;
        }
        return '';
      }

      function updateAnsweredCount() {
        const el = document.getElementById('mini-answered');
        if (el) el.textContent = `${questions.filter((q: any) => isAnswered(q)).length}/${questions.length} répondues`;
      }

      function moveOrder(qId: string, idx: number, dir: number) {
        const arr = [...answers[qId]];
        const ni = idx + dir;
        if (ni < 0 || ni >= arr.length) return;
        [arr[idx], arr[ni]] = [arr[ni], arr[idx]];
        answers[qId] = arr;
        const q = questions.find((q: any) => q.id === qId)!;
        const optsEl = document.querySelector<HTMLElement>(`[data-mini-opts="${qId}"]`);
        if (optsEl) optsEl.innerHTML = renderOptions(q);
        bindOrderDrag(qId);
        updateAnsweredCount();
      }

      function reorderById(qId: string, fromId: string, toId: string) {
        const arr = [...answers[qId]];
        const fi = arr.indexOf(fromId), ti = arr.indexOf(toId);
        if (fi < 0 || ti < 0 || fi === ti) return;
        arr.splice(fi, 1); arr.splice(ti, 0, fromId);
        answers[qId] = arr;
        const q = questions.find((q: any) => q.id === qId)!;
        const optsEl = document.querySelector<HTMLElement>(`[data-mini-opts="${qId}"]`);
        if (optsEl) optsEl.innerHTML = renderOptions(q);
        bindOrderDrag(qId);
        updateAnsweredCount();
      }

      function bindOrderDrag(qId: string) {
        const orderContainer = document.getElementById(`order-${qId}`);
        if (!orderContainer) return;
        let dragSrcId: string | null = null;

        orderContainer.querySelectorAll<HTMLElement>('.order-item').forEach(item => {
          item.addEventListener('dragstart', e => {
            dragSrcId = item.dataset.id!;
            item.classList.add('dragging');
            if (e.dataTransfer) { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', dragSrcId); }
          });
          item.addEventListener('dragend', () => {
            item.classList.remove('dragging');
            orderContainer.querySelectorAll('.order-item').forEach(el => el.classList.remove('drag-over'));
            dragSrcId = null;
          });
          item.addEventListener('dragover', e => {
            e.preventDefault();
            if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
            if (item.dataset.id !== dragSrcId) {
              orderContainer.querySelectorAll('.order-item').forEach(el => el.classList.remove('drag-over'));
              item.classList.add('drag-over');
            }
          });
          item.addEventListener('dragleave', e => {
            if (!item.contains(e.relatedTarget as Node)) item.classList.remove('drag-over');
          });
          item.addEventListener('drop', e => {
            e.preventDefault();
            if (dragSrcId && dragSrcId !== item.dataset.id!) reorderById(qId, dragSrcId, item.dataset.id!);
          });
        });

        let touchItem: HTMLElement | null = null;
        let ghost: HTMLElement | null = null;
        let origTop = 0, origLeft = 0, touchStartX = 0, touchStartY = 0;

        orderContainer.querySelectorAll<HTMLElement>('.order-item').forEach(item => {
          item.addEventListener('touchstart', e => {
            if (e.touches.length !== 1) return;
            touchItem = item;
            const t = e.touches[0];
            touchStartX = t.clientX; touchStartY = t.clientY;
            const rect = item.getBoundingClientRect();
            origTop = rect.top; origLeft = rect.left;
            ghost = item.cloneNode(true) as HTMLElement;
            ghost.style.cssText = `position:fixed;z-index:9999;pointer-events:none;width:${rect.width}px;left:${origLeft}px;top:${origTop}px;opacity:.88;transform:rotate(1.5deg) scale(1.02);box-shadow:0 8px 28px rgba(0,0,0,.22);transition:none`;
            document.body.appendChild(ghost);
            item.classList.add('dragging');
          }, { passive: true });

          item.addEventListener('touchmove', e => {
            if (!touchItem || !ghost || e.touches.length !== 1) return;
            const t = e.touches[0];
            ghost.style.top = (origTop + t.clientY - touchStartY) + 'px';
            ghost.style.left = (origLeft + t.clientX - touchStartX) + 'px';
            ghost.style.display = 'none';
            const el = document.elementFromPoint(t.clientX, t.clientY);
            ghost.style.display = '';
            const hovered = el?.closest<HTMLElement>(`#order-${qId} .order-item`);
            orderContainer.querySelectorAll('.order-item').forEach(i => i.classList.remove('drag-over'));
            if (hovered && hovered !== touchItem) hovered.classList.add('drag-over');
          }, { passive: true });

          item.addEventListener('touchend', e => {
            if (!touchItem) return;
            ghost?.remove(); ghost = null;
            touchItem.classList.remove('dragging');
            orderContainer.querySelectorAll('.order-item').forEach(i => i.classList.remove('drag-over'));
            const t = e.changedTouches[0];
            const el = document.elementFromPoint(t.clientX, t.clientY);
            const hovered = el?.closest<HTMLElement>(`#order-${qId} .order-item`);
            if (hovered && hovered !== touchItem) reorderById(qId, touchItem.dataset.id!, hovered.dataset.id!);
            touchItem = null;
          });
        });
      }

      function showBody() {
        const body = document.getElementById('mini-quiz-body')!;
        body.innerHTML = `
          <div id="mini-questions" class="stack" style="gap:16px;margin-bottom:16px">
            ${questions.map((q: any, i: number) => {
              const cd = cooldowns[q.id];
              const cdBanner = cd && (cd.locked || cd.remaining > 0)
                ? `<div class="cooldown-banner" id="mini-cd-${q.id}">${cd.locked ? '🔒 Question verrouillée' : `⏳ Réessayez dans ${cd.remaining}s`}</div>`
                : '';
              return `<div>
                <p style="font-weight:600;font-size:.875rem;margin-bottom:8px">${i+1}. ${q.question}</p>
                ${cdBanner}
                <div data-mini-opts="${q.id}">${renderOptions(q)}</div>
              </div>`;
            }).join('')}
          </div>
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <button class="btn btn-primary" id="mini-submit-btn">Valider le quiz ▸</button>
            <span id="mini-answered" style="font-size:.8rem;color:var(--ink-soft)">${questions.filter((q: any) => isAnswered(q)).length}/${questions.length} répondues</span>
          </div>
        `;

        questions.forEach((q: any) => { if (q.type === 'order') bindOrderDrag(q.id); });

        document.getElementById('mini-questions')!.addEventListener('click', (e: MouseEvent) => {
          const target = e.target as HTMLElement;

          const optBtn = target.closest<HTMLButtonElement>('button.quiz-option');
          if (optBtn && !optBtn.disabled) {
            const qid = optBtn.dataset.qid!;
            const type = optBtn.dataset.type!;
            if (type === 'single') {
              answers[qid] = optBtn.dataset.aid!;
            } else if (type === 'multiple') {
              const arr = [...(Array.isArray(answers[qid]) ? answers[qid] : [])];
              const i = arr.indexOf(optBtn.dataset.aid!);
              if (i >= 0) arr.splice(i, 1); else arr.push(optBtn.dataset.aid!);
              answers[qid] = arr;
            } else if (type === 'boolean') {
              answers[qid] = optBtn.dataset.bool === 'true';
            }
            const q = questions.find((q: any) => q.id === qid)!;
            const optsEl = document.querySelector<HTMLElement>(`[data-mini-opts="${qid}"]`);
            if (optsEl) optsEl.innerHTML = renderOptions(q);
            updateAnsweredCount();
            return;
          }

          const moveBtn = target.closest<HTMLButtonElement>('.order-move-btn');
          if (moveBtn && !moveBtn.disabled) {
            moveOrder(moveBtn.dataset.moveid!, parseInt(moveBtn.dataset.moveidx!), parseInt(moveBtn.dataset.movedir!));
          }
        });

        document.getElementById('mini-submit-btn')!.addEventListener('click', submitMini);
      }

      function showResult() {
        const body = document.getElementById('mini-quiz-body')!;
        const passed = result.passed;
        const pct = result.max_score > 0 ? Math.round(result.total_score / result.max_score * 100) : 0;

        let reviewHtml = '';
        if (result.question_results?.length > 0) {
          reviewHtml = `<div style="margin-top:16px">
            <p style="font-weight:700;font-size:.875rem;margin-bottom:10px">Correction</p>
            ${result.question_results.map((qr: any, i: number) => {
              const q = questions.find((qq: any) => qq.id === qr.question_id);
              return `<div style="border:1.5px solid ${qr.is_correct ? 'var(--good)' : 'var(--bad)'};border-radius:10px;padding:12px 14px;margin-bottom:8px">
                <div style="display:flex;align-items:flex-start;gap:8px">
                  <span style="flex-shrink:0;color:${qr.is_correct ? 'var(--good)' : 'var(--bad)'}">${qr.is_correct ? '✓' : '✗'}</span>
                  <div style="flex:1">
                    <p style="font-weight:600;font-size:.8rem;margin-bottom:2px">${i+1}. ${q?.question || ''}</p>
                    <p style="font-size:.75rem;color:var(--ink-soft)">${qr.points_earned}/${qr.points_max} pt${qr.points_max > 1 ? 's' : ''}</p>
                    ${qr.feedback ? `<p style="font-size:.75rem;margin-top:4px;color:var(--ink-soft)">${qr.feedback}</p>` : ''}
                  </div>
                </div>
              </div>`;
            }).join('')}
          </div>`;
        }

        body.innerHTML = `
          <div style="display:flex;align-items:center;gap:20px;background:${passed ? 'var(--good-soft)' : 'var(--bad-soft)'};border:1.5px solid ${passed ? 'var(--good)' : 'var(--bad)'};border-radius:12px;padding:20px;margin-bottom:12px;flex-wrap:wrap">
            <div style="width:70px;height:70px;border-radius:50%;border:6px solid ${passed ? 'var(--good)' : 'var(--bad)'};background:var(--paper);display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 auto">
              <div style="font-size:1.2rem;font-weight:700;color:${passed ? 'var(--good)' : 'var(--bad)'}">${pct}%</div>
              <div style="font-size:.65rem;color:var(--ink-soft)">${result.total_score}/${result.max_score}</div>
            </div>
            <div style="flex:1;min-width:160px">
              <h3 style="font-size:.95rem;font-weight:700;margin-bottom:4px;color:${passed ? 'var(--good)' : 'var(--bad)'}">${passed ? '✓ Quiz réussi !' : '✗ Quiz échoué'}</h3>
              <p style="font-size:.8rem;color:var(--ink-soft)">${passed ? `Félicitations — ${result.total_score} pts sur ${result.max_score}.` : `Score insuffisant (${pct}%). Réessayez !`}</p>
            </div>
          </div>
          ${!passed ? `<div style="margin-bottom:12px"><button class="btn btn-primary" id="mini-retry-btn">Recommencer</button></div>` : ''}
          ${reviewHtml}
        `;

        document.getElementById('mini-retry-btn')?.addEventListener('click', () => {
          submitted = false; result = null;
          initAnswers();
          showBody();
        });
      }

      async function submitMini() {
        const payload: Record<string, any> = {};
        for (const q of questions) {
          const v = answers[q.id];
          if (q.type === 'single') payload[q.id] = { single: v || null };
          else if (q.type === 'multiple') payload[q.id] = { multiple: v };
          else if (q.type === 'boolean') payload[q.id] = { boolean: v };
          else if (q.type === 'order') payload[q.id] = { order: v };
        }
        const btn = document.getElementById('mini-submit-btn') as HTMLButtonElement;
        if (btn) { btn.disabled = true; btn.textContent = 'Envoi…'; }
        try {
          result = await apiFetch(`/courses/${slug}/modules/${quizIndex}/submit`, {
            method: 'POST', body: { answers: payload }, token: token!,
          }) as any;
          submitted = true;
          startCooldowns(result.cooldowns || {});
          showResult();
        } catch (e: any) {
          if (e.status === 425 && e.body?.cooldowns) startCooldowns(e.body.cooldowns);
          if (btn) { btn.disabled = false; btn.textContent = 'Valider le quiz ▸'; }
          (window as any).showToast?.('Erreur lors de la soumission', 'error');
        }
      }

      container.innerHTML = `
        <div class="mini-quiz-block">
          <div class="mini-quiz-header">
            <img src="/pioupitre.png" alt="pioupitre" />
            <div>
              <div class="mini-quiz-title">Mini-quiz · fin de module</div>
              <div class="mini-quiz-subtitle">${quizMod.name} · ${questions.length} question${questions.length !== 1 ? 's' : ''}</div>
            </div>
          </div>
          <div id="mini-quiz-body"></div>
        </div>
      `;

      const initCd = quizMod.cooldowns || loadCooldownsFromCookie(quizIndex);
      if (initCd) startCooldowns(initCd);
      showBody();
    }

    init();
  </script>
</App>
