---
import App from '../layouts/App.astro';
---
<App title="Mes badges" activePage="badges">
  <style is:global>
    .mb-page { padding: 28px 36px 80px; max-width: 900px; margin: 0 auto; }

    .mb-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }
    .mb-title { font-size: 1.5rem; font-weight: 700; }

    .mb-stats {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .mb-stat { display: flex; flex-direction: column; gap: 2px; }
    .mb-stat-val { font-size: 1.6rem; font-weight: 700; color: var(--blue); line-height: 1; }
    .mb-stat-label { font-size: .78rem; color: var(--ink-soft); }

    .mb-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .mb-card {
      border: 1.5px solid #22c55e33;
      border-radius: 14px;
      background: var(--paper);
      padding: 20px 16px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      text-align: center;
      text-decoration: none;
      color: inherit;
      transition: box-shadow .15s, border-color .15s;
    }
    .mb-card:hover { border-color: #22c55e; box-shadow: 0 4px 18px rgba(34,197,94,.12); }

    .mb-card-icon {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f0fdf4, #dcfce7);
      border: 2px solid #22c55e44;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
    }
    .mb-card-name { font-weight: 700; font-size: .95rem; }
    .mb-card-course { font-size: .78rem; color: var(--ink-soft); }
    .mb-card-date { font-size: .72rem; color: var(--ink-soft); margin-top: auto; }
    .mb-card-earned-by {
      font-size: .7rem;
      color: #16a34a;
      background: #f0fdf4;
      border: 1px solid #22c55e33;
      border-radius: 20px;
      padding: 2px 10px;
    }

    .mb-empty {
      text-align: center;
      padding: 80px 24px;
    }
    .mb-empty-icon { font-size: 3.5rem; margin-bottom: 16px; }
    .mb-empty h2 { font-size: 1.2rem; margin-bottom: 8px; }
    .mb-empty p { color: var(--ink-soft); font-size: .9rem; margin-bottom: 20px; }

    @media (max-width: 768px) {
      .mb-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .mb-page { padding: 20px 14px 80px; }
      .mb-header { flex-direction: column; align-items: flex-start; }
      .mb-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="mb-page">
    <div class="mb-header">
      <h1 class="mb-title">Mes badges</h1>
    </div>

    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

    <div id="mb-content" style="display:none">
      <div class="mb-stats" id="mb-stats"></div>
      <div id="mb-grid" class="mb-grid"></div>
      <div id="mb-empty" class="mb-empty" style="display:none">
        <div class="mb-empty-icon">🏅</div>
        <h2>Aucun badge pour l'instant</h2>
        <p>Complète des cours pour remporter tes premiers badges.</p>
        <a href="/courses" class="btn btn-primary">Découvrir le catalogue</a>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function apiFetch(path: string, opts: { token?: string } = {}) {
      const headers: Record<string, string> = {};
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch(`/api${path}`, { headers });
      if (!res.ok) { const err: any = new Error('fetch error'); err.status = res.status; throw err; }
      return res.json();
    }

    function formatDate(iso: string) {
      return new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    }

    async function init() {
      if (!token) { window.location.href = '/login?redirect=/my-badges'; return; }

      try {
        const data = await apiFetch('/my/badges', { token }) as any;
        const badges: any[] = data.badges || [];

        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('mb-content')!.style.display = '';

        document.getElementById('mb-stats')!.innerHTML = `
          <div class="mb-stat">
            <span class="mb-stat-val">${badges.length}</span>
            <span class="mb-stat-label">Badge${badges.length !== 1 ? 's' : ''} obtenu${badges.length !== 1 ? 's' : ''}</span>
          </div>
        `;

        if (badges.length === 0) {
          document.getElementById('mb-empty')!.style.display = '';
          return;
        }

        document.getElementById('mb-grid')!.innerHTML = badges.map((b: any) => `
          <a href="/courses/${b.courseSlug}" class="mb-card">
            <div class="mb-card-icon">${b.icon || '🏅'}</div>
            <div class="mb-card-name">${b.name || b.courseSlug}</div>
            <div class="mb-card-course">${b.courseTitle || b.courseSlug}</div>
            ${b.earnedBy > 1 ? `<div class="mb-card-earned-by">${b.earnedBy} personnes</div>` : ''}
            <div class="mb-card-date">Obtenu le ${formatDate(b.earnedAt)}</div>
          </a>
        `).join('');
      } catch {
        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('mb-content')!.style.display = '';
        document.getElementById('mb-empty')!.style.display = '';
      }
    }

    init();
  </script>
</App>
