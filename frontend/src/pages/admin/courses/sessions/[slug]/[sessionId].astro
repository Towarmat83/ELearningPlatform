---
import Admin from '../../../../../layouts/Admin.astro';
---
<Admin title="Participants — Session" activePage="courses" allowedRoles={['admin', 'manager']}>
  <style is:global>
    .presence-wrap { max-width: 900px; margin: 0 auto; padding: 32px 24px; }
    .presence-back { font-size:.85rem; color:var(--ink-soft); text-decoration:none; display:inline-flex; align-items:center; gap:6px; margin-bottom:20px; }
    .presence-back:hover { color:var(--ink); }
    .presence-title { font-size:1.4rem; font-weight:700; margin-bottom:4px; }
    .presence-sub { font-size:.875rem; color:var(--ink-soft); margin-bottom:24px; }
    .presence-stats { display:flex; gap:16px; margin-bottom:24px; flex-wrap:wrap; }
    .stat-chip {
      background:var(--fill); border:1.5px solid var(--line); border-radius:10px;
      padding:10px 18px; font-size:.82rem; font-weight:600;
    }
    .stat-chip span { font-size:1.3rem; font-weight:800; display:block; }
    .stat-chip.green { background:#f0fdf4; border-color:#86efac; color:#16a34a; }
    .presence-table { width:100%; border-collapse:collapse; font-size:.875rem; }
    .presence-table th {
      text-align:left; padding:10px 14px; font-size:.72rem; font-weight:700;
      color:var(--ink-soft); text-transform:uppercase; letter-spacing:.06em;
      border-bottom:2px solid var(--line);
    }
    .presence-table td { padding:12px 14px; border-bottom:1px solid var(--line); vertical-align:middle; }
    .presence-table tr:last-child td { border-bottom:none; }
    .presence-table tr:hover td { background:var(--fill); }
    .presence-cb { width:20px; height:20px; accent-color:var(--blue); cursor:pointer; }
    .badge-present { background:#f0fdf4; color:#16a34a; border:1px solid #86efac; border-radius:6px; padding:2px 10px; font-size:.75rem; font-weight:700; }
    .badge-absent { background:#fef2f2; color:#dc2626; border:1px solid #fca5a5; border-radius:6px; padding:2px 10px; font-size:.75rem; font-weight:700; }
    .no-participants { text-align:center; padding:60px 20px; color:var(--ink-soft); }
  </style>

  <div class="presence-wrap">
    <a href="/agenda" class="presence-back">← Retour à l'agenda</a>
    <div class="presence-title" id="page-title">Chargement…</div>
    <div class="presence-sub" id="page-sub"></div>

    <div class="presence-stats" id="stats-row"></div>

    <table class="presence-table" id="participants-table" style="display:none">
      <thead>
        <tr>
          <th>Participant</th>
          <th>Email</th>
          <th>Inscrit le</th>
          <th style="text-align:center">Présent</th>
        </tr>
      </thead>
      <tbody id="participants-body"></tbody>
    </table>

    <div class="no-participants" id="no-participants" style="display:none">
      Aucun participant inscrit pour cette session.
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    const pathParts = window.location.pathname.split('/');
    // /admin/courses/sessions/{slug}/{sessionId}
    const sessionId = pathParts[pathParts.length - 1];
    const slug = pathParts[pathParts.length - 2];

    const user = JSON.parse(localStorage.getItem('user') || '{}');
    const isManager = user.role === 'manager';
    const apiBase = isManager ? '/api/manager' : '/api/admin';

    async function apiFetch(path: string, opts: { method?: string; body?: any } = {}) {
      const h: Record<string, string> = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` };
      const r = await fetch(path, {
        method: opts.method || 'GET',
        headers: h,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (r.status === 401) { localStorage.clear(); location.href = '/login'; throw new Error('401'); }
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    }

    let participants: any[] = [];

    function renderStats() {
      const total = participants.length;
      const present = participants.filter(p => p.present).length;
      document.getElementById('stats-row')!.innerHTML = `
        <div class="stat-chip"><span>${total}</span>Inscrits</div>
        <div class="stat-chip green"><span>${present}</span>Présents</div>
        <div class="stat-chip"><span>${total - present}</span>Absents</div>
      `;
    }

    function renderTable() {
      const tbody = document.getElementById('participants-body')!;
      tbody.innerHTML = '';

      participants.forEach((p, idx) => {
        const tr = document.createElement('tr');
        const dateStr = new Date(p.bookedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
        tr.innerHTML = `
          <td><strong>${p.username}</strong></td>
          <td style="color:var(--ink-soft)">${p.email}</td>
          <td style="color:var(--ink-soft)">${dateStr}</td>
          <td style="text-align:center">
            <input type="checkbox" class="presence-cb" data-idx="${idx}" data-uid="${p.userId}" ${p.present ? 'checked' : ''} />
          </td>
        `;
        tbody.appendChild(tr);
      });

      tbody.querySelectorAll<HTMLInputElement>('input.presence-cb').forEach(cb => {
        cb.addEventListener('change', async () => {
          const idx = parseInt(cb.dataset.idx!);
          const uid = cb.dataset.uid!;
          const present = cb.checked;

          try {
            await apiFetch(`${apiBase}/courses/${slug}/sessions/${sessionId}/bookings/${uid}/presence`, {
              method: 'PATCH',
              body: { present },
            });
            participants[idx].present = present;
            renderStats();
          } catch {
            cb.checked = !present;
            alert('Erreur lors de la mise à jour de la présence.');
          }
        });
      });
    }

    async function init() {
      try {
        // Fetch course info for title
        const [courseResp, partResp] = await Promise.all([
          fetch(`/api/courses/${slug}`).then(r => r.json()).catch(() => null),
          apiFetch(`${apiBase}/courses/${slug}/sessions/${sessionId}/bookings`),
        ]);

        const course = courseResp?.course;
        const session = course?.sessions?.find((s: any) => s.id === sessionId);

        document.getElementById('page-title')!.textContent = session?.title ?? `Session ${sessionId}`;
        document.getElementById('page-sub')!.textContent = course?.title
          ? `${course.title}${session?.date ? ' · ' + new Date(session.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : ''}`
          : slug;

        participants = partResp.participants ?? [];

        if (participants.length === 0) {
          document.getElementById('no-participants')!.style.display = 'block';
        } else {
          document.getElementById('participants-table')!.style.display = 'table';
          renderTable();
        }
        renderStats();
      } catch (e) {
        document.getElementById('page-title')!.textContent = 'Erreur de chargement';
      }
    }

    init();
  </script>
</Admin>
