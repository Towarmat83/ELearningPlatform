---
import App from './App.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/manager';

const navItems = [
  { href: '/manager/users',  label: '👥 Mes membres' },
  { href: '/manager/groups', label: '🏷️ Mes groupes' },
  { href: '/manager/paths',  label: '🗺️ Parcours'    },
];

function isActive(href: string) {
  return path.startsWith(href);
}
---
<App title={`${title} — Manager`}>
  <div id="manager-forbidden" class="shell-forbidden">
    <div class="shell-forbidden-inner">
      <div class="shell-forbidden-icon">🔒</div>
      <h2 class="mb-2">Accès refusé</h2>
      <p class="text-soft text-sm mb-5">Réservé aux managers de groupe.</p>
      <a href="/courses" class="btn btn-primary">Retour au catalogue</a>
    </div>
  </div>

  <div id="manager-shell" class="shell-hidden">
    <div class="shell-layout">
      <aside class="shell-sidebar">
        <div class="shell-sidebar-label">Mon espace</div>
        <nav class="shell-sidebar-nav">
          {navItems.map(item => (
            <a href={item.href} class={`sidebar-link${isActive(item.href) ? ' active' : ''}`}>{item.label}</a>
          ))}
        </nav>
        <div class="shell-sidebar-bottom">
          <a href="/courses" class="sidebar-link text-ink-soft text-[.82rem]">← Retour au catalogue</a>
        </div>
      </aside>

      <main class="shell-main">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user') || 'null');

    if (!token) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
    } else if (user?.role !== 'manager') {
      document.getElementById('manager-forbidden')!.style.display = 'flex';
    } else {
      document.getElementById('manager-shell')!.style.display = 'block';
    }
  </script>
</App>
