---
import App from '../layouts/App.astro';
---
<App title="Classement" activePage="leaderboard">
  <div class="page-outer">
    <div class="page-inner">
      <div class="text-center mb-12">
        <h1 class="page-title mb-1.5">Classement</h1>
        <p class="text-[.9rem] text-ink-soft">badges obtenus</p>
      </div>

      <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

      <div id="lb-podium" class="hidden justify-center items-end gap-2 mb-10 sm:gap-4 flex"></div>

      <div id="lb-divider" class="hidden divider-text mb-4">Autres participants</div>

      <div id="lb-list" class="hidden flex-col gap-2 flex"></div>

      <div id="lb-empty" class="hidden text-center py-20 px-6 text-ink-soft">
        <div class="text-[3rem] mb-3">🏅</div>
        <p>Aucun badge décerné pour l'instant.</p>
      </div>
    </div>
  </div>

  <script>
    function medal(rank: number) {
      if (rank === 1) return '🥇';
      if (rank === 2) return '🥈';
      if (rank === 3) return '🥉';
      return `#${rank}`;
    }

    function avatarContent(entry: any) {
      const initial = (entry.username || '?')[0].toUpperCase();
      if (!entry.avatarUrl) return initial;
      const isUrl = entry.avatarUrl.startsWith('http://') || entry.avatarUrl.startsWith('https://');
      if (isUrl) return `<img src="${entry.avatarUrl}" alt="${entry.username}" />`;
      return entry.avatarUrl;
    }

    function podiumCard(e: any) {
      const sizeMap: Record<number, string> = {
        1: 'w-[88px] h-[88px] text-[1.8rem] border-[#fcd34d] bg-gradient-to-br from-[#fefce8] to-[#fef08a] text-[#a16207]',
        2: 'w-[72px] h-[72px] text-[1.4rem] border-[#c7d2fe] bg-gradient-to-br from-[#f0f4ff] to-[#e0e7ff] text-[#4361ee]',
        3: 'w-[68px] h-[68px] text-[1.3rem] border-[#fdba74] bg-gradient-to-br from-[#fff7ed] to-[#ffedd5] text-[#c2410c]',
      };
      const blockMap: Record<number, string> = {
        1: 'h-20 bg-gradient-to-b from-[#fde68a] to-[#fcd34d] text-[#a16207]',
        2: 'h-14 bg-gradient-to-b from-[#c7d2fe] to-[#a5b4fc] text-[#3730a3]',
        3: 'h-10 bg-gradient-to-b from-[#fdba74] to-[#fb923c] text-[#7c2d12]',
      };
      const nameSize = e.rank === 1 ? 'text-base' : 'text-[.9rem]';
      const medalSize = e.rank === 1 ? 'text-[2.2rem]' : 'text-[1.8rem]';
      const orderMap: Record<number, string> = { 1: 'order-2', 2: 'order-1', 3: 'order-3' };
      return `
        <a href="/users/${e.userId}" class="lb-podium-card ${orderMap[e.rank] ?? ''}">
          <div class="lb-podium-avatar ${sizeMap[e.rank] ?? 'w-16 h-16 text-lg border-line bg-fill'}">${avatarContent(e)}</div>
          <div class="lb-podium-medal ${medalSize}">${medal(e.rank)}</div>
          <div class="lb-podium-name ${nameSize}">${e.username}</div>
          <div class="lb-podium-count">${e.count} badge${e.count > 1 ? 's' : ''}</div>
          <div class="lb-podium-block ${blockMap[e.rank] ?? 'h-8 bg-fill text-ink-soft'}">${e.rank}</div>
        </a>
      `;
    }

    function listRow(e: any) {
      const icons: string[] = e.icons || [];
      const displayIcons = icons.slice(0, 10).join(' ');
      const extra = icons.length > 10
        ? `<span class="text-[.75rem] text-ink-soft">+${icons.length - 10}</span>`
        : '';
      const initial = (e.username || '?')[0].toUpperCase();
      const avatarHtml = e.avatarUrl
        ? (e.avatarUrl.startsWith('http') ? `<img src="${e.avatarUrl}" alt="${e.username}" class="w-full h-full object-cover" />` : e.avatarUrl)
        : initial;
      return `
        <a href="/users/${e.userId}" class="lb-row">
          <div class="lb-rank">#${e.rank}</div>
          <div class="lb-avatar">${avatarHtml}</div>
          <div class="lb-info">
            <div class="lb-username">${e.username}</div>
            <div class="lb-count">${e.count} badge${e.count > 1 ? 's' : ''}</div>
          </div>
          <div class="lb-icons sm:hidden">${displayIcons}${extra}</div>
        </a>
      `;
    }

    async function init() {
      const res = await fetch('/api/leaderboard');
      document.getElementById('loading')!.classList.add('hidden');

      if (!res.ok) { document.getElementById('lb-empty')!.classList.remove('hidden'); return; }

      const data = await res.json() as any;
      const entries: any[] = data.leaderboard || [];

      if (entries.length === 0) { document.getElementById('lb-empty')!.classList.remove('hidden'); return; }

      const top3 = entries.filter((e: any) => e.rank <= 3);
      const rest = entries.filter((e: any) => e.rank > 3);

      if (top3.length > 0) {
        const podium = document.getElementById('lb-podium')!;
        podium.classList.remove('hidden');
        podium.innerHTML = top3.map(podiumCard).join('');
      }

      if (rest.length > 0) {
        document.getElementById('lb-divider')!.classList.remove('hidden');
        const list = document.getElementById('lb-list')!;
        list.classList.remove('hidden');
        list.innerHTML = rest.map(listRow).join('');
      }
    }

    init();
  </script>
</App>
