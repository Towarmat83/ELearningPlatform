---
import App from '../../layouts/App.astro';
---
<App title="Profil">
  <div class="up-outer">
  <div class="page-inner">
    <a href="/leaderboard" class="up-back">← Retour au classement</a>
    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>
    <div id="up-content" class="hidden">
      <div class="up-header">
        <div class="up-avatar" id="up-avatar"></div>
        <div>
          <div class="up-username" id="up-username"></div>
          <div class="up-subtitle" id="up-subtitle"></div>
        </div>
      </div>

      <div class="up-section-title" id="up-section-label"></div>
      <div id="up-grid" class="up-grid"></div>
      <div id="up-empty" class="up-empty hidden">Aucun badge pour l'instant.</div>
    </div>
  </div>
  </div>

  <script>
    async function apiFetch(path: string) {
      const res = await fetch(`/api${path}`);
      if (!res.ok) { const err: any = new Error(); err.status = res.status; throw err; }
      return res.json();
    }

    const id = location.pathname.split('/').pop()!;

    async function init() {
      try {
        const [userRes, badgesRes] = await Promise.allSettled([
          apiFetch(`/users/${id}`),
          apiFetch(`/users/${id}/badges`),
        ]);

        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('up-content')!.classList.remove('hidden');

        // Header
        const user: any = userRes.status === 'fulfilled' ? userRes.value : null;
        const username = user?.username || 'Utilisateur';
        document.title = `${username} — pupitre`;
        document.getElementById('up-username')!.textContent = username;

        const avatarEl = document.getElementById('up-avatar')!;
        if (user?.avatarUrl) {
          const isUrl = user.avatarUrl.startsWith('http://') || user.avatarUrl.startsWith('https://');
          if (isUrl) {
            avatarEl.innerHTML = `<img src="${user.avatarUrl}" alt="${username}" />`;
          } else {
            avatarEl.style.fontSize = '2.2rem';
            avatarEl.textContent = user.avatarUrl;
          }
        } else {
          avatarEl.textContent = username[0].toUpperCase();
        }

        const badges: any[] = badgesRes.status === 'fulfilled'
          ? (badgesRes.value as any).badges || []
          : [];

        document.getElementById('up-subtitle')!.textContent =
          badges.length > 0
            ? `${badges.length} badge${badges.length > 1 ? 's' : ''} obtenu${badges.length > 1 ? 's' : ''}`
            : 'Aucun badge pour l\'instant';

        if (badges.length === 0) {
          document.getElementById('up-empty')!.classList.remove('hidden');
          return;
        }

        document.getElementById('up-section-label')!.textContent = 'Badges obtenus';

        document.getElementById('up-grid')!.innerHTML = badges.map((b: any) => `
          <a href="/courses/${b.courseSlug}" class="up-card">
            <div class="up-card-icon">${b.icon || '🏅'}</div>
            <div class="up-card-name">${b.name || b.courseSlug}</div>
            <div class="up-card-course">${b.courseTitle || b.courseSlug}</div>
            <div class="up-card-earners">${b.earnedBy} apprenant${b.earnedBy > 1 ? 's' : ''}</div>
          </a>
        `).join('');
      } catch {
        document.getElementById('loading')!.innerHTML =
          '<p class="text-center text-ink-soft p-10">Profil introuvable.</p>';
      }
    }

    init();
  </script>
</App>
