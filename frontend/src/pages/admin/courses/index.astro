---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Cours">
  <style is:global>
    .course-item { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden; margin-bottom: 8px; }
    .mod-item.dragging { opacity: .35; }
    .mod-item.drag-over { border-color: var(--blue); box-shadow: 0 0 0 2px var(--blue-soft); }
    .mod-drag-handle { cursor: grab; color: var(--ink-soft); font-size: 1.1rem; flex-shrink: 0; padding: 0 2px; opacity: .35; line-height: 1; user-select: none; }
    .mod-drag-handle:hover { opacity: 1; }
    .mod-item.dragging .mod-drag-handle { cursor: grabbing; }
    .course-item.editing > .course-header { background: var(--blue-soft); }
    .course-inline-form { background: var(--blue-soft); border-top: 1px solid var(--blue); padding: 20px 24px; }
    .course-header { display: flex; align-items: center; gap: 12px; padding: 14px 18px; cursor: pointer; transition: background .12s; user-select: none; }
    .course-header:hover { background: var(--fill); }
    .course-info { flex: 1; min-width: 0; }
    .course-title { font-weight: 600; font-size: .9rem; color: var(--ink); }
    .course-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 3px; }
    .course-slug { font-family: monospace; font-size: .72rem; color: var(--ink-soft); background: var(--fill); padding: 1px 6px; border-radius: 4px; }
    .course-actions { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
    .link-btn { background: none; border: none; cursor: pointer; font-size: .78rem; font-weight: 600; padding: 4px 8px; border-radius: 6px; white-space: nowrap; }
    .link-btn.violet { color: #7c3aed; } .link-btn.violet:hover { background: #ede9fe; }
    .link-btn.gray { color: var(--ink-soft); } .link-btn.gray:hover { background: var(--fill); }
    .link-btn.red { color: var(--bad); } .link-btn.red:hover { background: var(--bad-soft); }
    .link-btn.orange { color: #92400e; background: var(--orange-soft); } .link-btn.orange:hover { background: #fde68a; }
    .chevron { width: 18px; height: 18px; color: var(--ink-soft); flex-shrink: 0; transition: transform .2s; }
    .chevron.open { transform: rotate(180deg); }
    .panel { border-top: 1px solid var(--line); }
    .tab-bar { display: flex; border-bottom: 1px solid var(--line); background: var(--paper); padding: 0 18px; }
    .tab-btn { padding: 10px 16px; font-size: .83rem; font-weight: 600; border: none; border-bottom: 2px solid transparent; cursor: pointer; background: none; color: var(--ink-soft); margin-bottom: -1px; transition: color .15s, border-color .15s; }
    .tab-btn.active { color: var(--blue); border-bottom-color: var(--blue); }
    .tab-count { font-size: .72rem; margin-left: 4px; padding: 1px 6px; border-radius: 100px; background: var(--fill); }
    .tab-btn.active .tab-count { background: var(--blue-soft); color: var(--blue); }
    .tab-content { padding: 20px; background: var(--fill); }
    .mod-item { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 14px; display: flex; align-items: flex-start; gap: 10px; transition: border-color .12s; }
    .mod-item.editing { border-color: var(--blue); border-bottom-left-radius: 0; border-bottom-right-radius: 0; border-bottom: none; }
    .mod-idx { font-family: monospace; font-size: .75rem; color: var(--ink-soft); width: 24px; text-align: right; flex-shrink: 0; margin-top: 2px; }
    .mod-info { flex: 1; min-width: 0; }
    .mod-name { font-weight: 500; font-size: .875rem; }
    .mod-actions { display: flex; gap: 4px; align-items: center; flex-shrink: 0; }
    .mod-inline-form { background: var(--blue-soft); border: 1px solid var(--blue); border-top: none; border-bottom-left-radius: var(--radius); border-bottom-right-radius: var(--radius); padding: 14px 16px; margin-bottom: 0; }
    .mod-form { background: var(--paper); border: 1px solid var(--blue); border-radius: var(--radius); padding: 16px; margin-bottom: 12px; }
    .mod-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
    .enroll-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: var(--fill); border: 1px solid var(--line); border-radius: var(--radius); }
    .section-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-soft); margin-bottom: 8px; }
    .draft-panel { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px; margin-bottom: 20px; box-shadow: var(--shadow-sm); }
    .draft-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 300; align-items: center; justify-content: center; padding: 24px; }
    .modal-overlay.open { display: flex; }
    .modal-box { background: var(--paper); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); width: 100%; max-width: 680px; display: flex; flex-direction: column; max-height: 85vh; }
    .modal-head { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--line); }
    .modal-body { padding: 20px 24px; overflow-y: auto; flex: 1; }
    .modal-foot { padding: 16px 24px; border-top: 1px solid var(--line); display: flex; justify-content: flex-end; gap: 8px; }
    pre.yaml { background: #1a1a2e; color: #7ee787; font-size: .75rem; border-radius: var(--radius); padding: 18px; overflow: auto; font-family: monospace; line-height: 1.6; }
    .stack { display: flex; flex-direction: column; gap: 10px; }
    .stack-sm { display: flex; flex-direction: column; gap: 6px; }
    .flex-row { display: flex; gap: 8px; align-items: center; }
    .slug-warn { font-size: .73rem; color: var(--bad); margin-top: 3px; }
  </style>

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px">
    <div>
      <h1 style="font-size:1.5rem">Cours</h1>
      <p class="text-soft text-sm" style="margin-top:4px" id="course-count">Chargement…</p>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-primary btn-sm" id="new-course-btn">+ Nouveau cours</button>
      <button class="btn btn-secondary btn-sm" id="clear-all-cache">🗑 Vider tout le cache</button>
    </div>
  </div>

  <!-- Course draft form -->
  <div id="draft-panel" class="draft-panel" style="display:none">
    <h3 id="draft-title" style="margin-bottom:16px">Nouveau cours</h3>
    <div class="draft-grid">
      <div>
        <label class="label" for="d-slug">Slug <span style="color:var(--bad)">*</span></label>
        <input class="input" id="d-slug" type="text" style="font-family:monospace" placeholder="mon-cours" />
        <p class="slug-warn" id="slug-warn" style="display:none">Lettres minuscules, chiffres et tirets uniquement.</p>
      </div>
      <div>
        <label class="label" for="d-title">Titre <span style="color:var(--bad)">*</span></label>
        <input class="input" id="d-title" type="text" placeholder="Introduction à Kubernetes" />
      </div>
    </div>
    <div style="margin-bottom:14px">
      <label class="label" for="d-desc">Description</label>
      <textarea class="input" id="d-desc" rows="2" placeholder="Une courte description du cours…"></textarea>
    </div>
    <div class="draft-grid">
      <div>
        <label class="label" for="d-category">Catégorie</label>
        <input class="input" id="d-category" type="text" placeholder="DevOps" />
      </div>
      <div>
        <label class="label" for="d-difficulty">Difficulté</label>
        <select class="input" id="d-difficulty">
          <option value="beginner">Débutant</option>
          <option value="intermediate">Intermédiaire</option>
          <option value="advanced">Avancé</option>
        </select>
      </div>
    </div>
    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:16px">
      <input type="checkbox" id="d-public" style="width:16px;height:16px;accent-color:var(--blue)" />
      <span style="font-size:.875rem">Public <span class="text-soft" style="font-size:.8rem">(visible sans inscription)</span></span>
    </label>
    <div style="display:flex;gap:8px">
      <button class="btn btn-primary btn-sm" id="draft-save">Créer le cours</button>
      <button class="btn btn-secondary btn-sm" id="draft-cancel">Annuler</button>
    </div>
  </div>

  <!-- Search -->
  <div style="margin-bottom:16px">
    <input id="search-input" class="input" style="width:300px" placeholder="Rechercher un cours…" />
  </div>

  <!-- Course list -->
  <div id="loading" class="loading-state"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div>
  <div id="courses-list"></div>

  <!-- YAML modal -->
  <div class="modal-overlay" id="yaml-modal">
    <div class="modal-box">
      <div class="modal-head">
        <h3 id="yaml-title">CRD</h3>
        <button class="btn btn-ghost btn-sm" id="yaml-close">✕</button>
      </div>
      <div class="modal-body"><pre class="yaml" id="yaml-content"></pre></div>
      <div class="modal-foot">
        <button class="btn btn-secondary btn-sm" id="yaml-copy">Copier</button>
        <button class="btn btn-secondary btn-sm" id="yaml-close2">Fermer</button>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body !== undefined ? JSON.stringify(opts.body) : undefined,
      });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    // ── State ──
    let modDragSrcIdx: number | null = null;
    let moduleEditMode = false;
    let allCourses: any[] = [];
    let allGroups: any[] = [];
    let openId: string | null = null;
    let activeTab = 'modules';
    let panelModules: any[] | null = null;
    let panelEnrollments: any[] | null = null;
    let panelGroupEnrollments: any[] | null = null;
    let moduleDraft: any | null = null;
    let moduleDraftIdx: number | null = null;
    let moduleDraftCourseId: string | null = null;
    let editingSlug: string | null = null;
    let editingCourseId: string | null = null;
    let editingCourseSpec: any | null = null;
    const DIFF: Record<string, string> = { beginner: 'badge-green', intermediate: 'badge-orange', advanced: 'badge-red' };

    function escHtml(s: string) {
      return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Load ──
    async function load() {
      try {
        const [coursesRes, groupsRes] = await Promise.all([
          api('/admin/courses'),
          api('/admin/groups').catch(() => ({ groups: [] })),
        ]);
        allCourses = coursesRes.courses || [];
        allGroups = groupsRes.groups || [];
        document.getElementById('course-count')!.textContent = `${coursesRes.total ?? allCourses.length} cours`;
        document.getElementById('loading')!.style.display = 'none';
        render();
      } catch (e: any) {
        document.getElementById('loading')!.innerHTML = `<p style="color:var(--bad);padding:24px">${e.message}</p>`;
      }
    }

    // ── Render ──
    function render() {
      const search = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase();
      const courses = search
        ? allCourses.filter(c => c.title.toLowerCase().includes(search) || (c.category || '').toLowerCase().includes(search))
        : allCourses;
      const list = document.getElementById('courses-list')!;
      if (!courses.length) {
        list.innerHTML = `<div class="card" style="text-align:center;padding:40px;color:var(--ink-soft)">Aucun cours trouvé</div>`;
        return;
      }
      list.innerHTML = courses.map(c => renderCourseItem(c)).join('');
    }

    function renderCourseItem(c: any) {
      const isOpen = openId === c.id;
      const isEditing = editingCourseId === c.id;
      return `
        <div class="course-item${isEditing ? ' editing' : ''}" id="ci-${c.id}" data-id="${c.id}">
          <div class="course-header" data-toggle="${c.id}">
            <div class="course-info">
              <div class="course-title">${escHtml(c.title)}</div>
              <div class="course-meta">
                <span class="course-slug">${escHtml(c.id)}</span>
                ${c.difficulty ? `<span class="badge ${DIFF[c.difficulty] || 'badge-gray'}" style="font-size:.7rem">${c.difficulty}</span>` : ''}
                ${c.category ? `<span class="badge badge-blue" style="font-size:.7rem">${escHtml(c.category)}</span>` : ''}
                <span class="badge ${c.is_public ? 'badge-green' : 'badge-gray'}" style="font-size:.7rem">${c.is_public ? 'Public' : 'Privé'}</span>
              </div>
            </div>
            <div class="course-actions">
              <button class="link-btn violet" data-action="yaml" data-id="${c.id}" data-title="${escHtml(c.title)}">⎈ YAML</button>
              ${isEditing
                ? `<button class="link-btn gray" data-action="course-edit-cancel">Annuler</button>`
                : `<button class="link-btn gray" data-action="edit" data-id="${c.id}">Modifier</button>`}
              <button class="link-btn orange" data-action="cache" data-id="${c.id}">🗑 Cache</button>
              <button class="link-btn red" data-action="delete" data-id="${c.id}" data-title="${escHtml(c.title)}">Supprimer</button>
            </div>
            <svg class="chevron ${isOpen ? 'open' : ''}" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </div>
          ${isEditing ? renderCourseInlineEdit(c) : ''}
          ${isOpen ? renderPanel(c.id) : ''}
        </div>
      `;
    }

    function renderCourseInlineEdit(c: any) {
      const spec = editingCourseSpec || {};
      const title = spec.title ?? c.title ?? '';
      const desc = spec.description ?? '';
      const cat = spec.category ?? c.category ?? '';
      const diff = spec.difficulty ?? c.difficulty ?? 'beginner';
      const pub = spec.public !== undefined ? spec.public : !!c.is_public;
      return `
        <div class="course-inline-form">
          <p style="font-size:.78rem;font-weight:700;color:var(--blue);margin-bottom:14px">Modifier — ${escHtml(c.id)}</p>
          <div class="draft-grid">
            <div>
              <label class="label" style="font-size:.78rem">Slug</label>
              <input class="input" id="ce-slug" type="text" style="font-family:monospace;font-size:.82rem" value="${escHtml(c.id)}" disabled />
            </div>
            <div>
              <label class="label" style="font-size:.78rem">Titre <span style="color:var(--bad)">*</span></label>
              <input class="input" id="ce-title" type="text" value="${escHtml(title)}" placeholder="Introduction à Kubernetes" />
            </div>
          </div>
          <div style="margin-bottom:14px">
            <label class="label" style="font-size:.78rem">Description</label>
            <textarea class="input" id="ce-desc" rows="2" placeholder="Une courte description du cours…">${escHtml(desc)}</textarea>
          </div>
          <div class="draft-grid">
            <div>
              <label class="label" style="font-size:.78rem">Catégorie</label>
              <input class="input" id="ce-category" type="text" placeholder="DevOps" value="${escHtml(cat)}" />
            </div>
            <div>
              <label class="label" style="font-size:.78rem">Difficulté</label>
              <select class="input" id="ce-difficulty" style="font-size:.85rem">
                <option value="beginner" ${diff === 'beginner' ? 'selected' : ''}>Débutant</option>
                <option value="intermediate" ${diff === 'intermediate' ? 'selected' : ''}>Intermédiaire</option>
                <option value="advanced" ${diff === 'advanced' ? 'selected' : ''}>Avancé</option>
              </select>
            </div>
          </div>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:16px;font-size:.85rem">
            <input type="checkbox" id="ce-public" style="width:16px;height:16px;accent-color:var(--blue)" ${pub ? 'checked' : ''} />
            <span>Public <span class="text-soft" style="font-size:.8rem">(visible sans inscription)</span></span>
          </label>
          <div style="display:flex;gap:8px">
            <button class="btn btn-primary btn-sm" data-action="course-edit-save" data-course="${c.id}">Enregistrer</button>
            <button class="btn btn-secondary btn-sm" data-action="course-edit-cancel">Annuler</button>
          </div>
        </div>
      `;
    }

    function renderPanel(courseId: string) {
      const modCount = panelModules !== null ? panelModules.length : '…';
      const enrollCount = panelEnrollments !== null || panelGroupEnrollments !== null
        ? (panelEnrollments?.length || 0) + (panelGroupEnrollments?.length || 0)
        : '…';
      return `
        <div class="panel">
          <div class="tab-bar">
            <button class="tab-btn ${activeTab === 'modules' ? 'active' : ''}" data-tab="modules" data-course="${courseId}">
              Modules <span class="tab-count">${modCount}</span>
            </button>
            <button class="tab-btn ${activeTab === 'enrollments' ? 'active' : ''}" data-tab="enrollments" data-course="${courseId}">
              Inscriptions <span class="tab-count">${enrollCount}</span>
            </button>
          </div>
          <div class="tab-content">
            ${activeTab === 'modules' ? renderModulesTab(courseId) : renderEnrollmentsTab(courseId)}
          </div>
        </div>
      `;
    }

    function renderModFormFields(courseId: string): string {
      if (!moduleDraft) return '';
      return `
        <div class="mod-form-grid">
          <div>
            <label class="label" style="font-size:.78rem">Nom *</label>
            <input class="input" id="mf-name" type="text" style="font-size:.82rem" value="${escHtml(moduleDraft.name)}" placeholder="Introduction" />
          </div>
          <div>
            <label class="label" style="font-size:.78rem">Type</label>
            <select class="input" id="mf-type" style="font-size:.82rem">
              ${['text','video','image','quiz','modules'].map(t => `<option value="${t}" ${moduleDraft!.type === t ? 'selected' : ''}>${t}</option>`).join('')}
            </select>
          </div>
        </div>
        <div class="mod-form-grid">
          <div>
            <label class="label" style="font-size:.78rem">URL repo Git</label>
            <input class="input" id="mf-src" type="text" style="font-size:.78rem;font-family:monospace" value="${escHtml(moduleDraft.src || '')}" placeholder="https://github.com/org/repo" />
          </div>
          <div>
            <label class="label" style="font-size:.78rem">Branche / tag</label>
            <input class="input" id="mf-ref" type="text" style="font-size:.82rem;font-family:monospace" value="${escHtml(moduleDraft.ref || 'main')}" placeholder="main" />
          </div>
        </div>
        <div style="margin-bottom:10px">
          <label class="label" style="font-size:.78rem">Chemin dans le repo</label>
          <input class="input" id="mf-path" type="text" style="font-size:.78rem;font-family:monospace" value="${escHtml(moduleDraft.path || '')}" placeholder="modules/01-intro/index.md" />
        </div>
        <div id="mf-quizref-row" style="margin-bottom:10px;display:${moduleDraft.type === 'quiz' ? 'block' : 'none'}">
          <label class="label" style="font-size:.78rem">Quiz ref</label>
          <input class="input" id="mf-quizref" type="text" style="font-size:.78rem;font-family:monospace" value="${escHtml(moduleDraft.quiz_ref || '')}" placeholder="quizzes/01-intro.yaml" />
        </div>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;margin-bottom:8px;font-size:.82rem">
          <input type="checkbox" id="mf-hidden" ${moduleDraft.hidden ? 'checked' : ''} style="width:14px;height:14px;accent-color:var(--blue)" />
          Masqué <span class="text-soft" style="font-size:.75rem">(non visible par les étudiants)</span>
        </label>
        <div id="mf-inline-row" style="margin-bottom:12px;display:${moduleDraft.type === 'quiz' ? 'block' : 'none'}">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.82rem">
            <input type="checkbox" id="mf-inline" ${moduleDraft.inline ? 'checked' : ''} style="width:14px;height:14px;accent-color:var(--blue)" />
            Inline <span class="text-soft" style="font-size:.75rem">(mini-quiz affiché en bas du module précédent)</span>
          </label>
        </div>
        <div style="display:flex;gap:6px">
          <button class="btn btn-primary btn-sm" data-action="mf-save" data-course="${courseId}">${moduleDraftIdx !== null ? 'Enregistrer' : 'Ajouter'}</button>
          <button class="btn btn-secondary btn-sm" data-action="mf-cancel">Annuler</button>
        </div>
      `;
    }

    function renderModulesTab(courseId: string) {
      const showNewForm = moduleDraftCourseId === courseId && moduleDraft !== null && moduleDraftIdx === null;

      let modList = '';
      if (panelModules === null) {
        modList = '<div class="loading-state" style="padding:20px 0"><div class="spinner"></div></div>';
      } else if (!panelModules.length) {
        modList = '<p class="text-soft text-sm">Aucun module. Cliquez <strong>+ Ajouter</strong>.</p>';
      } else {
        modList = `<div class="stack-sm" id="mod-list-${courseId}">${panelModules.map((m, i) => {
          const isEditing = moduleDraftCourseId === courseId && moduleDraft !== null && moduleDraftIdx === m.index;
          return `
            <div>
              <div class="mod-item${isEditing ? ' editing' : ''}" data-mod-arr-idx="${i}" data-mod-course="${courseId}">
                ${moduleEditMode ? `<span class="mod-drag-handle" draggable="true" data-mod-arr-idx="${i}" data-mod-course="${courseId}" title="Glisser pour réordonner">⠿</span>` : ''}
                <span class="mod-idx">${m.index}</span>
                <div class="mod-info">
                  <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                    <span class="mod-name">${escHtml(m.name)}</span>
                    <span class="badge ${modTypeBadge(m.type)}" style="font-size:.7rem">${m.type}</span>
                    ${m.hidden ? `<span class="badge badge-red" style="font-size:.7rem">masqué</span>` : ''}
                    ${m.inline ? `<span class="badge badge-blue" style="font-size:.7rem">inline</span>` : ''}
                  </div>
                  ${m.path ? `<div style="font-size:.72rem;color:var(--ink-soft);margin-top:2px;font-family:monospace">${escHtml(m.path)}${m.src ? ` · ${escHtml(m.src)} @ ${escHtml(m.ref || 'main')}` : ''}</div>` : ''}
                </div>
                <div class="mod-actions">
                  ${m.src ? `<button class="link-btn gray" data-action="mod-cache" data-course="${courseId}" data-idx="${m.index}" title="Vider cache">🗑</button>` : ''}
                  <button class="link-btn gray" data-action="mod-edit" data-course="${courseId}" data-idx="${m.index}">Modifier</button>
                  <button class="link-btn red" data-action="mod-delete" data-course="${courseId}" data-idx="${m.index}" data-modname="${escHtml(m.name)}">Supprimer</button>
                </div>
              </div>
              ${isEditing ? `<div class="mod-inline-form">${renderModFormFields(courseId)}</div>` : ''}
            </div>
          `;
        }).join('')}</div>`;
      }

      const newFormHtml = showNewForm ? `
        <div class="mod-form">
          <p style="font-size:.78rem;font-weight:700;color:var(--blue);margin-bottom:10px">Nouveau module</p>
          ${renderModFormFields(courseId)}
        </div>
      ` : '';

      return `
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
          <button class="btn btn-sm ${moduleEditMode ? 'btn-primary' : 'btn-secondary'}" data-action="toggle-edit-mode" data-course="${courseId}" title="${moduleEditMode ? 'Désactiver le mode édition' : 'Activer le glisser-déposer pour réordonner'}">
            ${moduleEditMode ? '↕ Édition active' : '↕ Réordonner'}
          </button>
          <div style="display:flex;gap:6px">
            ${!showNewForm && !moduleEditMode ? `<button class="btn btn-primary btn-sm" data-action="mod-add" data-course="${courseId}">+ Ajouter</button>` : ''}
            <button class="btn btn-secondary btn-sm" data-action="course-cache" data-course="${courseId}">🗑 Cache</button>
          </div>
        </div>
        ${newFormHtml}
        ${modList}
      `;
    }

    function renderEnrollmentsTab(courseId: string) {
      if (panelEnrollments === null && panelGroupEnrollments === null) {
        return '<div class="loading-state" style="padding:20px 0"><div class="spinner"></div></div>';
      }
      const groups = panelGroupEnrollments || [];
      const users  = panelEnrollments || [];
      const availGroups = allGroups.filter((g: any) => !groups.some((ge: any) => ge.id === g.id));

      return `
        <div class="stack">
          <div>
            <p class="section-label">Groupes</p>
            ${groups.length ? `<div class="stack-sm" style="margin-bottom:10px">${groups.map((g: any) => `
              <div class="enroll-row">
                <span style="font-size:.875rem"><strong>${escHtml(g.name)}</strong>
                  <span class="text-soft text-sm" style="margin-left:6px">${g.member_count} membre${g.member_count !== 1 ? 's' : ''}</span>
                </span>
                <button class="link-btn red" data-action="unenroll-group" data-course="${courseId}" data-gid="${g.id}" data-gname="${escHtml(g.name)}">Retirer</button>
              </div>
            `).join('')}</div>` : ''}
            ${availGroups.length ? `
              <div class="flex-row">
                <select id="enroll-group-sel" class="input" style="flex:1;font-size:.85rem;height:auto;padding:8px 12px">
                  <option value="">— Ajouter un groupe —</option>
                  ${availGroups.map((g: any) => `<option value="${g.id}">${escHtml(g.name)} (${g.member_count} membres)</option>`).join('')}
                </select>
                <button class="btn btn-primary btn-sm" data-action="enroll-group" data-course="${courseId}">Ajouter</button>
              </div>
            ` : `<p class="text-soft text-sm">${allGroups.length ? 'Tous les groupes déjà inscrits.' : 'Aucun groupe disponible.'}</p>`}
          </div>
          <hr style="border:none;border-top:1px solid var(--line)" />
          <div>
            <p class="section-label">Utilisateurs individuels</p>
            <p class="text-soft text-sm" style="margin-bottom:8px">Trouver l'ID sur la page Utilisateurs.</p>
            <div class="flex-row" style="margin-bottom:12px">
              <input id="enroll-user-input" class="input" type="text" style="flex:1;font-family:monospace;font-size:.82rem" placeholder="UUID de l'utilisateur…" />
              <button class="btn btn-primary btn-sm" data-action="enroll-user" data-course="${courseId}">Inscrire</button>
            </div>
            ${!users.length ? '<p class="text-soft text-sm">Aucune inscription individuelle.</p>' : `
              <div class="stack-sm">${users.map((e: any) => `
                <div class="enroll-row">
                  <div>
                    <span style="font-weight:500;font-size:.875rem">${escHtml(e.username)}</span>
                    <span class="text-soft text-sm" style="margin-left:6px">${escHtml(e.email)}</span>
                  </div>
                  <div style="display:flex;align-items:center;gap:12px">
                    <span class="text-soft text-sm">${new Date(e.enrolled_at).toLocaleDateString('fr')}</span>
                    <button class="link-btn red" data-action="unenroll-user" data-course="${courseId}" data-uid="${e.user_id}" data-uname="${escHtml(e.username)}">Retirer</button>
                  </div>
                </div>
              `).join('')}</div>
            `}
          </div>
        </div>
      `;
    }

    function modTypeBadge(type: string) {
      const m: Record<string, string> = { text: 'badge-blue', video: 'badge-orange', quiz: 'badge-green', image: 'badge-gray', modules: 'badge-gray' };
      return m[type] || 'badge-gray';
    }

    // ── Drag-and-drop reordering (modules) ──
    const coursesList = document.getElementById('courses-list')!;

    coursesList.addEventListener('dragstart', (e: DragEvent) => {
      // draggable="true" is on the handle span itself
      const handle = (e.target as HTMLElement).closest<HTMLElement>('.mod-drag-handle');
      if (!handle) { e.preventDefault(); return; }
      modDragSrcIdx = parseInt(handle.dataset.modArrIdx!);
      handle.closest<HTMLElement>('.mod-item')?.classList.add('dragging');
      e.dataTransfer!.effectAllowed = 'move';
    });

    coursesList.addEventListener('dragend', () => {
      coursesList.querySelectorAll('.mod-item').forEach(el => el.classList.remove('dragging', 'drag-over'));
      modDragSrcIdx = null;
    });

    coursesList.addEventListener('dragenter', (e: DragEvent) => {
      if (modDragSrcIdx === null) return;
      e.preventDefault();
      const item = (e.target as HTMLElement).closest<HTMLElement>('.mod-item');
      coursesList.querySelectorAll('.mod-item.drag-over').forEach(el => el.classList.remove('drag-over'));
      if (item && parseInt(item.dataset.modArrIdx!) !== modDragSrcIdx) item.classList.add('drag-over');
    });

    coursesList.addEventListener('dragover', (e: DragEvent) => {
      if (modDragSrcIdx !== null) { e.preventDefault(); e.dataTransfer!.dropEffect = 'move'; }
    });

    coursesList.addEventListener('drop', async (e: DragEvent) => {
      if (modDragSrcIdx === null) return;
      e.preventDefault();
      const item = (e.target as HTMLElement).closest<HTMLElement>('.mod-item');
      if (!item) { modDragSrcIdx = null; return; }
      const srcIdx = modDragSrcIdx;
      const tgtIdx = parseInt(item.dataset.modArrIdx!);
      const courseId = item.dataset.modCourse || openId;
      modDragSrcIdx = null;
      if (tgtIdx === srcIdx || !courseId || !panelModules) return;

      // Optimistic reorder
      const mods = [...panelModules];
      const [moved] = mods.splice(srcIdx, 1);
      mods.splice(tgtIdx, 0, moved);
      panelModules = mods;
      render();

      try {
        const crd = await api(`/admin/courses/${courseId}/crd`);
        const spec = crd.spec as any;
        const crdMods = [...(spec.modules || [])];
        const [movedCrd] = crdMods.splice(srcIdx, 1);
        crdMods.splice(tgtIdx, 0, movedCrd);
        await api(`/admin/courses/${courseId}/crd`, { method: 'PUT', body: { spec: { ...spec, modules: crdMods } } });
        const res = await api(`/courses/${courseId}/modules`);
        panelModules = res.modules || [];
        render();
        (window as any).showToast?.('Ordre des modules mis à jour', 'success');
      } catch (err: any) {
        (window as any).showToast?.(err.message || 'Erreur lors du réordonnancement', 'error');
        try { const res = await api(`/courses/${courseId}/modules`); panelModules = res.modules || []; render(); } catch {}
      }
    });

    // ── Toggle quiz_ref field when type select changes ──
    document.getElementById('courses-list')!.addEventListener('change', (e: Event) => {
      const target = e.target as HTMLElement;
      if (target.id === 'mf-type') {
        const isQuiz = (target as HTMLSelectElement).value === 'quiz';
        const row = document.getElementById('mf-quizref-row');
        if (row) row.style.display = isQuiz ? 'block' : 'none';
        const inlineRow = document.getElementById('mf-inline-row');
        if (inlineRow) inlineRow.style.display = isQuiz ? 'block' : 'none';
      }
    });

    // ── Single event listener on #courses-list (set up once) ──
    document.getElementById('courses-list')!.addEventListener('click', async (e: MouseEvent) => {
      const target = e.target as HTMLElement;

      // Action buttons (data-action)
      const actionBtn = target.closest<HTMLElement>('[data-action]');
      if (actionBtn) {
        e.stopPropagation();
        const action = actionBtn.dataset.action!;
        const courseId = actionBtn.dataset.course || actionBtn.dataset.id || '';

        if      (action === 'yaml')             await openCourseYAML(actionBtn.dataset.id!, actionBtn.dataset.title!);
        else if (action === 'edit')             await startEditCourse(actionBtn.dataset.id!);
        else if (action === 'course-edit-save') await saveCourseEdit(courseId);
        else if (action === 'course-edit-cancel') { editingCourseId = null; editingCourseSpec = null; render(); }
        else if (action === 'delete')           await deleteCourse(actionBtn.dataset.id!, actionBtn.dataset.title!);
        else if (action === 'cache')            await clearCourseCache(actionBtn.dataset.id!);
        else if (action === 'course-cache')     await clearCourseCache(courseId);
        else if (action === 'mod-add')      { moduleDraft = { name:'',type:'text',src:'',ref:'main',path:'',hidden:false,inline:false,quiz_ref:'' }; moduleDraftIdx = null; moduleDraftCourseId = courseId; render(); }
        else if (action === 'mod-edit')     await startEditModule(courseId, parseInt(actionBtn.dataset.idx!));
        else if (action === 'mod-delete')   await deleteModule(courseId, parseInt(actionBtn.dataset.idx!), actionBtn.dataset.modname!);
        else if (action === 'mod-cache')    await clearModuleCache(courseId, parseInt(actionBtn.dataset.idx!));
        else if (action === 'mf-save')      await saveModuleDraft(courseId);
        else if (action === 'mf-cancel')    { moduleDraft = null; moduleDraftIdx = null; moduleDraftCourseId = null; render(); }
        else if (action === 'toggle-edit-mode') { moduleEditMode = !moduleEditMode; moduleDraft = null; moduleDraftIdx = null; moduleDraftCourseId = null; render(); }
        else if (action === 'enroll-group') await enrollGroup(courseId);
        else if (action === 'unenroll-group') await unenrollGroup(courseId, actionBtn.dataset.gid!, actionBtn.dataset.gname!);
        else if (action === 'enroll-user')  await enrollUser(courseId);
        else if (action === 'unenroll-user') await unenrollUser(courseId, actionBtn.dataset.uid!, actionBtn.dataset.uname!);
        return;
      }

      // Tab buttons
      const tabBtn = target.closest<HTMLElement>('[data-tab]');
      if (tabBtn) { await switchTab(tabBtn.dataset.tab!, tabBtn.dataset.course!); return; }

      // Accordion toggle — only fires when clicking the header row (not inner buttons)
      const header = target.closest<HTMLElement>('.course-header');
      if (header?.dataset.toggle) { await toggle(header.dataset.toggle); }
    });

    // ── Accordion toggle ──
    async function toggle(id: string) {
      if (openId === id) {
        openId = null;
        moduleEditMode = false;
        editingCourseId = null; editingCourseSpec = null;
        panelModules = null; panelEnrollments = null; panelGroupEnrollments = null;
        moduleDraft = null; moduleDraftIdx = null; moduleDraftCourseId = null;
        render();
        return;
      }
      // If clicking a different course while one is being edited, clear the edit state
      if (editingCourseId && editingCourseId !== id) { editingCourseId = null; editingCourseSpec = null; }
      openId = id;
      activeTab = 'modules';
      moduleEditMode = false;
      panelModules = null; panelEnrollments = null; panelGroupEnrollments = null;
      moduleDraft = null; moduleDraftIdx = null; moduleDraftCourseId = null;
      render(); // show loading state immediately
      try {
        const res = await api(`/courses/${id}/modules`);
        if (openId === id) { panelModules = res.modules || []; render(); }
      } catch { if (openId === id) { panelModules = []; render(); } }
    }

    async function switchTab(tab: string, courseId: string) {
      activeTab = tab;
      if (tab === 'enrollments' && panelEnrollments === null) {
        render(); // show loading
        try {
          const [uRes, gRes] = await Promise.all([
            api(`/admin/courses/${courseId}/enrollments`),
            api(`/admin/courses/${courseId}/enrollments/groups`).catch(() => ({ enrollments: [] })),
          ]);
          panelEnrollments = uRes.enrollments || [];
          panelGroupEnrollments = gRes.enrollments || [];
        } catch { panelEnrollments = []; panelGroupEnrollments = []; }
      }
      render();
    }

    // ── Module management ──
    async function startEditModule(courseId: string, idx: number) {
      const mod = panelModules?.find((m: any) => m.index === idx);
      if (!mod) return;
      moduleDraft = { name: mod.name, type: mod.type, src: mod.src || '', ref: mod.ref || 'main', path: mod.path || '', hidden: !!mod.hidden, inline: !!mod.inline, quiz_ref: mod.quiz_ref || '' };
      moduleDraftIdx = idx;
      moduleDraftCourseId = courseId;
      render();
    }

    async function saveModuleDraft(courseId: string) {
      const name = (document.getElementById('mf-name') as HTMLInputElement)?.value.trim() || '';
      const type = (document.getElementById('mf-type') as HTMLSelectElement)?.value || 'text';
      const src  = (document.getElementById('mf-src')  as HTMLInputElement)?.value.trim() || '';
      const ref  = (document.getElementById('mf-ref')  as HTMLInputElement)?.value.trim() || 'main';
      const path = (document.getElementById('mf-path') as HTMLInputElement)?.value.trim() || '';
      const hidden = (document.getElementById('mf-hidden') as HTMLInputElement)?.checked || false;
      const inline = (document.getElementById('mf-inline') as HTMLInputElement)?.checked || false;
      const quiz_ref = (document.getElementById('mf-quizref') as HTMLInputElement)?.value.trim() || '';
      if (!name) { (window as any).showToast?.('Le nom est requis', 'error'); return; }

      const saveBtn = document.querySelector<HTMLButtonElement>('[data-action="mf-save"]');
      if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Enregistrement…'; }

      try {
        const crd = await api(`/admin/courses/${courseId}/crd`);
        const spec = crd.spec as any;
        const mods: any[] = spec.modules ? [...spec.modules] : [];

        const isUpdate = moduleDraftIdx !== null;
        if (isUpdate) {
          // Preserve existing CRD fields not shown in the form (passing_score, cooldown, prerequisites, etc.)
          const existing = mods[moduleDraftIdx!] ?? {};
          const modSpec: any = { ...existing, name, type };
          if (src) modSpec.src = src; else delete modSpec.src;
          if (ref) modSpec.ref = ref; else delete modSpec.ref;
          if (path) modSpec.path = path; else delete modSpec.path;
          if (hidden) modSpec.hidden = true; else delete modSpec.hidden;
          if (inline && type === 'quiz') modSpec.inline = true; else delete modSpec.inline;
          if (quiz_ref && type === 'quiz') modSpec.quiz_ref = quiz_ref; else delete modSpec.quiz_ref;
          mods[moduleDraftIdx!] = modSpec;
        } else {
          const modSpec: any = { name, type };
          if (src) modSpec.src = src;
          if (ref) modSpec.ref = ref;
          if (path) modSpec.path = path;
          if (hidden) modSpec.hidden = true;
          if (inline && type === 'quiz') modSpec.inline = true;
          if (quiz_ref && type === 'quiz') modSpec.quiz_ref = quiz_ref;
          mods.push(modSpec);
        }
        await api(`/admin/courses/${courseId}/crd`, { method: 'PUT', body: { spec: { ...spec, modules: mods } } });
        (window as any).showToast?.(isUpdate ? 'Module mis à jour' : 'Module ajouté', 'success');
        // Optimistic update: immediately reflect the saved values in panelModules
        if (isUpdate && panelModules) {
          const savedInline = !!(inline && type === 'quiz');
          panelModules = panelModules.map((pm: any) =>
            pm.index === moduleDraftIdx
              ? { ...pm, name, type, src: src || pm.src || '', ref: ref || pm.ref || 'main', path: path || pm.path || '', hidden: !!hidden, inline: savedInline }
              : pm
          );
        }
        moduleDraft = null; moduleDraftIdx = null; moduleDraftCourseId = null;
        render();
        // Background sync after K8s watch propagates
        await new Promise(r => setTimeout(r, 800));
        const res = await api(`/courses/${courseId}/modules`);
        panelModules = res.modules || [];
        render();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = moduleDraftIdx !== null ? 'Enregistrer' : 'Ajouter'; }
      }
    }

    async function deleteModule(courseId: string, idx: number, name: string) {
      if (!confirm(`Supprimer le module "${name}" ?`)) return;
      try {
        const crd = await api(`/admin/courses/${courseId}/crd`);
        const spec = crd.spec as any;
        const mods = (spec.modules || []).filter((_: any, i: number) => i !== idx);
        await api(`/admin/courses/${courseId}/crd`, { method: 'PUT', body: { spec: { ...spec, modules: mods } } });
        (window as any).showToast?.(`Module "${name}" supprimé`, 'success');
        const res = await api(`/courses/${courseId}/modules`);
        panelModules = res.modules || [];
        render();
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    async function clearModuleCache(courseId: string, idx: number) {
      try {
        await api(`/admin/courses/${courseId}/modules/${idx}/cache/clear`, { method: 'POST' });
        (window as any).showToast?.('Cache module vidé', 'success');
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    // ── Enrollment management ──
    async function enrollGroup(courseId: string) {
      const sel = document.getElementById('enroll-group-sel') as HTMLSelectElement;
      if (!sel?.value) return;
      try {
        await api(`/admin/courses/${courseId}/enrollments/groups`, { method: 'POST', body: { group_id: sel.value } });
        (window as any).showToast?.('Groupe inscrit', 'success');
        await reloadEnrollments(courseId);
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    async function unenrollGroup(courseId: string, groupId: string, name: string) {
      try {
        await api(`/admin/courses/${courseId}/enrollments/groups/${groupId}`, { method: 'DELETE' });
        (window as any).showToast?.(`Groupe "${name}" retiré`, 'success');
        await reloadEnrollments(courseId);
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    async function enrollUser(courseId: string) {
      const input = document.getElementById('enroll-user-input') as HTMLInputElement;
      const uid = input?.value.trim();
      if (!uid) return;
      try {
        await api(`/admin/courses/${courseId}/enrollments`, { method: 'POST', body: { user_id: uid } });
        (window as any).showToast?.('Utilisateur inscrit', 'success');
        await reloadEnrollments(courseId);
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    async function unenrollUser(courseId: string, userId: string, name: string) {
      try {
        await api(`/admin/courses/${courseId}/enrollments/${userId}`, { method: 'DELETE' });
        (window as any).showToast?.(`"${name}" retiré`, 'success');
        await reloadEnrollments(courseId);
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    async function reloadEnrollments(courseId: string) {
      try {
        const [uRes, gRes] = await Promise.all([
          api(`/admin/courses/${courseId}/enrollments`),
          api(`/admin/courses/${courseId}/enrollments/groups`).catch(() => ({ enrollments: [] })),
        ]);
        panelEnrollments = uRes.enrollments || [];
        panelGroupEnrollments = gRes.enrollments || [];
      } catch { panelEnrollments = []; panelGroupEnrollments = []; }
      render();
    }

    // ── Cache ──
    async function clearCourseCache(slug: string) {
      try {
        await api(`/admin/courses/${slug}/cache/clear`, { method: 'POST' });
        (window as any).showToast?.(`Cache vidé pour ${slug}`, 'success');
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    document.getElementById('clear-all-cache')!.addEventListener('click', async () => {
      if (!confirm('Vider tout le cache Git ?')) return;
      try {
        await api('/admin/cache/clear', { method: 'POST' });
        (window as any).showToast?.('Cache global vidé', 'success');
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    });

    // ── Course CRD ──
    async function openCourseYAML(courseId: string, title: string) {
      try {
        const res = await api(`/admin/courses/${courseId}/crd`);
        const yaml = `# kubectl apply -f course.yaml\napiVersion: elearning.pupitre.io/v1\nkind: Course\nmetadata:\n  name: ${courseId}\n  namespace: default\nspec:\n${JSON.stringify(res.spec, null, 2).split('\n').map((l: string) => '  ' + l).join('\n')}`;
        (document.getElementById('yaml-title') as HTMLElement).textContent = `CRD — ${courseId}`;
        (document.getElementById('yaml-content') as HTMLElement).textContent = yaml;
        document.getElementById('yaml-modal')!.classList.add('open');
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    async function startEditCourse(courseId: string) {
      try {
        const res = await api(`/admin/courses/${courseId}/crd`);
        editingCourseId = courseId;
        editingCourseSpec = res.spec as any;
        render();
        document.getElementById(`ci-${courseId}`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    async function saveCourseEdit(courseId: string) {
      const title = (document.getElementById('ce-title') as HTMLInputElement)?.value.trim() || '';
      if (!title) { (window as any).showToast?.('Le titre est requis', 'error'); return; }

      const btn = document.querySelector<HTMLButtonElement>('[data-action="course-edit-save"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Enregistrement…'; }

      const desc = (document.getElementById('ce-desc') as HTMLTextAreaElement)?.value.trim() || '';
      const cat  = (document.getElementById('ce-category') as HTMLInputElement)?.value.trim() || '';
      const diff = (document.getElementById('ce-difficulty') as HTMLSelectElement)?.value || 'beginner';
      const pub  = (document.getElementById('ce-public') as HTMLInputElement)?.checked || false;

      try {
        const crd = await api(`/admin/courses/${courseId}/crd`);
        const existingSpec = crd.spec as any;
        const newSpec: any = { ...existingSpec, title, difficulty: diff, public: pub };
        if (desc) newSpec.description = desc; else delete newSpec.description;
        if (cat)  newSpec.category = cat;     else delete newSpec.category;

        await api(`/admin/courses/${courseId}/crd`, { method: 'PUT', body: { spec: newSpec } });
        (window as any).showToast?.(`Cours "${courseId}" mis à jour`, 'success');
        editingCourseId = null;
        editingCourseSpec = null;
        await load();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
        if (btn) { btn.disabled = false; btn.textContent = 'Enregistrer'; }
      }
    }

    async function deleteCourse(courseId: string, title: string) {
      if (!confirm(`Supprimer le cours "${title}" (${courseId}) ? Cela supprime le CRD du cluster.`)) return;
      try {
        await api(`/admin/courses/${courseId}/crd`, { method: 'DELETE' });
        allCourses = allCourses.filter(c => c.id !== courseId);
        if (openId === courseId) { openId = null; panelModules = null; panelEnrollments = null; panelGroupEnrollments = null; }
        (window as any).showToast?.(`Cours "${title}" supprimé`, 'success');
        render();
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    }

    // ── Draft form ──
    document.getElementById('new-course-btn')!.addEventListener('click', () => {
      editingSlug = null;
      (document.getElementById('draft-title') as HTMLElement).textContent = 'Nouveau cours';
      const slugEl = document.getElementById('d-slug') as HTMLInputElement;
      slugEl.value = ''; slugEl.disabled = false;
      (document.getElementById('d-title') as HTMLInputElement).value = '';
      (document.getElementById('d-desc') as HTMLTextAreaElement).value = '';
      (document.getElementById('d-category') as HTMLInputElement).value = '';
      (document.getElementById('d-difficulty') as HTMLSelectElement).value = 'beginner';
      (document.getElementById('d-public') as HTMLInputElement).checked = false;
      (document.getElementById('draft-save') as HTMLButtonElement).textContent = 'Créer le cours';
      document.getElementById('draft-panel')!.style.display = 'block';
      document.getElementById('d-title')!.focus();
    });

    document.getElementById('draft-cancel')!.addEventListener('click', () => {
      document.getElementById('draft-panel')!.style.display = 'none';
      editingSlug = null;
    });

    document.getElementById('d-slug')!.addEventListener('input', () => {
      const val = (document.getElementById('d-slug') as HTMLInputElement).value;
      document.getElementById('slug-warn')!.style.display = (val && !/^[a-z0-9-]+$/.test(val)) ? 'block' : 'none';
    });

    document.getElementById('draft-save')!.addEventListener('click', async () => {
      const slug = (document.getElementById('d-slug') as HTMLInputElement).value.trim();
      const title = (document.getElementById('d-title') as HTMLInputElement).value.trim();
      if (!title) { (window as any).showToast?.('Le titre est requis', 'error'); return; }
      if (!editingSlug && (!slug || !/^[a-z0-9-]+$/.test(slug))) { (window as any).showToast?.('Slug invalide', 'error'); return; }

      const btn = document.getElementById('draft-save') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Enregistrement…';

      const spec: any = { title };
      const desc = (document.getElementById('d-desc') as HTMLTextAreaElement).value.trim();
      const cat  = (document.getElementById('d-category') as HTMLInputElement).value.trim();
      const diff = (document.getElementById('d-difficulty') as HTMLSelectElement).value;
      if (desc) spec.description = desc;
      if (cat)  spec.category = cat;
      if (diff) spec.difficulty = diff;
      spec.public = (document.getElementById('d-public') as HTMLInputElement).checked;

      try {
        if (editingSlug) {
          await api(`/admin/courses/${editingSlug}/crd`, { method: 'PUT', body: { spec } });
          (window as any).showToast?.(`Cours "${editingSlug}" mis à jour`, 'success');
        } else {
          await api('/admin/courses', { method: 'POST', body: { slug, spec } });
          (window as any).showToast?.(`Cours "${slug}" créé`, 'success');
        }
        document.getElementById('draft-panel')!.style.display = 'none';
        editingSlug = null;
        await load();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
        btn.disabled = false;
        btn.textContent = editingSlug ? 'Enregistrer' : 'Créer le cours';
      }
    });

    // ── YAML modal ──
    document.getElementById('yaml-close')!.addEventListener('click', () => document.getElementById('yaml-modal')!.classList.remove('open'));
    document.getElementById('yaml-close2')!.addEventListener('click', () => document.getElementById('yaml-modal')!.classList.remove('open'));
    document.getElementById('yaml-modal')!.addEventListener('click', e => {
      if (e.target === document.getElementById('yaml-modal')) document.getElementById('yaml-modal')!.classList.remove('open');
    });
    document.getElementById('yaml-copy')!.addEventListener('click', () => {
      navigator.clipboard.writeText((document.getElementById('yaml-content') as HTMLElement).textContent || '')
        .then(() => (window as any).showToast?.('Copié', 'success'));
    });

    // ── Search ──
    document.getElementById('search-input')!.addEventListener('input', render);

    load();
  </script>
</Admin>
