---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Parcours">
  <div class="admin-page-header">
    <div>
      <h1 class="text-2xl">Parcours</h1>
      <p class="text-soft text-sm mt-1" id="page-sub">Chargement…</p>
    </div>
    <div class="flex gap-2" id="header-actions">
      <button class="btn btn-primary btn-sm" id="new-path-btn">+ Nouveau parcours</button>
    </div>
  </div>

  <div class="tab-bar !px-0 mb-5">
    <button class="tab-btn active" data-view="paths">Parcours <span class="tab-count" id="tab-paths-count">…</span></button>
    <button class="tab-btn" data-view="enrollments">Inscriptions</button>
  </div>

  <!-- ── Definitions view ─────────────────────────────────────────────── -->
  <section id="view-paths">
    <!-- Path draft form -->
    <div id="draft-panel" class="draft-panel" style="display:none">
      <h3 class="mb-4">Nouveau parcours</h3>
      <div class="draft-grid">
        <div>
          <label class="label" for="d-slug">Slug <span class="text-bad">*</span></label>
          <input class="input font-mono" id="d-slug" type="text" placeholder="mon-parcours" />
          <p class="slug-warn" id="slug-warn" style="display:none">Lettres minuscules, chiffres et tirets uniquement.</p>
        </div>
        <div>
          <label class="label" for="d-title">Titre <span class="text-bad">*</span></label>
          <input class="input" id="d-title" type="text" placeholder="Parcours DevOps" />
        </div>
      </div>
      <div class="mb-3.5">
        <label class="label" for="d-desc">Description</label>
        <textarea class="input" id="d-desc" rows="2" placeholder="Une courte description du parcours…"></textarea>
      </div>
      <div class="draft-grid">
        <div>
          <label class="label" for="d-kind">Type</label>
          <select class="input" id="d-kind">
            <option value="course">Suite de cours</option>
            <option value="skill">Suite de compétences</option>
          </select>
          <p class="label-hint">Un parcours de cours débloque ses cours dans l'ordre ; un parcours de compétences enchaîne des compétences.</p>
        </div>
        <div>
          <label class="label" for="d-level">Niveau</label>
          <select class="input" id="d-level">
            <option value="">— Aucun —</option>
            <option value="beginner">Débutant</option>
            <option value="intermediate">Intermédiaire</option>
            <option value="advanced">Avancé</option>
          </select>
        </div>
      </div>
      <div class="flex gap-2">
        <button class="btn btn-primary btn-sm" id="draft-save">Créer le parcours</button>
        <button class="btn btn-secondary btn-sm" id="draft-cancel">Annuler</button>
      </div>
    </div>

    <div class="mb-4">
      <input id="search-input" class="input w-full max-w-[300px]" placeholder="Rechercher un parcours…" />
    </div>

    <div id="paths-loading" class="loading-state"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div>
    <div id="paths-list"></div>
  </section>

  <!-- ── Enrollments view ─────────────────────────────────────────────── -->
  <section id="view-enrollments" style="display:none">
    <div class="flex items-center gap-3 mb-5 flex-wrap">
      <label class="label m-0 whitespace-nowrap" for="path-select">Parcours :</label>
      <select id="path-select" class="input w-auto min-w-[220px]">
        <option value="">Chargement…</option>
      </select>
      <span class="text-soft text-sm" id="enroll-count"></span>
    </div>

    <div id="enroll-form" class="card mb-5 !px-5 !py-4" style="display:none">
      <div class="flex-row-gap3-wrap">
        <select id="user-select" class="input flex-1 min-w-[200px]">
          <option value="">Sélectionner un utilisateur…</option>
        </select>
        <button id="enroll-btn" class="btn btn-primary btn-sm">Inscrire</button>
      </div>
    </div>

    <div class="card !p-0 overflow-x-auto">
      <table class="admin-table" id="enrollments-table">
        <thead>
          <tr class="admin-tr-head">
            <th class="admin-th">Utilisateur</th>
            <th class="admin-th">Progression</th>
            <th class="admin-th">Inscrit le</th>
            <th class="admin-th-right">Actions</th>
          </tr>
        </thead>
        <tbody id="enrollments-body">
          <tr><td colspan="4" class="p-8 text-center text-soft">Sélectionnez un parcours</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Definition modal -->
  <div class="modal-overlay" id="def-modal">
    <div class="modal-box">
      <div class="modal-head">
        <h3 id="def-title">Définition</h3>
        <button class="btn btn-ghost btn-sm" id="def-close">✕</button>
      </div>
      <div class="modal-body"><pre class="yaml" id="def-content"></pre></div>
      <div class="modal-foot">
        <button class="btn btn-secondary btn-sm" id="def-copy">Copier</button>
        <button class="btn btn-secondary btn-sm" id="def-close2">Fermer</button>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body !== undefined ? JSON.stringify(opts.body) : undefined,
      });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    function escHtml(s: string) {
      return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function toast(msg: string, kind: 'success' | 'error' = 'success') {
      (window as any).showToast?.(msg, kind);
    }

    const KIND_SKILL = 'skill';
    const LEVEL_BADGE: Record<string, string> = { beginner: 'badge-green', intermediate: 'badge-orange', advanced: 'badge-red' };
    const LEVEL_LABEL: Record<string, string> = { beginner: 'débutant', intermediate: 'intermédiaire', advanced: 'avancé' };

    type PathSpec = {
      title: string; description: string; kind: string; level: string;
      courses: string[]; skills: string[];
    };

    // ── State ──
    let allPaths: any[] = [];
    let allCourses: any[] = [];
    let knownSkills: string[] = [];
    // The path whose editor is expanded, and the working copy of its spec.
    // The draft is the source of truth while the editor is open: every
    // member mutation re-renders, so text inputs are read back into it
    // first (syncDraft) rather than being read only at save time.
    let openSlug: string | null = null;
    let draft: PathSpec | null = null;
    let dragSrcIdx: number | null = null;

    // ── Loading ──
    async function loadPaths() {
      const [pathsRes, coursesRes] = await Promise.all([
        api('/paths'),
        api('/admin/courses').catch(() => ({ courses: [] })),
      ]);
      allPaths = pathsRes.paths ?? [];
      allCourses = coursesRes.courses ?? [];
      knownSkills = [...new Set(allCourses.flatMap((c: any) => c.skills ?? []))].sort() as string[];
      document.getElementById('page-sub')!.textContent =
        `${allPaths.length} parcours · ${allCourses.length} cours disponibles`;
      document.getElementById('tab-paths-count')!.textContent = String(allPaths.length);
      document.getElementById('paths-loading')!.style.display = 'none';
      renderPaths();
      fillPathSelect();
    }

    // ── Path list ──
    function renderPaths() {
      const search = (document.getElementById('search-input') as HTMLInputElement).value.trim().toLowerCase();
      const shown = search
        ? allPaths.filter(p => `${p.title} ${p.slug} ${p.description ?? ''}`.toLowerCase().includes(search))
        : allPaths;
      const list = document.getElementById('paths-list')!;
      if (!shown.length) {
        list.innerHTML = `<div class="card text-center p-10 text-ink-soft">${
          allPaths.length ? 'Aucun parcours trouvé' : 'Aucun parcours. Cliquez <strong>+ Nouveau parcours</strong>.'
        }</div>`;
        return;
      }
      list.innerHTML = shown.map(renderPathItem).join('');
    }

    function renderPathItem(p: any) {
      const isOpen = openSlug === p.slug;
      const isSkill = p.kind === KIND_SKILL;
      const count = (isSkill ? p.skills : p.courses)?.length ?? 0;
      const unit = isSkill
        ? `${count} compétence${count > 1 ? 's' : ''}`
        : `${count} cours`;
      return `
        <div class="course-item${isOpen ? ' editing' : ''}" id="pi-${escHtml(p.slug)}">
          <div class="course-header" data-toggle="${escHtml(p.slug)}">
            <div class="course-info">
              <div class="course-title">${escHtml(p.title)}</div>
              <div class="course-meta">
                <span class="course-slug">${escHtml(p.slug)}</span>
                <span class="badge ${isSkill ? 'badge-purple' : 'badge-blue'} text-[.7rem]">${isSkill ? 'compétences' : 'cours'}</span>
                ${p.level ? `<span class="badge ${LEVEL_BADGE[p.level] || 'badge-gray'} text-[.7rem]">${escHtml(LEVEL_LABEL[p.level] || p.level)}</span>` : ''}
                <span class="text-soft text-[.72rem]">${unit}</span>
              </div>
            </div>
            <div class="course-actions">
              <button class="link-btn violet" data-action="definition" data-slug="${escHtml(p.slug)}">⎈ Définition</button>
              <button class="link-btn gray" data-action="edit" data-slug="${escHtml(p.slug)}">${isOpen ? 'Fermer' : 'Modifier'}</button>
              <button class="link-btn red" data-action="delete" data-slug="${escHtml(p.slug)}" data-title="${escHtml(p.title)}">Supprimer</button>
            </div>
            <svg class="chevron ${isOpen ? 'open' : ''}" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </div>
          ${isOpen ? renderEditor(p.slug) : ''}
        </div>
      `;
    }

    // ── Editor ──
    function renderEditor(slug: string) {
      if (!draft) return `<div class="panel"><div class="tab-content"><div class="loading-state !p-0"><div class="spinner"></div></div></div></div>`;
      const isSkill = draft.kind === KIND_SKILL;
      return `
        <div class="course-inline-form">
          <div class="draft-grid">
            <div>
              <label class="label text-[.78rem]" for="pe-slug">Slug</label>
              <input class="input font-mono text-[.82rem]" id="pe-slug" type="text" value="${escHtml(slug)}" disabled />
            </div>
            <div>
              <label class="label text-[.78rem]" for="pe-title">Titre <span class="text-bad">*</span></label>
              <input class="input" id="pe-title" type="text" value="${escHtml(draft.title)}" placeholder="Parcours DevOps" />
            </div>
          </div>
          <div class="mb-3.5">
            <label class="label text-[.78rem]" for="pe-desc">Description</label>
            <textarea class="input" id="pe-desc" rows="2" placeholder="Une courte description du parcours…">${escHtml(draft.description)}</textarea>
          </div>
          <div class="draft-grid">
            <div>
              <label class="label text-[.78rem]" for="pe-kind">Type</label>
              <select class="input text-[.85rem]" id="pe-kind">
                <option value="course" ${!isSkill ? 'selected' : ''}>Suite de cours</option>
                <option value="skill" ${isSkill ? 'selected' : ''}>Suite de compétences</option>
              </select>
            </div>
            <div>
              <label class="label text-[.78rem]" for="pe-level">Niveau</label>
              <select class="input text-[.85rem]" id="pe-level">
                <option value="" ${!draft.level ? 'selected' : ''}>— Aucun —</option>
                <option value="beginner" ${draft.level === 'beginner' ? 'selected' : ''}>Débutant</option>
                <option value="intermediate" ${draft.level === 'intermediate' ? 'selected' : ''}>Intermédiaire</option>
                <option value="advanced" ${draft.level === 'advanced' ? 'selected' : ''}>Avancé</option>
              </select>
            </div>
          </div>

          <p class="section-label">${isSkill ? 'Compétences' : 'Cours'} — dans l'ordre de progression</p>
          ${renderMembers(slug)}
          ${renderAddMember(slug)}

          <div class="flex gap-2 mt-4">
            <button class="btn btn-primary btn-sm" data-action="save" data-slug="${escHtml(slug)}">Enregistrer</button>
            <button class="btn btn-secondary btn-sm" data-action="close">Annuler</button>
          </div>
        </div>
      `;
    }

    function members(spec: PathSpec): string[] {
      return spec.kind === KIND_SKILL ? spec.skills : spec.courses;
    }

    function setMembers(spec: PathSpec, next: string[]) {
      if (spec.kind === KIND_SKILL) spec.skills = next; else spec.courses = next;
    }

    function renderMembers(slug: string) {
      const list = members(draft!);
      if (!list.length) {
        return `<p class="text-soft text-sm mb-3">Aucun élément. Ajoutez-en un ci-dessous.</p>`;
      }
      const isSkill = draft!.kind === KIND_SKILL;
      return `<div class="stack-sm mb-3" id="member-list">${list.map((member, i) => {
        const course = isSkill ? null : allCourses.find((c: any) => c.id === member);
        const missing = isSkill ? !knownSkills.includes(member) : !course;
        return `
          <div class="mod-item" data-member-idx="${i}">
            <span class="mod-drag-handle" draggable="true" data-member-idx="${i}" title="Glisser pour réordonner">⠿</span>
            <span class="mod-idx">${i + 1}</span>
            <div class="mod-info">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="mod-name">${escHtml(course ? course.title : member)}</span>
                ${missing ? `<span class="badge badge-red text-[.7rem]" title="${isSkill ? 'Aucun module ne porte cette compétence' : 'Ce cours n’existe pas'}">${isSkill ? 'inutilisée' : 'introuvable'}</span>` : ''}
              </div>
              ${course ? `<div class="text-[.72rem] text-ink-soft mt-0.5 font-mono">${escHtml(member)}</div>` : ''}
            </div>
            <div class="mod-actions">
              <button class="link-btn red" data-action="member-remove" data-slug="${escHtml(slug)}" data-idx="${i}">Retirer</button>
            </div>
          </div>
        `;
      }).join('')}</div>`;
    }

    function renderAddMember(slug: string) {
      if (draft!.kind === KIND_SKILL) {
        const taken = new Set(draft!.skills);
        return `
          <div class="flex-row">
            <input class="input text-[.85rem] flex-1" id="member-add-skill" list="skill-options" placeholder="Nom de la compétence…" />
            <datalist id="skill-options">
              ${knownSkills.filter(s => !taken.has(s)).map(s => `<option value="${escHtml(s)}"></option>`).join('')}
            </datalist>
            <button class="btn btn-primary btn-sm" data-action="member-add" data-slug="${escHtml(slug)}">Ajouter</button>
          </div>
        `;
      }
      const taken = new Set(draft!.courses);
      const available = allCourses.filter((c: any) => !taken.has(c.id));
      if (!available.length) {
        return `<p class="text-soft text-sm">${allCourses.length ? 'Tous les cours sont déjà dans ce parcours.' : 'Aucun cours disponible.'}</p>`;
      }
      return `
        <div class="flex-row">
          <select class="input text-[.85rem] flex-1" id="member-add-course">
            <option value="">— Ajouter un cours —</option>
            ${available.map((c: any) => `<option value="${escHtml(c.id)}">${escHtml(c.title)} (${escHtml(c.id)})</option>`).join('')}
          </select>
          <button class="btn btn-primary btn-sm" data-action="member-add" data-slug="${escHtml(slug)}">Ajouter</button>
        </div>
      `;
    }

    // Reads the editor's text inputs back into the draft, so a re-render
    // triggered by a member change does not discard unsaved metadata.
    function syncDraft() {
      if (!draft) return;
      const title = document.getElementById('pe-title') as HTMLInputElement | null;
      const desc  = document.getElementById('pe-desc') as HTMLTextAreaElement | null;
      const kind  = document.getElementById('pe-kind') as HTMLSelectElement | null;
      const level = document.getElementById('pe-level') as HTMLSelectElement | null;
      if (title) draft.title = title.value;
      if (desc)  draft.description = desc.value;
      if (kind)  draft.kind = kind.value;
      if (level) draft.level = level.value;
    }

    async function openEditor(slug: string) {
      if (openSlug === slug) { closeEditor(); return; }
      openSlug = slug;
      draft = null;
      renderPaths(); // show the loading state inside the expanded row
      try {
        const res = await api(`/admin/courses/paths/${slug}/definition`);
        if (openSlug !== slug) return;
        const spec = res.spec ?? {};
        draft = {
          title: spec.title ?? '',
          description: spec.description ?? '',
          kind: spec.kind === KIND_SKILL ? KIND_SKILL : 'course',
          level: spec.level ?? '',
          courses: [...(spec.courses ?? [])],
          skills: [...(spec.skills ?? [])],
        };
        renderPaths();
        document.getElementById(`pi-${slug}`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (e: any) {
        toast(e.message || 'Impossible de charger le parcours', 'error');
        closeEditor();
      }
    }

    function closeEditor() {
      openSlug = null;
      draft = null;
      renderPaths();
    }

    async function savePath(slug: string) {
      syncDraft();
      if (!draft) return;
      if (!draft.title.trim()) { toast('Le titre est requis', 'error'); return; }

      const btn = document.querySelector<HTMLButtonElement>('[data-action="save"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Enregistrement…'; }

      // Only the members matching the path's kind are stored: switching a
      // path from courses to skills must not leave the other list behind
      // for the next reader to pick up.
      const isSkill = draft.kind === KIND_SKILL;
      const spec: any = { title: draft.title.trim(), kind: draft.kind };
      if (draft.description.trim()) spec.description = draft.description.trim();
      if (draft.level) spec.level = draft.level;
      if (isSkill) spec.skills = draft.skills; else spec.courses = draft.courses;

      try {
        await api(`/admin/courses/paths/${slug}/definition`, { method: 'PUT', body: { spec } });
        toast(`Parcours « ${slug} » mis à jour`);
        openSlug = null;
        draft = null;
        await loadPaths();
      } catch (e: any) {
        toast(e.message || 'Erreur', 'error');
        if (btn) { btn.disabled = false; btn.textContent = 'Enregistrer'; }
      }
    }

    async function deletePath(slug: string, title: string) {
      if (!confirm(`Supprimer le parcours « ${title} » (${slug}) ? Les inscriptions à ce parcours seront perdues.`)) return;
      try {
        await api(`/admin/courses/paths/${slug}/definition`, { method: 'DELETE' });
        toast(`Parcours « ${title} » supprimé`);
        if (openSlug === slug) { openSlug = null; draft = null; }
        await loadPaths();
      } catch (e: any) { toast(e.message || 'Erreur', 'error'); }
    }

    async function showDefinition(slug: string) {
      try {
        const res = await api(`/admin/courses/paths/${slug}/definition`);
        document.getElementById('def-title')!.textContent = `Définition — ${slug}`;
        document.getElementById('def-content')!.textContent = JSON.stringify({ slug, spec: res.spec }, null, 2);
        document.getElementById('def-modal')!.classList.add('open');
      } catch (e: any) { toast(e.message || 'Erreur', 'error'); }
    }

    // ── List interactions ──
    const pathsList = document.getElementById('paths-list')!;

    pathsList.addEventListener('click', async (e: MouseEvent) => {
      const target = e.target as HTMLElement;

      const actionBtn = target.closest<HTMLElement>('[data-action]');
      if (actionBtn) {
        e.stopPropagation();
        const action = actionBtn.dataset.action!;
        const slug = actionBtn.dataset.slug || '';
        if      (action === 'definition')    await showDefinition(slug);
        else if (action === 'edit')          await openEditor(slug);
        else if (action === 'delete')        await deletePath(slug, actionBtn.dataset.title || slug);
        else if (action === 'close')         closeEditor();
        else if (action === 'save')          await savePath(slug);
        else if (action === 'member-add')    addMember();
        else if (action === 'member-remove') removeMember(parseInt(actionBtn.dataset.idx!, 10));
        return;
      }

      const header = target.closest<HTMLElement>('.course-header');
      if (header?.dataset.toggle) await openEditor(header.dataset.toggle);
    });

    // Switching the kind swaps which member list is being edited, so the
    // editor has to redraw — after saving the other fields.
    pathsList.addEventListener('change', (e: Event) => {
      if ((e.target as HTMLElement).id === 'pe-kind') { syncDraft(); renderPaths(); }
    });

    function addMember() {
      if (!draft) return;
      syncDraft();
      const isSkill = draft.kind === KIND_SKILL;
      const input = document.getElementById(isSkill ? 'member-add-skill' : 'member-add-course') as HTMLInputElement | HTMLSelectElement | null;
      const value = (input?.value ?? '').trim();
      if (!value) { toast(isSkill ? 'Saisissez une compétence' : 'Sélectionnez un cours', 'error'); return; }
      const list = members(draft);
      if (list.includes(value)) { toast('Déjà présent dans ce parcours', 'error'); return; }
      setMembers(draft, [...list, value]);
      renderPaths();
    }

    function removeMember(idx: number) {
      if (!draft) return;
      syncDraft();
      setMembers(draft, members(draft).filter((_, i) => i !== idx));
      renderPaths();
    }

    // ── Drag-and-drop reordering of members ──
    pathsList.addEventListener('dragstart', (e: DragEvent) => {
      const handle = (e.target as HTMLElement).closest<HTMLElement>('.mod-drag-handle');
      if (!handle) { e.preventDefault(); return; }
      dragSrcIdx = parseInt(handle.dataset.memberIdx!, 10);
      handle.closest<HTMLElement>('.mod-item')?.classList.add('dragging');
      e.dataTransfer!.effectAllowed = 'move';
    });

    pathsList.addEventListener('dragend', () => {
      pathsList.querySelectorAll('.mod-item').forEach(el => el.classList.remove('dragging', 'drag-over'));
      dragSrcIdx = null;
    });

    pathsList.addEventListener('dragenter', (e: DragEvent) => {
      if (dragSrcIdx === null) return;
      e.preventDefault();
      pathsList.querySelectorAll('.mod-item.drag-over').forEach(el => el.classList.remove('drag-over'));
      const item = (e.target as HTMLElement).closest<HTMLElement>('.mod-item');
      if (item && parseInt(item.dataset.memberIdx!, 10) !== dragSrcIdx) item.classList.add('drag-over');
    });

    pathsList.addEventListener('dragover', (e: DragEvent) => {
      if (dragSrcIdx !== null) { e.preventDefault(); e.dataTransfer!.dropEffect = 'move'; }
    });

    pathsList.addEventListener('drop', (e: DragEvent) => {
      if (dragSrcIdx === null || !draft) return;
      e.preventDefault();
      const item = (e.target as HTMLElement).closest<HTMLElement>('.mod-item');
      const srcIdx = dragSrcIdx;
      dragSrcIdx = null;
      if (!item) return;
      const tgtIdx = parseInt(item.dataset.memberIdx!, 10);
      if (tgtIdx === srcIdx) return;
      syncDraft();
      const next = [...members(draft)];
      const [moved] = next.splice(srcIdx, 1);
      next.splice(tgtIdx, 0, moved);
      setMembers(draft, next);
      renderPaths();
    });

    document.getElementById('search-input')!.addEventListener('input', renderPaths);

    // ── Create ──
    const draftPanel = document.getElementById('draft-panel')!;

    document.getElementById('new-path-btn')!.addEventListener('click', () => {
      (document.getElementById('d-slug') as HTMLInputElement).value = '';
      (document.getElementById('d-title') as HTMLInputElement).value = '';
      (document.getElementById('d-desc') as HTMLTextAreaElement).value = '';
      (document.getElementById('d-kind') as HTMLSelectElement).value = 'course';
      (document.getElementById('d-level') as HTMLSelectElement).value = '';
      document.getElementById('slug-warn')!.style.display = 'none';
      draftPanel.style.display = 'block';
      document.getElementById('d-title')!.focus();
    });

    document.getElementById('draft-cancel')!.addEventListener('click', () => { draftPanel.style.display = 'none'; });

    document.getElementById('d-slug')!.addEventListener('input', () => {
      const val = (document.getElementById('d-slug') as HTMLInputElement).value;
      document.getElementById('slug-warn')!.style.display = (val && !/^[a-z0-9][a-z0-9-]*$/.test(val)) ? 'block' : 'none';
    });

    document.getElementById('draft-save')!.addEventListener('click', async () => {
      const slug  = (document.getElementById('d-slug') as HTMLInputElement).value.trim();
      const title = (document.getElementById('d-title') as HTMLInputElement).value.trim();
      const desc  = (document.getElementById('d-desc') as HTMLTextAreaElement).value.trim();
      const kind  = (document.getElementById('d-kind') as HTMLSelectElement).value;
      const level = (document.getElementById('d-level') as HTMLSelectElement).value;
      if (!title) { toast('Le titre est requis', 'error'); return; }
      if (!/^[a-z0-9][a-z0-9-]*$/.test(slug)) { toast('Slug invalide', 'error'); return; }

      const btn = document.getElementById('draft-save') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Enregistrement…';

      const spec: any = { title, kind };
      if (desc) spec.description = desc;
      if (level) spec.level = level;

      try {
        await api('/admin/courses/paths', { method: 'POST', body: { slug, spec } });
        toast(`Parcours « ${slug} » créé`);
        draftPanel.style.display = 'none';
        await loadPaths();
        // Open the new path straight away: an empty path is not useful until
        // its members are set, and that editor is one expand away.
        await openEditor(slug);
      } catch (e: any) {
        toast(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Créer le parcours';
      }
    });

    // ── Definition modal ──
    function closeDefModal() { document.getElementById('def-modal')!.classList.remove('open'); }
    document.getElementById('def-close')!.addEventListener('click', closeDefModal);
    document.getElementById('def-close2')!.addEventListener('click', closeDefModal);
    document.getElementById('def-copy')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(document.getElementById('def-content')!.textContent || '');
        toast('Définition copiée');
      } catch { toast('Copie impossible', 'error'); }
    });

    // ── View switching ──
    let enrollmentsLoaded = false;

    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const view = btn.dataset.view!;
        document.querySelectorAll('[data-view]').forEach(b => b.classList.toggle('active', b === btn));
        document.getElementById('view-paths')!.style.display = view === 'paths' ? 'block' : 'none';
        document.getElementById('view-enrollments')!.style.display = view === 'enrollments' ? 'block' : 'none';
        document.getElementById('header-actions')!.style.display = view === 'paths' ? 'flex' : 'none';
        if (view === 'enrollments' && !enrollmentsLoaded) {
          enrollmentsLoaded = true;
          await loadUsers().catch((e: any) => toast(e.message || 'Erreur', 'error'));
        }
      });
    });

    // ── Enrollments ──
    let currentSlug = '';

    function fillPathSelect() {
      const select = document.getElementById('path-select') as HTMLSelectElement;
      const previous = currentSlug;
      select.innerHTML = allPaths.length
        ? `<option value="">— Choisir un parcours —</option>` +
          allPaths.map((p: any) => `<option value="${escHtml(p.slug)}">${escHtml(p.title)}</option>`).join('')
        : `<option value="">Aucun parcours disponible</option>`;
      if (previous && allPaths.some((p: any) => p.slug === previous)) select.value = previous;
      else if (previous) resetEnrollments();
    }

    function resetEnrollments() {
      currentSlug = '';
      document.getElementById('enroll-form')!.style.display = 'none';
      document.getElementById('enroll-count')!.textContent = '';
      document.getElementById('enrollments-body')!.innerHTML =
        `<tr><td colspan="4" class="p-8 text-center text-soft">Sélectionnez un parcours</td></tr>`;
    }

    async function loadUsers() {
      const data = await api('/admin/users') as { users: any[] };
      const sel = document.getElementById('user-select') as HTMLSelectElement;
      sel.innerHTML = `<option value="">Sélectionner un utilisateur…</option>` +
        (data.users ?? []).map((u: any) => `<option value="${u.id}">${escHtml(u.username)} (${escHtml(u.email)})</option>`).join('');
    }

    async function loadEnrollments(slug: string) {
      const tbody = document.getElementById('enrollments-body')!;
      tbody.innerHTML = `<tr><td colspan="4" class="p-8 text-center"><div class="loading-state !p-0"><div class="spinner"></div></div></td></tr>`;
      try {
        const data = await api(`/admin/paths/${slug}/enrollments`) as { users: any[] };
        const users = data.users ?? [];
        document.getElementById('enroll-count')!.textContent = `${users.length} inscrit${users.length > 1 ? 's' : ''}`;

        if (users.length === 0) {
          tbody.innerHTML = `<tr><td colspan="4" class="p-8 text-center text-soft">Aucun utilisateur inscrit à ce parcours</td></tr>`;
          return;
        }

        const statusCls: Record<string, string> = {
          completed: 'course-tag-completed',
          available: 'course-tag-available',
          locked:    'course-tag-locked',
        };
        const statusIcon: Record<string, string> = { completed: '✓', available: '▶', locked: '🔒' };

        tbody.innerHTML = users.map((u: any) => {
          const pct = u.totalCourses > 0 ? Math.round(u.completedCourses / u.totalCourses * 100) : 0;
          const courses = (u.courses ?? []).map((c: any) =>
            `<span class="course-tag ${statusCls[c.status] ?? ''}">${statusIcon[c.status]} ${escHtml(c.slug)}</span>`
          ).join(' ');
          const bar = u.totalCourses > 0 ? `
            <div class="path-progress-row">
              <div class="progress-track">
                <div class="progress-fill ${pct === 100 ? 'complete' : 'partial'}" style="width:${pct}%"></div>
              </div>
              <span class="path-progress-pct">${u.completedCourses}/${u.totalCourses}</span>
            </div>` : '';
          const email = u.email || '';
          return `
          <tr class="admin-tr" data-uid="${u.userId}">
            <td class="admin-td">
              <div class="flex-row-gap3">
                <div class="user-avatar-sm">${escHtml((email || '?')[0].toUpperCase())}</div>
                <div>
                  <div class="username-text">${escHtml(email.split('@')[0])}</div>
                  <div class="row-sub">${escHtml(email)}</div>
                </div>
              </div>
            </td>
            <td class="admin-td">
              <div class="flex flex-wrap gap-1">${courses}</div>
              ${bar}
            </td>
            <td class="admin-td text-soft text-sm whitespace-nowrap">${new Date(u.enrolledAt).toLocaleDateString('fr-FR')}</td>
            <td class="admin-td-right">
              <button class="btn btn-sm btn-danger unenroll-btn" data-uid="${u.userId}">Désinscrire</button>
            </td>
          </tr>`;
        }).join('');

        tbody.querySelectorAll<HTMLButtonElement>('.unenroll-btn').forEach(btn => {
          btn.addEventListener('click', () => unenroll(slug, btn.dataset.uid!));
        });
      } catch (e: any) {
        tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-bad">Erreur : ${escHtml(e.message)}</td></tr>`;
      }
    }

    async function enroll(slug: string, userId: string) {
      const btn = document.getElementById('enroll-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Inscription…';
      try {
        await api(`/admin/paths/${slug}/enrollments`, { method: 'POST', body: { userId } });
        toast('Utilisateur inscrit au parcours');
        (document.getElementById('user-select') as HTMLSelectElement).value = '';
        await loadEnrollments(slug);
      } catch (e: any) {
        toast(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Inscrire';
      }
    }

    async function unenroll(slug: string, userId: string) {
      if (!confirm('Désinscrire cet utilisateur du parcours ?')) return;
      try {
        await api(`/admin/paths/${slug}/enrollments/${userId}`, { method: 'DELETE' });
        toast('Utilisateur désinscrit');
        await loadEnrollments(slug);
      } catch (e: any) { toast(e.message || 'Erreur', 'error'); }
    }

    document.getElementById('path-select')!.addEventListener('change', async (e) => {
      currentSlug = (e.target as HTMLSelectElement).value;
      if (!currentSlug) { resetEnrollments(); return; }
      document.getElementById('enroll-form')!.style.display = 'block';
      await loadEnrollments(currentSlug);
    });

    document.getElementById('enroll-btn')!.addEventListener('click', () => {
      const userId = (document.getElementById('user-select') as HTMLSelectElement).value;
      if (!userId) { toast('Sélectionnez un utilisateur', 'error'); return; }
      enroll(currentSlug, userId);
    });

    loadPaths().catch((e: any) => {
      document.getElementById('paths-loading')!.innerHTML = `<p class="text-bad p-6">${escHtml(e.message)}</p>`;
    });
  </script>
</Admin>
