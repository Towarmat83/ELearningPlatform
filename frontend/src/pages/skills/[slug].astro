---
import App from '../../layouts/App.astro';
const { slug } = Astro.params;
---
<App title={`Compétence : ${slug}`} activePage="">
  <style is:global>
    .skill-page { padding: 28px 24px 80px; max-width: 1100px; margin: 0 auto; }
    .skill-back { display: inline-flex; align-items: center; gap: 6px; font-size: .85rem; font-weight: 600; color: var(--blue); cursor: pointer; margin-bottom: 20px; background: none; border: none; padding: 0; text-decoration: none; }
    .skill-back:hover { text-decoration: underline; }
    .skill-chip { display: inline-flex; align-items: center; gap: 6px; background: #f3e8ff; color: #7c3aed; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: .95rem; }
    .skill-prog { display: flex; align-items: center; gap: 10px; margin-top: 12px; padding: 10px 14px; background: var(--fill); border-radius: 10px; font-size: .82rem; color: var(--ink-soft); }
    .skill-prog-pct { font-weight: 700; font-size: 1rem; }
    .level-section { margin-top: 28px; }
    .level-section-title { font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-soft); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
    .level-section-title::after { content: ''; flex: 1; height: 1px; background: var(--line); }
    .courses-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
    .course-card { background: var(--paper); border: 1.5px solid var(--line); border-radius: 12px; padding: 16px 18px; text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 8px; transition: box-shadow .15s, border-color .15s; cursor: pointer; }
    .course-card:hover { box-shadow: 0 4px 16px -4px rgba(30,60,120,.15); border-color: var(--blue); }
    .course-card.card-done { border-color: #16a34a; background: #f0fdf4; }
    .course-card.card-ongoing { border-color: var(--blue); }
    .course-card-title { font-size: 1rem; font-weight: 700; color: var(--ink); }
    .course-card-desc { font-size: .83rem; color: var(--ink-soft); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .course-card-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 2px; }
    .badge-diff { font-size: .68rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
    .diff-beginner  { background: #dcfce7; color: #15803d; }
    .diff-intermediate { background: #fef9c3; color: #a16207; }
    .diff-advanced  { background: #fee2e2; color: #b91c1c; }
    .diff-default   { background: var(--fill); color: var(--ink-soft); }
    .course-modules-hint { font-size: .75rem; color: var(--ink-soft); }
    .badge-status { font-size: .68rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
    .badge-done     { background: #dcfce7; color: #15803d; }
    .badge-ongoing  { background: #dbeafe; color: #1d4ed8; }
    .cc-progress-wrap { display: flex; align-items: center; gap: 8px; margin-top: 2px; }
    .cc-progress-bar  { flex: 1; height: 4px; background: var(--line); border-radius: 4px; overflow: hidden; }
    .cc-progress-fill { height: 100%; background: var(--blue); border-radius: 4px; }
    .cc-progress-label { font-size: .7rem; color: var(--ink-soft); white-space: nowrap; }
    .cc-cta { font-size: .78rem; font-weight: 600; color: var(--blue); margin-top: 2px; }
    .skill-empty { text-align: center; padding: 60px 24px; color: var(--ink-soft); }
    .section-title { font-size: 1rem; font-weight: 700; margin-bottom: 4px; }
    .section-sub { font-size: .82rem; color: var(--ink-soft); }
  </style>

  <div class="skill-page">
    <button onclick="history.back()" class="skill-back">◂ Retour</button>

    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

    <div id="skill-content" style="display:none">
      <div style="margin-bottom:20px">
        <div class="skill-chip">🎯 <span id="skill-name"></span></div>
        <div class="skill-prog" id="skill-prog" style="display:none"></div>
      </div>

      <div class="section-title" id="courses-section-title"></div>
      <div class="section-sub" id="courses-section-sub"></div>

      <div id="courses-by-level"></div>

      <div id="skill-empty" class="skill-empty" style="display:none">
        Aucun cours trouvé pour cette compétence.
      </div>
    </div>
  </div>

  <script define:vars={{ slug }}>
    const token = localStorage.getItem('token');
    if (!token) { window.location.href = `/login?redirect=/skills/${slug}`; }

    const DIFF_MAP = {
      beginner:     { label: 'Débutant',       cls: 'diff-beginner'     },
      intermediate: { label: 'Intermédiaire',  cls: 'diff-intermediate' },
      advanced:     { label: 'Avancé',         cls: 'diff-advanced'     },
    };

    function diffBadge(d) {
      const m = DIFF_MAP[d] ?? { label: d || '', cls: 'diff-default' };
      return m.label ? `<span class="badge-diff ${m.cls}">${m.label}</span>` : '';
    }

    function renderCourseCard(c, skillModules, modDone, modTotal, isCompleted, isEnrolled) {
      const modCount = skillModules[c.slug] ?? 0;
      const hint = modCount > 0
        ? `${modCount} module${modCount > 1 ? 's' : ''} sur cette compétence`
        : '';

      let statusBadge = '';
      let progressBar  = '';
      let cta          = '';
      let cardClass    = 'course-card';

      if (isCompleted) {
        cardClass += ' card-done';
        statusBadge = `<span class="badge-status badge-done">✓ Terminé</span>`;
        cta = `<span class="cc-cta">Revoir →</span>`;
      } else if (isEnrolled) {
        cardClass += ' card-ongoing';
        statusBadge = `<span class="badge-status badge-ongoing">En cours</span>`;
        const total = modTotal[c.slug] ?? 0;
        const done  = modDone[c.slug]  ?? 0;
        if (total > 0) {
          const pct = Math.round(done / total * 100);
          progressBar = `
            <div class="cc-progress-wrap">
              <div class="cc-progress-bar"><div class="cc-progress-fill" style="width:${pct}%"></div></div>
              <span class="cc-progress-label">${done}/${total} modules</span>
            </div>`;
        }
        cta = `<span class="cc-cta">Continuer →</span>`;
      }

      return `
        <a class="${cardClass}" href="/courses/${c.slug}">
          <div class="course-card-title">${c.title}</div>
          ${c.description ? `<div class="course-card-desc">${c.description}</div>` : ''}
          <div class="course-card-meta">
            ${diffBadge(c.difficulty)}
            ${statusBadge}
            ${hint ? `<span class="course-modules-hint">· ${hint}</span>` : ''}
          </div>
          ${progressBar}
          ${cta}
        </a>`;
    }

    async function init() {
      if (!token) return;
      try {
        const [skillRes, coursesRes, myCoursesRes] = await Promise.all([
          fetch(`/api/my/skills/${slug}`, { headers: { Authorization: `Bearer ${token}` } }),
          fetch(`/api/courses`,           { headers: { Authorization: `Bearer ${token}` } }),
          fetch(`/api/my/courses`,        { headers: { Authorization: `Bearer ${token}` } }),
        ]);

        if (skillRes.status === 401 || coursesRes.status === 401) {
          localStorage.clear();
          window.location.href = '/login';
          return;
        }

        const [skillData, coursesData, myCoursesData] = await Promise.all([
          skillRes.json(),
          coursesRes.json(),
          myCoursesRes.json(),
        ]);

        // Build enrollment and completion sets from my/courses
        const enrolledSlugs  = new Set();
        const completedSlugs = new Set();
        for (const c of (myCoursesData.courses ?? [])) {
          enrolledSlugs.add(c.slug);
          if (c.completed) completedSlugs.add(c.slug);
        }

        document.getElementById('loading').style.display = 'none';
        document.getElementById('skill-content').style.display = 'block';

        const label = slug.split('-').map(w => w[0].toUpperCase() + w.slice(1)).join(' ');
        document.getElementById('skill-name').textContent = label;

        // Compute progression from skill modules
        const modules = skillData.modules ?? [];
        if (modules.length > 0) {
          const done = modules.filter(m => m.status === 'completed').length;
          const total = modules.length;
          const pct = Math.round(done / total * 100);
          const col = pct === 100 ? 'var(--good)' : 'var(--blue)';
          const progEl = document.getElementById('skill-prog');
          progEl.style.display = 'flex';
          progEl.innerHTML = `
            <div class="progress-bar" style="flex:1">
              <div class="progress-bar-fill" style="width:${pct}%;background:${col}"></div>
            </div>
            <span class="skill-prog-pct" style="color:${col}">${pct}%</span>
            <span>${done}/${total} modules complétés</span>`;
        }

        // Count skill-relevant modules per course + completed modules per course
        const skillModules = {}; // courseSlug → nb modules teaching this skill
        const modDone  = {};     // courseSlug → nb modules completed
        const modTotal = {};     // courseSlug → nb modules total in course
        for (const m of modules) {
          skillModules[m.courseSlug] = (skillModules[m.courseSlug] ?? 0) + 1;
          modTotal[m.courseSlug] = (modTotal[m.courseSlug] ?? 0) + 1;
          if (m.status === 'completed') {
            modDone[m.courseSlug] = (modDone[m.courseSlug] ?? 0) + 1;
          }
        }

        // Filter courses that teach this skill
        const allCourses = coursesData.courses ?? coursesData ?? [];
        const STATUS_ORDER = c => completedSlugs.has(c.slug) ? 2 : enrolledSlugs.has(c.slug) ? 0 : 1;
        const DIFF_ORDER = { beginner: 0, intermediate: 1, advanced: 2 };
        const related = allCourses
          .filter(c => Array.isArray(c.skills) && c.skills.includes(slug))
          .sort((a, b) => {
            const diffA = DIFF_ORDER[a.difficulty] ?? 99;
            const diffB = DIFF_ORDER[b.difficulty] ?? 99;
            if (diffA !== diffB) return diffA - diffB;
            return STATUS_ORDER(a) - STATUS_ORDER(b); // en cours first within same level
          });

        if (related.length === 0) {
          document.getElementById('skill-empty').style.display = 'block';
          return;
        }

        document.getElementById('courses-section-title').textContent =
          `${related.length} cours impliqué${related.length > 1 ? 's' : ''}`;
        document.getElementById('courses-section-sub').textContent =
          `Ces cours contiennent des modules qui développent la compétence « ${label} »`;

        const LEVELS = [
          { key: 'beginner',     label: 'Débutant'      },
          { key: 'intermediate', label: 'Intermédiaire' },
          { key: 'advanced',     label: 'Avancé'        },
          { key: '',             label: 'Autre'         },
        ];

        const grouped = Object.fromEntries(LEVELS.map(l => [l.key, []]));
        for (const c of related) {
          const key = grouped[c.difficulty] !== undefined ? c.difficulty : '';
          grouped[key].push(c);
        }

        const html = LEVELS
          .filter(l => grouped[l.key].length > 0)
          .map(l => `
            <div class="level-section">
              <div class="level-section-title">${l.label}</div>
              <div class="courses-grid">
                ${grouped[l.key].map(c => renderCourseCard(c, skillModules, modDone, modTotal, completedSlugs.has(c.slug), enrolledSlugs.has(c.slug))).join('')}
              </div>
            </div>`)
          .join('');

        document.getElementById('courses-by-level').innerHTML = html;

      } catch (e) {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('skill-content').style.display = 'block';
        document.getElementById('skill-empty').style.display = 'block';
      }
    }

    init();
  </script>
</App>
