---
import App from '../layouts/App.astro';
---
<App title="Mon XP" activePage="xp">
  <div class="page-outer">
    <div class="page-inner">
      <h1 class="page-title mb-1">Mon XP</h1>
      <p class="text-[.9rem] text-ink-soft mb-7" id="xp-sub">Chargement…</p>

      <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

      <div id="xp-content" class="hidden">
        <div class="xp-hero">
          <div class="xp-orb">⚡</div>
          <div class="flex-1 min-w-0">
            <div class="xp-total" id="xp-total">0</div>
            <div class="xp-total-label">points d'expérience</div>
            <div class="xp-level-chip" id="xp-level-chip">Niveau 1 — Novice</div>
            <div class="xp-progress-bar">
              <div class="xp-progress-fill" id="xp-bar"></div>
            </div>
            <div class="xp-next-label" id="xp-next-label"></div>
          </div>
        </div>

        <div class="xp-levels" id="xp-levels"></div>

        <div id="xp-inprogress"></div>

        <div class="section-title">Historique des gains</div>
        <div id="xp-hist-list"></div>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=/my-xp'; }

    const LEVELS = [
      { level: 1, name: 'Novice',    icon: '🌱', threshold: 0    },
      { level: 2, name: 'Apprenant', icon: '📘', threshold: 200  },
      { level: 3, name: 'Confirmé',  icon: '⚙️',  threshold: 600  },
      { level: 4, name: 'Expert',    icon: '🔥', threshold: 1500 },
      { level: 5, name: 'Maître',    icon: '🏆', threshold: 3500 },
    ];

    const SOURCE_ICONS: Record<string, string> = { lesson: '📖', module: '🎯', course: '🎓' };
    const SOURCE_LABELS: Record<string, string> = { lesson: 'Leçon', module: 'Module', course: 'Cours' };

    async function apiFetch(path: string, auth = true) {
      const headers: Record<string,string> = {};
      if (auth && token) headers['Authorization'] = `Bearer ${token}`;
      const res = await fetch('/api' + path, { headers });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    async function init() {
      try {
        const [data, coursesData, myCoursesData] = await Promise.all([
          apiFetch('/my/xp'),
          apiFetch('/courses', false),
          apiFetch('/my/courses'),
        ]) as any[];

        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('xp-content')!.classList.remove('hidden');

        const total: number = data.total ?? 0;
        const level: number = data.level ?? 1;
        const levelName: string = data.levelName ?? 'Novice';

        const allCourses: any[] = coursesData?.courses ?? [];
        const courseTitle: Record<string,string> = {};
        for (const c of allCourses) courseTitle[c.slug] = c.title || c.slug;

        document.getElementById('xp-sub')!.textContent = `${total.toLocaleString('fr-FR')} points accumulés`;
        document.getElementById('xp-total')!.textContent = total.toLocaleString('fr-FR');
        document.getElementById('xp-level-chip')!.textContent = `Niveau ${level} — ${levelName}`;

        const cur = LEVELS[level - 1];
        const next = LEVELS[level];
        if (next) {
          const progress = Math.min(100, Math.round(((total - cur.threshold) / (next.threshold - cur.threshold)) * 100));
          (document.getElementById('xp-bar') as HTMLElement).style.width = `${progress}%`;
          document.getElementById('xp-next-label')!.textContent =
            `${next.threshold - total} XP jusqu'au niveau ${next.level} (${next.name})`;
        } else {
          (document.getElementById('xp-bar') as HTMLElement).style.width = '100%';
          document.getElementById('xp-next-label')!.textContent = 'Niveau maximum atteint 🏆';
        }

        document.getElementById('xp-levels')!.innerHTML = LEVELS.map(l => `
          <div class="xp-level-card${l.level === level ? ' current' : ''}">
            <div class="xp-level-icon">${l.icon}</div>
            <div class="xp-level-name">${l.name}</div>
            <div class="xp-level-thresh">${l.threshold === 0 ? 'Départ' : `${l.threshold.toLocaleString('fr-FR')} XP`}</div>
          </div>
        `).join('');

        const myCourses: any[] = myCoursesData?.courses ?? [];
        const completedSlugs = new Set(
          (data.history ?? []).filter((e: any) => e.amount === 200).map((e: any) => e.sourceSlug?.split('/')[0] ?? '')
        );
        const inProgress = myCourses.filter((c: any) => !c.completed && !completedSlugs.has(c.slug));

        if (inProgress.length > 0) {
          document.getElementById('xp-inprogress')!.innerHTML = `
            <div class="section-title">En cours <span class="text-[.75rem] font-normal normal-case tracking-normal text-ink-soft">(${inProgress.length} cours)</span></div>
            ${inProgress.map((c: any) => {
              const title = courseTitle[c.slug] || c.title || c.slug.replace(/-/g, ' ');
              return `
                <a href="/courses/${c.slug}" class="xp-hist-item">
                  <div class="xp-hist-icon xp-hist-icon-inprogress">📖</div>
                  <div class="xp-hist-meta">
                    <div class="xp-hist-slug">${title}</div>
                    <div class="xp-hist-source">En cours · Compléter pour +200 XP</div>
                  </div>
                  <div class="text-[.82rem] font-semibold text-slate-400 whitespace-nowrap">→</div>
                </a>`;
            }).join('')}
          `;
        }

        const history: any[] = data.history ?? [];
        if (history.length === 0) {
          document.getElementById('xp-hist-list')!.innerHTML =
            '<div class="xp-empty">Aucun XP gagné pour l\'instant.<br>Complète des leçons, modules et cours pour en gagner !</div>';
        } else {
          document.getElementById('xp-hist-list')!.innerHTML = history.map((e: any) => {
            const icon = SOURCE_ICONS[e.source] ?? '⚡';
            const label = SOURCE_LABELS[e.source] ?? e.source;
            const date = new Date(e.earnedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
            const courseSlug = e.sourceSlug?.split('/')[0] ?? '';
            const displayTitle = courseTitle[courseSlug] || courseSlug.replace(/-/g, ' ');
            const href = `/courses/${courseSlug}`;
            return `
              <a href="${href}" class="xp-hist-item">
                <div class="xp-hist-icon">${icon}</div>
                <div class="xp-hist-meta">
                  <div class="xp-hist-slug">${displayTitle}</div>
                  <div class="xp-hist-source">${label} · ${date}</div>
                </div>
                <div class="xp-hist-amount">+${e.amount} XP</div>
              </a>`;
          }).join('');
        }
      } catch {
        (window as any).showToast?.('Erreur lors du chargement', 'error');
      }
    }

    init();
  </script>
</App>
