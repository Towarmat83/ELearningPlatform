---
import Manager from '../../../layouts/Manager.astro';
---
<Manager title="Mes membres">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px">
    <div>
      <h1 style="font-size:1.5rem">Mes membres</h1>
      <p class="text-soft text-sm" style="margin-top:4px" id="member-count">Chargement…</p>
      <div id="scope-groups" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;align-items:center">
        <span class="text-soft text-sm" style="margin-right:2px;font-size:.75rem">Filtrer :</span>
      </div>
    </div>
  </div>

  <!-- Members table -->
  <div class="card" style="padding:0;overflow:hidden">
    <table style="width:100%;border-collapse:collapse;font-size:.875rem" id="members-table">
      <thead>
        <tr style="border-bottom:1px solid var(--line);background:var(--fill)">
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Membre</th>
          <th style="padding:12px 16px;text-align:left;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Cours inscrits</th>
          <th style="padding:12px 16px;text-align:right;font-weight:600;color:var(--ink-soft);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Actions</th>
        </tr>
      </thead>
      <tbody id="members-body">
        <tr><td colspan="3" style="padding:32px;text-align:center"><div class="loading-state" style="padding:0"><div class="spinner"></div><span class="text-soft text-sm">Chargement…</span></div></td></tr>
      </tbody>
    </table>
  </div>

  <!-- Enrollment modal -->
  <div id="enroll-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;align-items:center;justify-content:center">
    <div class="card" style="width:520px;max-width:95vw;padding:28px;max-height:90vh;overflow-y:auto">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
        <h3 id="modal-title">Gérer les inscriptions</h3>
        <button id="modal-close" style="background:none;border:none;cursor:pointer;font-size:1.25rem;color:var(--ink-soft)">✕</button>
      </div>

      <!-- Current enrollments -->
      <div style="margin-bottom:20px">
        <h4 style="font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);margin-bottom:10px">Cours actuels</h4>
        <div id="current-enrollments">
          <div class="loading-state" style="padding:12px 0"><div class="spinner" style="width:20px;height:20px"></div></div>
        </div>
      </div>

      <!-- Enroll in a new course -->
      <div style="border-top:1px solid var(--line);padding-top:20px">
        <h4 style="font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);margin-bottom:10px">Inscrire à un cours</h4>
        <div style="display:flex;gap:8px">
          <select id="course-select" class="input" style="flex:1;height:auto;padding:9px 14px">
            <option value="">Choisir un cours…</option>
          </select>
          <button class="btn btn-primary" id="enroll-btn">Inscrire</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const token = localStorage.getItem('token');
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers, body: opts.body ? JSON.stringify(opts.body) : undefined });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    let allMembers: any[] = [];
    let allCourses: any[] = [];
    let scopeGroupsData: any[] = [];
    let activeGroupFilter: string | null = null;
    let selectedUserId = '';

    async function load() {
      try {
        const [membersRes, coursesRes] = await Promise.all([
          api('/manager/users'),
          api('/courses'),
        ]);
        allMembers = membersRes.users || [];
        allCourses = coursesRes.courses || [];
        scopeGroupsData = membersRes.groups || [];

        updateCountLabel();
        renderGroupBadges();
        renderMembers();

        // Populate course select
        const sel = document.getElementById('course-select') as HTMLSelectElement;
        sel.innerHTML = '<option value="">Choisir un cours…</option>' + allCourses.map((c: any) =>
          `<option value="${c.slug}">${c.title}${c.scope ? ` [${c.scope}]` : ''}</option>`
        ).join('');
      } catch (e: any) {
        document.getElementById('members-body')!.innerHTML =
          `<tr><td colspan="3" style="padding:24px;text-align:center;color:var(--bad)">Erreur : ${e.message}</td></tr>`;
      }
    }

    function updateCountLabel() {
      const filtered = activeGroupFilter
        ? allMembers.filter((u: any) => {
            const g = scopeGroupsData.find((g: any) => g.id === activeGroupFilter);
            return g && g.memberIds.includes(u.id);
          })
        : allMembers;
      document.getElementById('member-count')!.textContent =
        `${filtered.length} membre${filtered.length !== 1 ? 's' : ''}${activeGroupFilter ? ' dans ce groupe' : ' dans vos groupes'}`;
    }

    function renderGroupBadges() {
      const scopeEl = document.getElementById('scope-groups')!;
      if (!scopeGroupsData.length) {
        scopeEl.innerHTML = '<span class="text-soft text-sm" style="font-style:italic">Aucun groupe assigné</span>';
        return;
      }
      scopeEl.innerHTML = '<span class="text-soft text-sm" style="margin-right:2px;font-size:.75rem">Filtrer :</span>' +
        scopeGroupsData.map((g: any) => {
          const isActive = activeGroupFilter === g.id;
          return `<button class="badge badge-orange group-filter-btn" data-gid="${g.id}" style="cursor:pointer;border:none;font-size:.75rem;${isActive ? 'outline:2px solid var(--orange,#f97316);outline-offset:1px;' : 'opacity:.7'}">${g.name}</button>`;
        }).join('');
      scopeEl.querySelectorAll<HTMLButtonElement>('.group-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeGroupFilter = activeGroupFilter === btn.dataset.gid! ? null : btn.dataset.gid!;
          renderGroupBadges();
          updateCountLabel();
          renderMembers();
        });
      });
    }

    function renderMembers() {
      const tbody = document.getElementById('members-body')!;
      const visible = activeGroupFilter
        ? allMembers.filter((u: any) => {
            const g = scopeGroupsData.find((g: any) => g.id === activeGroupFilter);
            return g && g.memberIds.includes(u.id);
          })
        : allMembers;
      if (!visible.length) {
        tbody.innerHTML = `<tr><td colspan="3" style="padding:32px;text-align:center;color:var(--ink-soft)">Aucun membre${activeGroupFilter ? ' dans ce groupe' : ' dans vos groupes'}</td></tr>`;
        return;
      }
      tbody.innerHTML = visible.map((u: any) => `
        <tr style="border-bottom:1px solid var(--line)" data-uid="${u.id}">
          <td style="padding:12px 16px">
            <div style="display:flex;align-items:center;gap:10px">
              <div style="width:34px;height:34px;border-radius:50%;background:var(--blue-soft);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.82rem;color:var(--blue);flex-shrink:0">${(u.username || '?')[0].toUpperCase()}</div>
              <div>
                <div style="font-weight:500">${u.username}</div>
                <div style="font-size:.78rem;color:var(--ink-soft)">${u.email}</div>
              </div>
            </div>
          </td>
          <td style="padding:12px 16px;color:var(--ink-soft)">${u.enrolledCourses ?? 0} cours</td>
          <td style="padding:12px 16px;text-align:right">
            <button class="btn btn-secondary btn-sm manage-btn" data-uid="${u.id}" data-name="${u.username}">Gérer les inscriptions</button>
          </td>
        </tr>
      `).join('');

      tbody.querySelectorAll<HTMLButtonElement>('.manage-btn').forEach(btn => {
        btn.addEventListener('click', () => openModal(btn.dataset.uid!, btn.dataset.name!));
      });
    }

    async function openModal(userId: string, name: string) {
      selectedUserId = userId;
      document.getElementById('modal-title')!.textContent = `${name} — Inscriptions`;
      document.getElementById('enroll-modal')!.style.display = 'flex';
      await refreshEnrollments();
    }

    async function refreshEnrollments() {
      const el = document.getElementById('current-enrollments')!;
      el.innerHTML = '<div class="loading-state" style="padding:12px 0"><div class="spinner" style="width:20px;height:20px"></div></div>';
      try {
        const { enrollments } = await api(`/manager/users/${selectedUserId}/enrollments`);
        const list: any[] = enrollments || [];
        if (!list.length) {
          el.innerHTML = '<p class="text-soft text-sm">Aucun cours inscrit.</p>';
          return;
        }
        el.innerHTML = list.map((e: any) => `
          <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)">
            <div style="flex:1;font-size:.875rem">
              <span style="font-weight:500">${e.courseSlug}</span>
            </div>
            <button class="btn btn-sm unenroll-btn" style="background:var(--bad-soft);color:var(--bad);flex-shrink:0" data-slug="${e.courseSlug}">Retirer</button>
          </div>
        `).join('');
        el.querySelectorAll<HTMLButtonElement>('.unenroll-btn').forEach(btn => {
          btn.addEventListener('click', () => unenroll(btn.dataset.slug!));
        });
      } catch (e: any) {
        el.innerHTML = `<p style="color:var(--bad);font-size:.875rem">${e.message}</p>`;
      }
    }

    async function unenroll(slug: string) {
      try {
        await api(`/manager/courses/${slug}/enrollments/${selectedUserId}`, { method: 'DELETE' });
        (window as any).showToast?.('Inscription retirée', 'success');
        await refreshEnrollments();
        await load();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      }
    }

    document.getElementById('enroll-btn')!.addEventListener('click', async () => {
      const slug = (document.getElementById('course-select') as HTMLSelectElement).value;
      if (!slug) { (window as any).showToast?.('Choisissez un cours', 'error'); return; }
      const btn = document.getElementById('enroll-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '…';
      try {
        await api(`/manager/courses/${slug}/enrollments`, { method: 'POST', body: { userId: selectedUserId } });
        (document.getElementById('course-select') as HTMLSelectElement).value = '';
        (window as any).showToast?.('Inscrit avec succès', 'success');
        await refreshEnrollments();
        await load();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Inscrire';
      }
    });

    document.getElementById('modal-close')!.addEventListener('click', () => {
      document.getElementById('enroll-modal')!.style.display = 'none';
    });
    document.getElementById('enroll-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('enroll-modal')) document.getElementById('enroll-modal')!.style.display = 'none';
    });

    load();
  </script>
</Manager>
