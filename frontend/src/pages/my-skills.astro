---
import App from '../layouts/App.astro';
---
<App title="Mes compétences" activePage="skills">
  <div class="page-outer">
    <div class="page-inner">
      <div class="flex items-baseline justify-between gap-4 mb-7 flex-wrap">
        <h1 class="page-title">Mes compétences</h1>
      </div>

      <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

      <div id="ms-content" class="hidden">
        <div id="ms-acquired-section" class="hidden">
          <div class="section-title">Acquises</div>
          <div id="ms-grid" class="auto-grid sm:grid-cols-2"></div>
        </div>

        <div id="ms-inprogress-section" class="hidden">
          <div class="section-title">En apprentissage</div>
          <div id="ms-inprogress-grid" class="auto-grid sm:grid-cols-2"></div>
        </div>

        <div id="ms-empty" class="hidden text-center py-[60px] px-6 text-ink-soft">
          <div class="text-[3rem] mb-3">🎯</div>
          <h2 class="mb-2">Aucune compétence pour l'instant</h2>
          <p class="mb-5">Commence un cours pour voir tes compétences évoluer.</p>
          <a href="/courses" class="btn btn-primary">Découvrir le catalogue</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function apiFetch(path: string) {
      const res = await fetch(`/api${path}`, {
        headers: token ? { 'Authorization': `Bearer ${token}` } : {},
      });
      if (!res.ok) { const err: any = new Error('fetch error'); err.status = res.status; throw err; }
      return res.json();
    }

    function levelLabel(level: string): string {
      const map: Record<string, string> = {
        beginner:     'Débutant',
        intermediate: 'Intermédiaire',
        advanced:     'Avancé',
        'maître':     '★ Maître',
      };
      return map[level] ?? level;
    }

    function levelClass(level: string): string {
      const map: Record<string, string> = {
        beginner:     'level-beginner',
        intermediate: 'level-intermediate',
        advanced:     'level-advanced',
        'maître':     'level-maitre',
      };
      return map[level] ?? '';
    }

    function progressHTML(s: any, fillClass = ''): string {
      if (!s.totalCourses) return '';
      const pct = Math.min(100, Math.round((s.completedCourses / s.totalCourses) * 100));
      return `
        <div class="ms-progress-wrap">
          <div class="ms-progress-bar">
            <div class="ms-progress-fill${fillClass ? ' ' + fillClass : ''}" style="width:${pct}%"></div>
          </div>
          <span class="ms-progress-label">${s.completedCourses}/${s.totalCourses} cours</span>
        </div>
      `;
    }

    function computeLevel(completed: number, total: number): string {
      if (completed === 0 || total === 0) return 'inprogress';
      const pct = completed / total;
      if (pct >= 1.0) return 'maître';
      if (pct >= 0.60) return 'advanced';
      if (pct >= 0.30) return 'intermediate';
      return 'beginner';
    }

    function skillCard(skill: string, completedCourses: number, totalCourses: number): string {
      const level = computeLevel(completedCourses, totalCourses);
      const isMaitre = level === 'maître';
      const fillClass = isMaitre ? 'fill-maitre' : '';
      return `
        <div class="ms-card${isMaitre ? ' card-maitre' : ''} cursor-pointer" onclick="window.location.href='/skills/${skill}'" >
          <div class="ms-card-skill">${skill}</div>
          <div class="ms-level ${levelClass(level)}">${levelLabel(level)}</div>
          ${progressHTML({ completedCourses, totalCourses }, fillClass)}
          <span class="ms-cta">Voir les modules →</span>
        </div>
      `;
    }

    function inProgressCard(skill: string, completedCourses: number, totalCourses: number): string {
      return `
        <div class="ms-card cursor-pointer" onclick="window.location.href='/skills/${skill}'" >
          <div class="ms-card-skill">${skill}</div>
          <div class="ms-level level-inprogress">En cours</div>
          ${progressHTML({ completedCourses, totalCourses }, 'fill-inprogress')}
          <span class="ms-cta">Voir les modules →</span>
        </div>
      `;
    }

    async function init() {
      if (!token) { window.location.href = '/login?redirect=/my-skills'; return; }

      try {
        const [skillsData, myCoursesData, allCoursesData] = await Promise.all([
          apiFetch('/my/skills'),
          apiFetch('/my/courses'),
          apiFetch('/courses'),
        ]) as any[];

        const dbSkills: any[]   = skillsData.skills    || [];
        const myCourses: any[]  = myCoursesData.courses || [];
        const allCourses: any[] = allCoursesData.courses || [];

        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('ms-content')!.classList.remove('hidden');

        const courseBySlug = new Map(allCourses.map((c: any) => [c.slug, c]));
        const totalBySkill = new Map<string, number>();
        for (const c of allCourses) {
          for (const sk of (c.skills || [])) {
            totalBySkill.set(sk, (totalBySkill.get(sk) ?? 0) + 1);
          }
        }

        const completedBySkill = new Map<string, number>();
        const enrolledSkills = new Set<string>();
        for (const enrolled of myCourses) {
          const course = courseBySlug.get(enrolled.slug);
          if (!course) continue;
          for (const sk of (course.skills || [])) {
            enrolledSkills.add(sk);
            if (enrolled.completed) {
              completedBySkill.set(sk, (completedBySkill.get(sk) ?? 0) + 1);
            }
          }
        }

        for (const s of dbSkills) {
          if (!completedBySkill.has(s.skill) && s.completedCourses > 0) {
            completedBySkill.set(s.skill, s.completedCourses);
          }
          enrolledSkills.add(s.skill);
        }

        const acquired: Array<{ skill: string; completed: number; total: number }> = [];
        const inProgress: Array<{ skill: string; completed: number; total: number }> = [];
        const seen = new Set<string>();

        for (const sk of enrolledSkills) {
          if (seen.has(sk)) continue;
          seen.add(sk);
          const completed = completedBySkill.get(sk) ?? 0;
          const total = totalBySkill.get(sk) ?? 0;
          if (completed > 0) {
            acquired.push({ skill: sk, completed, total });
          } else {
            inProgress.push({ skill: sk, completed: 0, total });
          }
        }

        acquired.sort((a, b) => a.skill.localeCompare(b.skill));
        inProgress.sort((a, b) => a.skill.localeCompare(b.skill));

        if (acquired.length === 0 && inProgress.length === 0) {
          document.getElementById('ms-empty')!.classList.remove('hidden');
          return;
        }

        if (acquired.length > 0) {
          document.getElementById('ms-acquired-section')!.classList.remove('hidden');
          document.getElementById('ms-grid')!.innerHTML =
            acquired.map(({ skill, completed, total }) => skillCard(skill, completed, total)).join('');
        }

        if (inProgress.length > 0) {
          document.getElementById('ms-inprogress-section')!.classList.remove('hidden');
          document.getElementById('ms-inprogress-grid')!.innerHTML =
            inProgress.map(({ skill, completed, total }) => inProgressCard(skill, completed, total)).join('');
        }

      } catch {
        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('ms-content')!.classList.remove('hidden');
        document.getElementById('ms-empty')!.classList.remove('hidden');
      }
    }

    init();
  </script>
</App>
