---
import App from './App.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/admin';

const navItems = [
  { href: '/admin',              label: '📊 Tableau de bord' },
  { href: '/admin/users',        label: '👥 Utilisateurs'    },
  { href: '/admin/courses',      label: '📚 Cours'            },
  { href: '/admin/paths',        label: '🗺️ Parcours'         },
  { href: '/admin/groups',       label: '🏷️ Groupes'          },
  { href: '/admin/patterns',     label: '🔶 Patterns'         },
  { href: '/admin/leaderboard',  label: '🏆 Classement'       },
  { href: '/admin/labs',         label: '🧪 Labs'             },
  { href: '/admin/settings',     label: '⚙️ Paramètres'       },
  { href: '/admin/monitoring',   label: '📈 Monitoring'       },
];

function isActive(href: string) {
  if (href === '/admin') return path === '/admin';
  return path.startsWith(href);
}
---
<App title={`${title} — Admin`}>
  <div id="admin-forbidden" style="display:none;min-height:calc(100vh - 56px);align-items:center;justify-content:center">
    <div style="text-align:center;padding:48px">
      <div style="font-size:3rem;margin-bottom:16px">🔒</div>
      <h2 style="margin-bottom:8px">Accès refusé</h2>
      <p class="text-soft text-sm" style="margin-bottom:20px">Réservé aux administrateurs.</p>
      <a href="/courses" class="btn btn-primary">Retour au catalogue</a>
    </div>
  </div>

  <div id="admin-shell" style="display:none;min-height:calc(100vh - 56px)">
    <div style="display:grid;grid-template-columns:220px 1fr;min-height:calc(100vh - 56px)">

      <!-- Sidebar -->
      <aside style="border-right:1px solid var(--line);background:var(--paper);padding:20px 12px;position:sticky;top:56px;height:calc(100vh - 56px);overflow-y:auto">
        <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-soft);padding:0 10px;margin-bottom:10px">Administration</div>
        <nav style="display:flex;flex-direction:column;gap:2px">
          {navItems.map(item => (
            <a
              href={item.href}
              class={`sidebar-link${isActive(item.href) ? ' active' : ''}`}
            >{item.label}</a>
          ))}
        </nav>
        <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--line)">
          <a href="/courses" class="sidebar-link" style="color:var(--ink-soft);font-size:.82rem">← Retour au catalogue</a>
        </div>
      </aside>

      <!-- Main content -->
      <main style="padding:32px 36px;min-width:0">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user') || 'null');

    if (!token) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
    } else if (user?.role !== 'admin') {
      document.getElementById('admin-forbidden')!.style.display = 'flex';
    } else {
      document.getElementById('admin-shell')!.style.display = 'block';
    }
  </script>
</App>
