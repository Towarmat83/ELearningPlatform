---
import App from '../../../layouts/App.astro';
---
<App title="Cours" activePage="catalogue">
  <style is:global>
    .course-page {
      display: grid;
      grid-template-columns: 330px 1fr;
      gap: 0;
      min-height: calc(100vh - 56px);
      align-items: flex-start;
    }
    .course-sidebar {
      position: sticky;
      top: 56px;
      height: calc(100vh - 56px);
      overflow-y: auto;
      border-right: 1px solid var(--line);
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .course-thumb {
      width: 100%;
      height: 160px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--blue-soft), #c8e4fd);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      overflow: hidden;
      flex-shrink: 0;
    }
    .course-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .course-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .course-main {
      padding: 24px 28px;
    }
    .course-main-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .mod-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border: 1.5px solid var(--line);
      border-radius: 12px;
      background: var(--paper);
      text-decoration: none;
      color: inherit;
      transition: border-color .15s, background .15s;
      margin-bottom: 8px;
    }
    .mod-row:hover { border-color: var(--blue); background: var(--blue-soft); }
    .mod-row.current { border-color: var(--blue); background: var(--blue-soft); }
    .mod-row.locked { opacity: .5; pointer-events: none; }
    .mod-icon {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: var(--fill);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem; flex-shrink: 0;
    }
    .mod-icon.quiz { background: var(--orange-soft); }
    .mod-icon.done { background: var(--good-soft); }
    .mod-name { flex: 1; font-weight: 500; font-size: .9rem; }
    .mod-badges { display: flex; gap: 5px; flex-wrap: wrap; }

    /* ── AI Summary ── */
    .ai-card {
      margin-bottom: 24px;
      border: 1.5px solid var(--line);
      border-radius: 14px;
      overflow: hidden;
      background: var(--paper);
    }
    .ai-card-header {
      padding: 12px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid var(--line);
      background: var(--fill);
    }
    .ai-avatar {
      width: 26px; height: 26px;
      border-radius: 6px;
      background: linear-gradient(135deg,#1b86f2,#1466c4);
      display: flex; align-items: center; justify-content: center;
      font-size: .8rem; flex-shrink: 0; color: #fff;
    }
    .ai-card-header-name { font-size: .82rem; font-weight: 700; color: var(--ink); }
    .ai-card-body { padding: 18px 20px 14px; }
    .ai-thinking {
      display: flex; align-items: center; gap: 8px;
      font-size: .82rem; color: var(--ink-soft);
    }
    .ai-dots span {
      display: inline-block; width: 5px; height: 5px;
      border-radius: 50%; background: var(--blue);
      animation: bounce-dot .9s ease-in-out infinite;
    }
    .ai-dots span:nth-child(2){animation-delay:.2s}
    .ai-dots span:nth-child(3){animation-delay:.4s}
    @keyframes bounce-dot{0%,80%,100%{transform:translateY(0)}40%{transform:translateY(-5px)}}
    .ai-bullets { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
    .ai-bullet {
      display: flex; gap: 10px; align-items: flex-start;
      font-size: .875rem; line-height: 1.65; color: var(--ink);
      opacity: 0; transform: translateY(6px);
      transition: opacity .4s ease, transform .4s ease;
    }
    .ai-bullet.visible { opacity: 1; transform: translateY(0); }
    .ai-bullet-dot {
      margin-top: 7px; width: 6px; height: 6px;
      border-radius: 50%; background: var(--blue);
      flex-shrink: 0;
    }
    .ai-footer {
      margin-top: 14px; padding-top: 10px;
      border-top: 1px solid var(--line);
      font-size: .72rem; color: var(--ink-soft);
      display: flex; align-items: center; gap: 6px;
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .course-page { grid-template-columns: 280px 1fr; }
    }
    @media (max-width: 640px) {
      .course-page { grid-template-columns: 1fr; }
      .course-sidebar {
        position: static;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--line);
        overflow-y: visible;
        padding: 20px 16px;
        gap: 12px;
      }
      .course-thumb { height: 180px; }
      .course-main { padding: 20px 16px; }
    }
  </style>

  <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

  <div id="not-found" style="display:none;text-align:center;padding:80px 24px">
    <div style="font-size:3rem;margin-bottom:16px">😕</div>
    <h2>Cours introuvable</h2>
    <a href="/courses" class="btn btn-primary" style="margin-top:16px;display:inline-flex">Retour au catalogue</a>
  </div>

  <div id="course-content" class="course-page" style="display:none">
    <!-- Left sticky sidebar -->
    <aside class="course-sidebar">
      <div class="course-thumb" id="thumb-area">📚</div>
      <h1 id="course-title" style="font-size:1.1rem;font-weight:700;line-height:1.35"></h1>
      <div id="course-tags" class="course-tags"></div>
      <p id="course-desc" class="text-soft text-sm" style="line-height:1.6;font-size:.85rem"></p>
      <div id="enroll-area"></div>
      <div id="course-meta" class="stack" style="gap:8px;border-top:1px solid var(--line);padding-top:14px;margin-top:4px"></div>
    </aside>

    <!-- Right: module list -->
    <div class="course-main">

      <!-- AI Summary -->
      <div class="ai-card" id="ai-card" style="display:none">
        <div class="ai-card-header">
          <div class="ai-avatar">✦</div>
          <span class="ai-card-header-name">Ce qu'il faut retenir</span>
        </div>
        <div class="ai-card-body">
          <div class="ai-thinking" id="ai-thinking">
            <span>Analyse du cours</span>
            <div class="ai-dots"><span></span><span></span><span></span></div>
          </div>
          <ul class="ai-bullets" id="ai-bullets" style="display:none"></ul>
          <div class="ai-footer" id="ai-footer" style="display:none">
            <span>✦</span> Résumé généré par IA
          </div>
        </div>
      </div>

      <div class="course-main-header">
        <h2 style="font-size:1rem;font-weight:700">Contenu du cours</h2>
        <span id="module-count" class="text-soft text-sm"></span>
      </div>
      <div id="modules-list"></div>
      <div id="modules-empty" style="display:none;padding:48px 24px;text-align:center;color:var(--ink-soft)">
        <div style="font-size:2.5rem;margin-bottom:12px">📭</div>
        <p>Inscrivez-vous pour accéder aux modules.</p>
      </div>
      <div id="prereq-blocked" style="display:none;background:var(--orange-soft);border:1.5px solid var(--orange);border-radius:14px;padding:32px;text-align:center">
        <div style="font-size:2rem;margin-bottom:10px">🔒</div>
        <p style="font-weight:600;margin-bottom:4px">Prérequis non satisfaits</p>
        <p class="text-soft text-sm">Terminez les cours prérequis pour accéder à ce contenu.</p>
      </div>

    </div>
  </div>

  <script>
    const slug = window.location.pathname.split('/').filter(Boolean)[1];
    const token = localStorage.getItem('token');

    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        const error = new Error((err as any).error || `HTTP ${res.status}`) as any;
        error.status = res.status;
        throw error;
      }
      return res.json();
    }

    function moduleHref(m: any) {
      if (m.locked) return null;
      if (m.type === 'quiz') return `/courses/${slug}/quiz/${m.index}`;
      return `/courses/${slug}/lessons/${m.index}`;
    }

    function moduleIcon(m: any) {
      if (m.locked) return '🔒';
      if (m.type === 'video') return '🎬';
      if (m.type === 'image') return '🖼️';
      if (m.type === 'quiz') return '🧩';
      return '📝';
    }

    function moduleStatusBadges(m: any): string {
      const parts: string[] = [];
      const typeLabel: Record<string, string> = { quiz: 'Quiz', video: 'Vidéo', image: 'Image', lesson: 'Lecture' };
      parts.push(`<span class="badge badge-gray" style="font-size:.7rem">${typeLabel[m.type] || m.type}</span>`);
      if (m.locked) {
        parts.push(`<span class="badge badge-gray" style="font-size:.7rem">Verrouillé</span>`);
      } else if (m.type === 'quiz') {
        if (m.passed) parts.push(`<span class="badge badge-green" style="font-size:.7rem">✓ ${m.best_score}/${m.max_score} pts</span>`);
        else if (m.attempts > 0) parts.push(`<span class="badge badge-orange" style="font-size:.7rem">${m.attempts} tentative${m.attempts > 1 ? 's' : ''}</span>`);
        else parts.push(`<span class="badge badge-orange" style="font-size:.7rem">★ quiz</span>`);
      } else {
        if (m.viewed) parts.push(`<span class="badge badge-green" style="font-size:.7rem">✓ Vu</span>`);
      }
      return parts.join('');
    }

    function renderModules(modules: any[]) {
      return modules.map(m => {
        const href = moduleHref(m);
        const tag = href ? 'a' : 'div';
        const hrefAttr = href ? `href="${href}"` : '';
        const iconCls = m.locked ? '' : m.type === 'quiz' ? ' quiz' : (m.viewed || m.passed) ? ' done' : '';
        return `
          <${tag} ${hrefAttr} class="mod-row${m.locked ? ' locked' : ''}">
            <div class="mod-icon${iconCls}">${moduleIcon(m)}</div>
            <div class="mod-name">${m.name}</div>
            <div class="mod-badges">${moduleStatusBadges(m)}</div>
            ${href ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--ink-soft)" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>` : ''}
          </${tag}>
        `;
      }).join('');
    }

    async function init() {
      try {
        const course = await apiFetch(`/courses/${slug}`, token ? { token } : {}) as any;

        document.title = `${course.title} — pupitre`;
        document.getElementById('course-title')!.textContent = course.title;
        document.getElementById('course-desc')!.textContent = course.description || '';

        // Thumbnail
        const thumbArea = document.getElementById('thumb-area')!;
        if (course.thumbnail) {
          thumbArea.innerHTML = `<img src="${course.thumbnail}" alt="${course.title}" />`;
        }

        // Tags
        const tagsEl = document.getElementById('course-tags')!;
        const tagParts: string[] = [];
        if (course.difficulty) {
          const map: Record<string, string> = { beginner: 'badge-green', intermediate: 'badge-orange', advanced: 'badge-red' };
          const labels: Record<string, string> = { beginner: 'Débutant', intermediate: 'Intermédiaire', advanced: 'Avancé' };
          tagParts.push(`<span class="badge ${map[course.difficulty] || 'badge-blue'}">${labels[course.difficulty] || course.difficulty}</span>`);
        }
        if (course.category) tagParts.push(`<span class="badge badge-blue">${course.category}</span>`);
        tagsEl.innerHTML = tagParts.join('');

        document.getElementById('course-meta')!.style.display = 'none';

        // Enrollment check
        let enrolled = false;
        let modules: any[] = [];
        let prereqBlocked = false;

        if (token) {
          try {
            const myRes = await apiFetch('/my/courses', { token: token! }) as any;
            enrolled = (myRes.courses || []).some((c: any) => c.slug === slug || c.id === slug);
          } catch { /* ignore */ }

          if (enrolled) {
            try {
              const modRes = await apiFetch(`/courses/${slug}/modules`, { token: token! }) as any;
              modules = modRes.modules || [];
            } catch (e: any) {
              if (e.status === 403) prereqBlocked = true;
            }
          }
        }

        // Inline quizzes are embedded in previous modules — exclude from standalone list and counts
        const visibleModules = modules.filter((m: any) => !m.inline);

        // Enroll area
        const enrollArea = document.getElementById('enroll-area')!;
        const completedCount = visibleModules.filter((m: any) => m.type === 'quiz' ? m.passed : m.viewed).length;
        const totalCount = visibleModules.length;
        const pct = totalCount > 0 ? Math.round(completedCount / totalCount * 100) : 0;

        if (!enrolled) {
          if (course.is_public) {
            enrollArea.innerHTML = `<button class="btn btn-primary w-full" id="enroll-btn">S'inscrire au cours</button>`;
            document.getElementById('enroll-btn')!.addEventListener('click', async () => {
              if (!token) { window.location.href = `/login?redirect=/courses/${slug}`; return; }
              try {
                await apiFetch(`/courses/${slug}/enroll`, { method: 'POST', body: {}, token: token! });
              } catch { /* ok */ }
              window.location.reload();
            });
          } else {
            enrollArea.innerHTML = `
              <div style="background:var(--fill);border:1px solid var(--line);border-radius:var(--radius);padding:14px;font-size:.875rem;color:var(--ink-soft);text-align:center">
                🔒 Accès restreint — contactez un administrateur
              </div>
            `;
          }
        } else if (totalCount > 0) {
          // Find first incomplete module for CTA
          const nextMod = visibleModules.find((m: any) => !(m.type === 'quiz' ? m.passed : m.viewed) && !m.locked);
          const ctaHref = nextMod
            ? (nextMod.type === 'quiz' ? `/courses/${slug}/quiz/${nextMod.index}` : `/courses/${slug}/lessons/${nextMod.index}`)
            : (visibleModules[0] ? (visibleModules[0].type === 'quiz' ? `/courses/${slug}/quiz/${visibleModules[0].index}` : `/courses/${slug}/lessons/${visibleModules[0].index}`) : '#');

          enrollArea.innerHTML = `
            <div style="margin-bottom:10px">
              <div style="display:flex;justify-content:space-between;font-size:.8rem;color:var(--ink-soft);margin-bottom:6px">
                <span>${completedCount}/${totalCount} modules</span>
                <span style="font-weight:600;color:var(--blue)">${pct}%</span>
              </div>
              <div class="progress-bar"><div class="progress-bar-fill" style="width:${pct}%"></div></div>
            </div>
            <a href="${ctaHref}" class="btn btn-primary w-full" style="display:inline-flex">
              ${pct === 0 ? 'Commencer le cours ▸' : pct === 100 ? 'Revoir le cours ▸' : 'Continuer le cours ▸'}
            </a>
          `;
        }

        // Module count
        document.getElementById('module-count')!.textContent = visibleModules.length > 0 ? `${visibleModules.length} module${visibleModules.length !== 1 ? 's' : ''}` : '';

        // Render modules (inline quizzes excluded — they appear embedded in the previous lesson)
        if (prereqBlocked) {
          document.getElementById('prereq-blocked')!.style.display = 'block';
        } else if (enrolled && visibleModules.length > 0) {
          document.getElementById('modules-list')!.innerHTML = renderModules(visibleModules);
        } else if (enrolled) {
          document.getElementById('modules-empty')!.textContent = 'Aucun contenu disponible pour le moment.';
          document.getElementById('modules-empty')!.style.display = 'block';
        } else {
          document.getElementById('modules-empty')!.style.display = 'block';
        }

        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('course-content')!.style.display = 'grid';
        launchAI(slug);
      } catch {
        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('not-found')!.style.display = 'block';
      }
    }

    // ── AI mock summaries ──
    type AiBullet = [string, string]; // [bold part, normal part]
    const AI_SUMMARIES: Record<string, AiBullet[]> = {
      'microservices-kubernetes': [
        ['Les microservices décomposent un monolithe en services indépendants,', ' chacun responsable d\'un périmètre métier précis, avec sa propre base de données, déployable sans toucher aux autres.'],
        ['Kubernetes orchestre ces services à l\'échelle :', ' il gère le déploiement, la montée en charge automatique, la résilience et la découverte de services via DNS interne.'],
        ['L\'observabilité est indispensable en production :', ' Prometheus collecte les métriques, Grafana les visualise, et ArgoCD automatise les déploiements en mode GitOps — sans ça, un cluster microservices devient ingérable.'],
      ],
      'docker-conteneurisation': [
        ['Docker isole chaque application dans un conteneur reproductible,', ' garantissant que ce qui tourne en dev tourne de façon identique en staging et en production.'],
        ['Les Dockerfiles multi-stage réduisent drastiquement la taille des images finales', ' en séparant l\'étape de build des artefacts déployés — typiquement de 800 Mo à moins de 20 Mo pour une app Go.'],
        ['Docker Compose orchestre plusieurs conteneurs localement en un seul fichier YAML,', ' remplaçant des dizaines de commandes docker run par un simple docker compose up.'],
      ],
      'golang-fondamentaux': [
        ['Go est un langage compilé, statiquement typé et opinioné,', ' conçu par Google pour allier la performance du C à la lisibilité d\'un langage moderne — sans garbage collector bloquant.'],
        ['Les goroutines et les channels sont le cœur de la concurrence en Go :', ' des milliers de goroutines peuvent tourner en parallèle avec une empreinte mémoire infime comparée aux threads OS.'],
        ['La gestion des erreurs en Go est explicite et volontairement verbeuse,', ' forçant le développeur à traiter chaque cas d\'échec plutôt que de s\'appuyer sur des exceptions implicites.'],
      ],
      'observabilite-prometheus-grafana': [
        ['L\'observabilité repose sur trois piliers complémentaires :', ' les métriques (Prometheus), les logs (Loki/ELK) et le tracing distribué (Jaeger) — chacun répond à un type de question différent.'],
        ['Prometheus scrape les endpoints /metrics de vos services à intervalle régulier', ' et stocke les séries temporelles dans une base de données optimisée pour les requêtes PromQL.'],
        ['Grafana transforme les données brutes en dashboards actionnables,', ' avec des alertes configurables qui déclenchent des notifications PagerDuty, Slack ou email dès qu\'un seuil est franchi.'],
      ],
      'securite-kubernetes': [
        ['Le RBAC Kubernetes contrôle qui peut faire quoi sur quelles ressources,', ' via des ServiceAccounts, Roles et RoleBindings — mal configuré, il devient la principale surface d\'attaque d\'un cluster.'],
        ['Les Network Policies fonctionnent comme un firewall East-West interne au cluster,', ' bloquant par défaut tout trafic inter-pods sauf ce qui est explicitement autorisé.'],
        ['Vault gère le cycle de vie complet des secrets :', ' rotation automatique, accès temporaire avec TTL, et audit trail — là où les Kubernetes Secrets natifs ne sont qu\'encodés en base64.'],
      ],
      'api-rest-grpc': [
        ['REST est un style architectural basé sur HTTP et les ressources,', ' lisible par l\'humain, universellement supporté — mais verbeux et sans contrat fort entre client et serveur.'],
        ['gRPC utilise Protocol Buffers comme format de sérialisation binaire,', ' offrant des performances 5 à 10× supérieures à JSON/REST pour les communications inter-services à fort volume.'],
        ['OpenAPI (anciennement Swagger) génère automatiquement documentation, clients et mocks', ' à partir d\'un fichier YAML, réduisant la dérive entre le contrat d\'API et son implémentation réelle.'],
      ],
    };

    const AI_DEFAULT: AiBullet[] = [
      ['Ce cours progresse des fondamentaux vers les cas d\'usage avancés,', ' chaque module s\'appuyant sur le précédent pour construire une compréhension solide et durable.'],
      ['Les exercices pratiques accompagnent chaque notion clé,', ' permettant de passer immédiatement de la théorie à la mise en œuvre dans un environnement réel.'],
      ['Un quiz final valide vos acquis avant de progresser,', ' avec un score minimum requis pour garantir que les bases sont bien ancrées.'],
    ];

    function launchAI(courseSlug: string) {
      const card = document.getElementById('ai-card')!;
      card.style.display = 'block';
      const bullets = AI_SUMMARIES[courseSlug] || AI_DEFAULT;
      const thinking = document.getElementById('ai-thinking')!;
      const bulletsEl = document.getElementById('ai-bullets')!;
      const footer = document.getElementById('ai-footer')!;

      setTimeout(() => {
        thinking.style.display = 'none';
        bulletsEl.style.display = 'flex';
        bulletsEl.innerHTML = bullets.map(([b, n]) =>
          `<li class="ai-bullet"><div class="ai-bullet-dot"></div><span><strong>${b}</strong>${n}</span></li>`
        ).join('');
        const items = bulletsEl.querySelectorAll<HTMLElement>('.ai-bullet');
        items.forEach((el, i) => setTimeout(() => el.classList.add('visible'), i * 280));
        setTimeout(() => { footer.style.display = 'flex'; }, items.length * 280 + 200);
      }, 1100);
    }

    init();
  </script>
</App>
