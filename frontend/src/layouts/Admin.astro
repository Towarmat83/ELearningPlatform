---
import App from './App.astro';

export interface Props {
  title: string;
  allowedRoles?: string[];
}

const { title, allowedRoles } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/admin';

const navItems = [
  { href: '/admin',             label: '📊 Tableau de bord' },
  { href: '/admin/users',       label: '👥 Utilisateurs'    },
  { href: '/admin/courses',     label: '📚 Cours'            },
  { href: '/admin/paths',       label: '🗺️ Parcours'         },
  { href: '/admin/groups',      label: '🏷️ Groupes'          },
  { href: '/admin/leaderboard', label: '🏆 Classement'       },
  { href: '/admin/labs',        label: '🧪 Labs'             },
  { href: '/admin/exports',     label: '📤 Exports CSV'      },
];

function isActive(href: string) {
  if (href === '/admin') return path === '/admin';
  return path.startsWith(href);
}
---
<App title={`${title} — Admin`}>
  <div id="admin-guard-data" data-roles={JSON.stringify(allowedRoles ?? ['admin'])} class="hidden"></div>
  <div id="admin-forbidden" class="shell-forbidden">
    <div class="shell-forbidden-inner">
      <div class="shell-forbidden-icon">🔒</div>
      <h2 class="mb-2">Accès refusé</h2>
      <p class="text-soft text-sm mb-5">Réservé aux administrateurs.</p>
      <a href="/courses" class="btn btn-primary">Retour au catalogue</a>
    </div>
  </div>

  <div id="admin-shell" class="shell-hidden">
    <div class="shell-layout">
      <aside class="shell-sidebar">
        <div class="shell-sidebar-label">Administration</div>
        <nav class="shell-sidebar-nav">
          {navItems.map(item => (
            <a
              href={item.href}
              class={`sidebar-link${isActive(item.href) ? ' active' : ''}`}
            >{item.label}</a>
          ))}
        </nav>
        <div class="shell-sidebar-bottom">
          <a href="/courses" class="sidebar-link text-ink-soft text-[.82rem]">← Retour au catalogue</a>
        </div>
      </aside>

      <main class="shell-main">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user') || 'null');

    if (!token) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
    } else if (!JSON.parse(document.getElementById('admin-guard-data')!.dataset.roles ?? '["admin"]').includes(user?.role)) {
      document.getElementById('admin-forbidden')!.style.display = 'flex';
    } else {
      document.getElementById('admin-shell')!.style.display = 'block';
    }
  </script>
</App>
