---
import App from '../../../../../layouts/App.astro';
---
<App title="Participants — Session">
  <div class="presence-outer">
  <div class="page-inner">
    <a href="/agenda" class="presence-back">← Retour à l'agenda</a>
    <div class="presence-title" id="page-title">Chargement…</div>
    <div class="presence-sub" id="page-sub"></div>

    <div class="presence-stats" id="stats-row"></div>

    <table class="presence-table hidden" id="participants-table">
      <thead>
        <tr>
          <th>Participant</th>
          <th>Email</th>
          <th>Inscrit le</th>
          <th class="text-center">Présent</th>
        </tr>
      </thead>
      <tbody id="participants-body"></tbody>
    </table>

    <div class="no-participants hidden" id="no-participants">
      Aucun participant inscrit pour cette session.
    </div>
  </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user') || '{}');

    if (!token) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
    } else if (user.role !== 'admin' && user.role !== 'manager') {
      window.location.href = '/agenda';
    }

    const pathParts = window.location.pathname.split('/');
    // /admin/courses/sessions/{slug}/{sessionId}
    const sessionId = pathParts[pathParts.length - 1];
    const slug = pathParts[pathParts.length - 2];

    const apiBase = user.role === 'manager' ? '/api/manager' : '/api/admin';

    async function apiFetch(path: string, opts: { method?: string; body?: any } = {}) {
      const h: Record<string, string> = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` };
      const r = await fetch(path, {
        method: opts.method || 'GET',
        headers: h,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (r.status === 401) { localStorage.clear(); location.href = '/login'; throw new Error('401'); }
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    }

    let participants: any[] = [];

    function renderStats() {
      const total = participants.length;
      const present = participants.filter(p => p.present).length;
      document.getElementById('stats-row')!.innerHTML = `
        <div class="stat-chip"><span>${total}</span>Inscrits</div>
        <div class="stat-chip green"><span>${present}</span>Présents</div>
        <div class="stat-chip"><span>${total - present}</span>Absents</div>
      `;
    }

    function renderTable() {
      const tbody = document.getElementById('participants-body')!;
      tbody.innerHTML = '';

      participants.forEach((p, idx) => {
        const tr = document.createElement('tr');
        const dateStr = new Date(p.bookedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
        tr.innerHTML = `
          <td><strong>${p.username}</strong></td>
          <td class="text-ink-soft">${p.email}</td>
          <td class="text-ink-soft">${dateStr}</td>
          <td class="text-center">
            <input type="checkbox" class="presence-cb" data-idx="${idx}" data-uid="${p.userId}" ${p.present ? 'checked' : ''} />
          </td>
        `;
        tbody.appendChild(tr);
      });

      tbody.querySelectorAll<HTMLInputElement>('input.presence-cb').forEach(cb => {
        cb.addEventListener('change', async () => {
          const idx = parseInt(cb.dataset.idx!);
          const uid = cb.dataset.uid!;
          const present = cb.checked;

          try {
            await apiFetch(`${apiBase}/courses/${slug}/sessions/${sessionId}/bookings/${uid}/presence`, {
              method: 'PATCH',
              body: { present },
            });
            participants[idx].present = present;
            renderStats();
          } catch {
            cb.checked = !present;
            alert('Erreur lors de la mise à jour de la présence.');
          }
        });
      });
    }

    async function init() {
      try {
        const [courseResp, partResp] = await Promise.all([
          fetch(`/api/courses/${slug}`).then(r => r.json()).catch(() => null),
          apiFetch(`${apiBase}/courses/${slug}/sessions/${sessionId}/bookings`),
        ]);

        // /api/courses/{slug} returns the course directly (no .course wrapper)
        const session = courseResp?.sessions?.find((s: any) => s.id === sessionId);

        document.getElementById('page-title')!.textContent =
          session?.title ? `Session — ${session.title}` : `Session ${sessionId}`;
        document.getElementById('page-sub')!.textContent = courseResp?.title
          ? `${courseResp.title}${session?.date ? ' · ' + new Date(session.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : ''}`
          : slug;

        participants = partResp.participants ?? [];

        if (participants.length === 0) {
          document.getElementById('no-participants')!.classList.remove('hidden');
        } else {
          document.getElementById('participants-table')!.classList.remove('hidden');
          renderTable();
        }
        renderStats();
      } catch {
        document.getElementById('page-title')!.textContent = 'Erreur de chargement';
      }
    }

    init();
  </script>
</App>
