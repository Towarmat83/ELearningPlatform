---
import App from '../layouts/App.astro';
---
<App title="Mes cours" activePage="courses">
  <style is:global>
    .mc-page { padding: 28px 36px 80px; max-width: 1100px; margin: 0 auto; }

    .mc-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }
    .mc-title { font-size: 1.5rem; font-weight: 700; }
    .mc-stats {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: 28px;
    }
    .mc-stat {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .mc-stat-val { font-size: 1.6rem; font-weight: 700; color: var(--blue); line-height: 1; }
    .mc-stat-label { font-size: .78rem; color: var(--ink-soft); }

    .mc-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    .mc-card {
      border: 1.5px solid var(--line);
      border-radius: 14px;
      background: var(--paper);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: border-color .15s, box-shadow .15s;
    }
    .mc-card:hover { border-color: var(--blue); box-shadow: 0 4px 18px rgba(27,134,242,.12); }
    .mc-card-thumb {
      width: 100%;
      height: 130px;
      background: linear-gradient(135deg, var(--blue-soft), #d6ecfd);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      overflow: hidden;
      border-bottom: 1.5px solid var(--line);
      flex-shrink: 0;
    }
    .mc-card-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .mc-card-body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }
    .mc-card-title {
      font-weight: 600;
      font-size: .95rem;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .mc-card-prog-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .mc-card-prog-row .progress-bar { flex: 1; }
    .mc-card-prog-pct { font-size: .75rem; font-weight: 600; color: var(--blue); flex-shrink: 0; min-width: 32px; text-align: right; }
    .mc-card-meta { font-size: .78rem; color: var(--ink-soft); }
    .mc-card-cta {
      margin-top: auto;
      display: flex;
      gap: 8px;
    }
    .mc-empty {
      text-align: center;
      padding: 80px 24px;
    }
    .mc-empty-icon { font-size: 3.5rem; margin-bottom: 16px; }
    .mc-empty h2 { font-size: 1.2rem; margin-bottom: 8px; }
    .mc-empty p { color: var(--ink-soft); font-size: .9rem; margin-bottom: 20px; }

    .mc-filter-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .mc-filter-bar .search-wrap { position: relative; flex: 1; min-width: 180px; }
    .mc-filter-bar .search-wrap svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--ink-soft); pointer-events: none; }
    .mc-filter-bar .input { padding-left: 36px; }
    .mc-count { font-size: .875rem; color: var(--ink-soft); white-space: nowrap; }

    /* ── Responsive ── */
    @media (max-width: 1024px) {
      .mc-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .mc-page { padding: 20px 14px 80px; }
      .mc-header { flex-direction: column; align-items: flex-start; gap: 10px; }
      .mc-stats { gap: 16px; }
      .mc-filter-bar { flex-direction: column; align-items: stretch; }
      .mc-filter-bar .search-wrap { min-width: unset; }
      #filter-progress { width: 100%; }
      .mc-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="mc-page">
    <div class="mc-header">
      <h1 class="mc-title">Mes cours</h1>
      <a href="/courses" class="btn btn-secondary btn-sm">Parcourir le catalogue</a>
    </div>

    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

    <div id="mc-content" style="display:none">
      <!-- Stats -->
      <div class="mc-stats" id="mc-stats"></div>

      <!-- Filter bar -->
      <div class="mc-filter-bar">
        <div class="search-wrap">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input class="input" type="search" id="search-input" placeholder="Filtrer mes cours…" />
        </div>
        <select class="input" id="filter-progress" style="width:auto;flex-shrink:0">
          <option value="all">Tous</option>
          <option value="in-progress">En cours</option>
          <option value="completed">Terminés</option>
          <option value="not-started">Non commencés</option>
        </select>
        <span class="mc-count" id="results-count"></span>
      </div>

      <!-- Grid -->
      <div id="mc-grid" class="mc-grid"></div>

      <!-- Empty search state -->
      <div id="mc-filter-empty" style="display:none;text-align:center;padding:40px;color:var(--ink-soft)">
        <div style="font-size:2rem;margin-bottom:10px">🔍</div>
        <p>Aucun cours ne correspond à votre recherche.</p>
      </div>

      <!-- Empty enrolled state -->
      <div id="mc-empty" class="mc-empty" style="display:none">
        <div class="mc-empty-icon">📚</div>
        <h2>Vous n'êtes inscrit à aucun cours</h2>
        <p>Commencez par parcourir le catalogue et inscrivez-vous à vos premiers cours.</p>
        <a href="/courses" class="btn btn-primary">Découvrir le catalogue</a>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=/my-courses'; }

    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error((err as any).error || `HTTP ${res.status}`); }
      return res.json();
    }

    let allCourses: any[] = [];
    let searchTimer: ReturnType<typeof setTimeout>;

    function pct(c: any) {
      return c.labCount > 0 ? Math.round(c.completedLabs / c.labCount * 100) : 0;
    }

    function courseStatus(c: any): 'not-started' | 'in-progress' | 'completed' {
      const p = pct(c);
      if (p === 0) return 'not-started';
      if (p === 100) return 'completed';
      return 'in-progress';
    }

    function renderCard(c: any): string {
      const p = pct(c);
      const status = courseStatus(c);
      const ctaLabel = status === 'not-started' ? 'Commencer ▸' : status === 'completed' ? 'Revoir ▸' : 'Continuer ▸';
      const thumb = c.thumbnail
        ? `<img src="${c.thumbnail}" alt="${c.title}" />`
        : '📖';
      const statusBadge = status === 'completed'
        ? `<span class="badge badge-green" style="font-size:.7rem">✓ Terminé</span>`
        : status === 'in-progress'
        ? `<span class="badge badge-blue" style="font-size:.7rem">En cours</span>`
        : `<span class="badge badge-gray" style="font-size:.7rem">Non commencé</span>`;

      return `
        <div class="mc-card">
          <div class="mc-card-thumb">${thumb}</div>
          <div class="mc-card-body">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
              <div class="mc-card-title">${c.title}</div>
              ${statusBadge}
            </div>
            <div class="mc-card-prog-row">
              <div class="progress-bar"><div class="progress-bar-fill" style="width:${p}%"></div></div>
              <span class="mc-card-prog-pct">${p}%</span>
            </div>
            <div class="mc-card-meta">${c.completedLabs ?? 0}/${c.labCount ?? 0} modules terminés</div>
            <div class="mc-card-cta">
              <a href="/courses/${c.slug || c.id}" class="btn btn-primary btn-sm" style="flex:1;justify-content:center">${ctaLabel}</a>
              <a href="/courses/${c.slug || c.id}" class="btn btn-secondary btn-sm">Détails</a>
            </div>
          </div>
        </div>
      `;
    }

    function applyFilters() {
      const q = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase().trim();
      const prog = (document.getElementById('filter-progress') as HTMLSelectElement).value;

      let filtered = allCourses;
      if (q) filtered = filtered.filter(c => c.title.toLowerCase().includes(q) || (c.description || '').toLowerCase().includes(q));
      if (prog !== 'all') filtered = filtered.filter(c => courseStatus(c) === prog);

      const grid = document.getElementById('mc-grid')!;
      const filterEmpty = document.getElementById('mc-filter-empty')!;
      document.getElementById('results-count')!.textContent = `${filtered.length} cours`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        filterEmpty.style.display = 'block';
      } else {
        filterEmpty.style.display = 'none';
        grid.innerHTML = filtered.map(renderCard).join('');
      }
    }

    async function init() {
      if (!token) return;
      try {
        const res = await apiFetch('/my/courses', { token: token! }) as any;
        allCourses = res.courses || [];

        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('mc-content')!.style.display = 'block';

        if (allCourses.length === 0) {
          document.getElementById('mc-empty')!.style.display = 'block';
          document.getElementById('mc-stats')!.style.display = 'none';
          (document.querySelector('.mc-filter-bar') as HTMLElement).style.display = 'none';
          return;
        }

        // Stats
        const totalModules = allCourses.reduce((s: number, c: any) => s + (c.labCount || 0), 0);
        const doneModules = allCourses.reduce((s: number, c: any) => s + (c.completedLabs || 0), 0);
        const completedCourses = allCourses.filter(c => courseStatus(c) === 'completed').length;
        document.getElementById('mc-stats')!.innerHTML = `
          <div class="mc-stat">
            <span class="mc-stat-val">${allCourses.length}</span>
            <span class="mc-stat-label">cours inscrits</span>
          </div>
          <div class="mc-stat">
            <span class="mc-stat-val">${completedCourses}</span>
            <span class="mc-stat-label">cours terminés</span>
          </div>
          <div class="mc-stat">
            <span class="mc-stat-val">${doneModules}</span>
            <span class="mc-stat-label">modules terminés</span>
          </div>
          <div class="mc-stat">
            <span class="mc-stat-val">${totalModules > 0 ? Math.round(doneModules / totalModules * 100) : 0}%</span>
            <span class="mc-stat-label">progression globale</span>
          </div>
        `;

        applyFilters();

        document.getElementById('search-input')!.addEventListener('input', () => {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(applyFilters, 250);
        });
        document.getElementById('filter-progress')!.addEventListener('change', applyFilters);
      } catch {
        document.getElementById('loading')!.style.display = 'none';
        (window as any).showToast?.('Erreur lors du chargement', 'error');
      }
    }

    init();
  </script>
</App>
