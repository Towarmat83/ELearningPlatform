---
import App from '../layouts/App.astro';
---
<App title="Agenda — pupitre" activePage="agenda">

  <div class="agenda-wrap">
    <!-- Calendar area -->
    <div class="cal-area">
      <div class="cal-topbar">
        <span class="text-[1.3rem]">📅</span>
        <span class="cal-topbar-title">Agenda</span>
        <button class="cal-today-btn" id="btn-today">Aujourd'hui</button>
        <div class="cal-nav-group">
          <button class="cal-nav-btn" id="btn-prev">‹</button>
          <div class="mp-wrap">
            <button class="cal-month-btn" id="month-label" title="Choisir mois / année"></button>
            <div class="mp-popup" id="mp-popup">
              <div class="mp-year-row">
                <button class="mp-year-btn" id="mp-prev-year">‹</button>
                <span class="mp-year-lbl" id="mp-year-lbl"></span>
                <button class="mp-year-btn" id="mp-next-year">›</button>
              </div>
              <div class="mp-months" id="mp-months"></div>
            </div>
          </div>
          <button class="cal-nav-btn" id="btn-next">›</button>
        </div>
        <div id="loading-inline" class="text-[.8rem] text-ink-soft">Chargement…</div>
        <button class="btn-new-session" id="btn-new-session">+ Nouvelle session</button>
      </div>

      <div class="cal-dow-row">
        <div class="cal-dow-cell">Lun</div>
        <div class="cal-dow-cell">Mar</div>
        <div class="cal-dow-cell">Mer</div>
        <div class="cal-dow-cell">Jeu</div>
        <div class="cal-dow-cell">Ven</div>
        <div class="cal-dow-cell">Sam</div>
        <div class="cal-dow-cell">Dim</div>
      </div>

      <div class="cal-body" id="cal-body"></div>
    </div>

    <!-- Side panel -->
    <div class="side-panel">
      <div class="side-header" id="side-header">Sessions à venir</div>
      <div class="side-body" id="side-body">
        <div class="no-sel">Cliquez sur un jour pour voir les sessions.</div>
      </div>
    </div>
  </div>

  <!-- Session create/edit modal -->
  <div class="agenda-modal-overlay" id="session-modal">
    <div class="agenda-modal-box">
      <div class="modal-title" id="modal-title">Nouvelle session</div>
      <div class="form-group" id="course-group">
        <label class="form-label" for="modal-course">Cours</label>
        <select class="form-input" id="modal-course"></select>
      </div>
      <div class="form-group">
        <label class="form-label" for="modal-title-input">Titre</label>
        <input class="form-input" id="modal-title-input" type="text" placeholder="ex: Session septembre — Groupe A" />
      </div>
      <div class="form-group">
        <label class="form-label" for="modal-date">Date et heure</label>
        <input class="form-input" id="modal-date" type="datetime-local" />
      </div>
      <div class="form-group">
        <label class="form-label" for="modal-location">Lieu</label>
        <input class="form-input" id="modal-location" type="text" placeholder="ex: Salle 3B, Paris" />
      </div>
      <div class="form-group">
        <label class="form-label" for="modal-capacity">Capacité</label>
        <input class="form-input" id="modal-capacity" type="number" min="1" value="1" />
      </div>
      <div class="modal-actions">
        <button class="btn btn-secondary btn-sm" id="modal-cancel">Annuler</button>
        <button class="btn btn-primary btn-sm" id="modal-submit">Créer</button>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    const currentUser = JSON.parse(localStorage.getItem('user') || '{}');
    const isTrainer = currentUser.role === 'admin' || currentUser.role === 'manager';

    // --- Session modal state ---
    let editingSession: { courseSlug: string; sessionId: string } | null = null;
    let inPersonCourses: any[] = [];

    function openModal(courseSlug?: string, session?: any) {
      editingSession = session ? { courseSlug: courseSlug!, sessionId: session.id } : null;
      const isEdit = !!session;

      (document.getElementById('modal-title') as HTMLElement).textContent = isEdit ? 'Modifier la session' : 'Nouvelle session';
      (document.getElementById('modal-submit') as HTMLButtonElement).textContent = isEdit ? 'Enregistrer' : 'Créer';

      const courseGroup = document.getElementById('course-group')!;
      const courseSelect = document.getElementById('modal-course') as HTMLSelectElement;

      if (isEdit) {
        courseGroup.style.display = 'none';
      } else {
        courseGroup.style.display = '';
        courseSelect.innerHTML = inPersonCourses.map(c =>
          `<option value="${c.slug}">${c.title}</option>`
        ).join('');
        if (courseSlug) courseSelect.value = courseSlug;
      }

      const toDatetimeLocal = (iso: string) => iso ? iso.slice(0, 16) : '';

      (document.getElementById('modal-title-input') as HTMLInputElement).value = session?.title ?? '';
      (document.getElementById('modal-date') as HTMLInputElement).value = toDatetimeLocal(session?.date ?? '');
      (document.getElementById('modal-location') as HTMLInputElement).value = session?.location ?? '';
      (document.getElementById('modal-capacity') as HTMLInputElement).value = String(session?.capacity ?? 1);

      document.getElementById('session-modal')!.classList.add('open');
    }

    function closeModal() {
      document.getElementById('session-modal')!.classList.remove('open');
      editingSession = null;
    }

    async function submitModal() {
      const titleInput = (document.getElementById('modal-title-input') as HTMLInputElement).value.trim();
      const dateRaw = (document.getElementById('modal-date') as HTMLInputElement).value;
      const location = (document.getElementById('modal-location') as HTMLInputElement).value.trim();
      const capacity = parseInt((document.getElementById('modal-capacity') as HTMLInputElement).value, 10) || 1;

      if (!titleInput || !dateRaw || !location) { alert('Titre, date et lieu sont requis.'); return; }

      const date = new Date(dateRaw).toISOString();
      const body = { title: titleInput, date, location, capacity };

      try {
        if (editingSession) {
          await apiFetch(`/admin/courses/${editingSession.courseSlug}/sessions/${editingSession.sessionId}`, {
            method: 'PUT', token: token!, body,
          });
        } else {
          const slug = (document.getElementById('modal-course') as HTMLSelectElement).value;
          await apiFetch(`/admin/courses/${slug}/sessions`, { method: 'POST', token: token!, body });
        }
        closeModal();
        await reloadSessions();
      } catch {
        alert('Erreur lors de la sauvegarde.');
      }
    }

    async function deleteSession(courseSlug: string, sessionId: string) {
      if (!confirm('Supprimer cette session ?')) return;
      try {
        await apiFetch(`/admin/courses/${courseSlug}/sessions/${sessionId}`, { method: 'DELETE', token: token! });
        await reloadSessions();
      } catch {
        alert('Erreur lors de la suppression.');
      }
    }

    async function reloadSessions() {
      const data = await apiFetch('/courses');
      const courses = (data as any).courses || [];
      inPersonCourses = courses.filter((c: any) => c.inPerson);
      all = [];
      for (const c of courses) {
        if (!c.inPerson || !c.sessions?.length) continue;
        for (const s of c.sessions) all.push({ course: c, session: s, date: new Date(s.date) });
      }
      all.sort((a, b) => a.date.getTime() - b.date.getTime());
      renderCal();
      renderPanel(selDay, selDay ? all.filter(s => dk(s.date) === selDay) : []);
    }

    async function apiFetch(path: string, opts: { method?: string; token?: string; body?: any } = {}) {
      const h: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) h['Authorization'] = `Bearer ${opts.token}`;
      const r = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers: h,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (r.status === 401) { localStorage.clear(); location.href = '/login'; throw new Error('401'); }
      if (!r.ok) { const e = new Error(`HTTP ${r.status}`); (e as any).status = r.status; throw e; }
      if (r.status === 204 || r.headers.get('content-length') === '0') return {};
      return r.json();
    }

    type SI = { course: any; session: any; date: Date };

    let all: SI[] = [];
    let booked = new Set<string>();
    let year = new Date().getFullYear();
    let month = new Date().getMonth();
    let selDay: string | null = null;

    const dk = (d: Date) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    const today = dk(new Date());

    const MONTHS_FR = ['Jan','Fév','Mar','Avr','Mai','Juin','Juil','Aoû','Sep','Oct','Nov','Déc'];
    let pickerYear = year;

    function renderPicker() {
      document.getElementById('mp-year-lbl')!.textContent = String(pickerYear);
      const grid = document.getElementById('mp-months')!;
      grid.innerHTML = '';
      MONTHS_FR.forEach((m, i) => {
        const btn = document.createElement('button');
        btn.className = 'mp-month-btn' + (pickerYear === year && i === month ? ' active' : '');
        btn.textContent = m;
        btn.addEventListener('click', () => {
          year = pickerYear; month = i;
          selDay = null;
          closePicker();
          renderCal(); renderPanel(null, []);
        });
        grid.appendChild(btn);
      });
    }

    function openPicker() {
      pickerYear = year;
      renderPicker();
      document.getElementById('mp-popup')!.classList.add('open');
    }
    function closePicker() {
      document.getElementById('mp-popup')!.classList.remove('open');
    }

    function renderCal() {
      document.getElementById('month-label')!.textContent =
        new Date(year, month, 1).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });

      const body = document.getElementById('cal-body')!;
      body.innerHTML = '';

      const byDay = new Map<string, SI[]>();
      for (const s of all) {
        const k = dk(s.date);
        if (!byDay.has(k)) byDay.set(k, []);
        byDay.get(k)!.push(s);
      }

      // First day of month — Mon-based
      let dow = new Date(year, month, 1).getDay();
      dow = dow === 0 ? 6 : dow - 1;

      const prevDays = new Date(year, month, 0).getDate();
      const currDays = new Date(year, month + 1, 0).getDate();
      const totalCells = Math.ceil((dow + currDays) / 7) * 7;

      for (let i = 0; i < totalCells; i++) {
        const cell = document.createElement('div');
        cell.className = 'cal-cell';

        let dayNum: number;
        let k: string;

        if (i < dow) {
          // prev month
          dayNum = prevDays - dow + i + 1;
          const pm = month === 0 ? 11 : month - 1;
          const py = month === 0 ? year - 1 : year;
          k = `${py}-${String(pm+1).padStart(2,'0')}-${String(dayNum).padStart(2,'0')}`;
          cell.classList.add('other-month');
        } else if (i >= dow + currDays) {
          // next month
          dayNum = i - dow - currDays + 1;
          const nm = month === 11 ? 0 : month + 1;
          const ny = month === 11 ? year + 1 : year;
          k = `${ny}-${String(nm+1).padStart(2,'0')}-${String(dayNum).padStart(2,'0')}`;
          cell.classList.add('other-month');
        } else {
          dayNum = i - dow + 1;
          k = `${year}-${String(month+1).padStart(2,'0')}-${String(dayNum).padStart(2,'0')}`;
        }

        if (k === today) cell.classList.add('today');
        if (k === selDay) cell.classList.add('selected');

        const numEl = document.createElement('div');
        numEl.className = 'cal-day-num';
        numEl.textContent = String(dayNum);
        cell.appendChild(numEl);

        const sessions = byDay.get(k) || [];
        if (sessions.length > 0) {
          cell.classList.add('has-event');
          sessions.slice(0, 3).forEach(s => {
            const pill = document.createElement('div');
            pill.className = 'cal-event-pill' + (booked.has(`${s.course.slug}|${s.session.id}`) ? ' booked' : '');
            pill.textContent = s.session.title;
            pill.title = `${s.course.title} — ${s.session.title}`;
            cell.appendChild(pill);
          });
          if (sessions.length > 3) {
            const more = document.createElement('div');
            more.style.cssText = 'font-size:.7rem;color:var(--ink-soft);padding-left:4px';
            more.textContent = `+${sessions.length - 3} autres`;
            cell.appendChild(more);
          }
        }

        if (sessions.length > 0 || k === today) {
          cell.addEventListener('click', () => { selDay = k; renderCal(); renderPanel(k, sessions); });
        }

        body.appendChild(cell);
      }
    }

    function renderPanel(k: string | null, sessions: SI[]) {
      const header = document.getElementById('side-header')!;
      const body = document.getElementById('side-body')!;

      if (!k) {
        header.textContent = 'Sessions à venir';
        const upcoming = all.filter(s => s.date >= new Date()).slice(0, 10);
        body.innerHTML = upcoming.length === 0
          ? '<div class="no-sel">Aucune session à venir.</div>'
          : upcoming.map(s => evCard(s)).join('');
      } else {
        const d = new Date(k + 'T12:00:00');
        header.textContent = d.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' }).toUpperCase();
        body.innerHTML = sessions.length === 0
          ? '<div class="no-sel">Aucune session ce jour.</div>'
          : sessions.map(s => evCard(s)).join('');
      }

      body.querySelectorAll('button[data-slug]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const slug = (btn as HTMLElement).dataset.slug!;
          const sid = (btn as HTMLElement).dataset.sid!;
          const isBooked = (btn as HTMLElement).dataset.booked === 'true';
          try {
            await apiFetch(`/courses/${slug}/sessions/${sid}/book`, {
              method: isBooked ? 'DELETE' : 'POST', token: token!
            });
            if (isBooked) booked.delete(`${slug}|${sid}`);
            else booked.add(`${slug}|${sid}`);
            renderCal();
            renderPanel(k, sessions);
          } catch (e: any) {
            if (e?.status === 409) alert('Cette session est complète.');
            else alert('Erreur — réessayez.');
          }
        });
      });

      body.querySelectorAll('button[data-edit-slug]').forEach(btn => {
        btn.addEventListener('click', () => {
          const el = btn as HTMLElement;
          openModal(el.dataset.editSlug, {
            id: el.dataset.editSid,
            title: el.dataset.editTitle,
            date: el.dataset.editDate,
            location: el.dataset.editLocation,
            capacity: parseInt(el.dataset.editCapacity ?? '0', 10),
          });
        });
      });

      body.querySelectorAll('button[data-del-slug]').forEach(btn => {
        btn.addEventListener('click', () => {
          const el = btn as HTMLElement;
          deleteSession(el.dataset.delSlug!, el.dataset.delSid!);
        });
      });
    }

    function evCard(s: SI): string {
      const key = `${s.course.slug}|${s.session.id}`;
      const isBooked = booked.has(key);
      const time = s.date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
      const dateStr = s.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
      return `
        <div class="ev-card${isBooked ? ' booked' : ''}">
          <div class="ev-course"><a href="/courses/${s.course.slug}" class="text-inherit no-underline">${s.course.title}</a></div>
          <div class="ev-title">${s.session.title}</div>
          <div class="ev-meta">
            📅 ${dateStr} à ${time}
            ${s.session.location ? `<br>📍 ${s.session.location}` : ''}
            ${s.session.capacity > 0 ? `<br>🪑 ${s.session.capacity} places` : ''}
          </div>
          ${isBooked ? '<div class="ev-booked-badge">✓ Inscrit(e)</div>' : ''}
          ${token ? `
            <button data-slug="${s.course.slug}" data-sid="${s.session.id}" data-booked="${isBooked}"
              class="btn ${isBooked ? 'btn-secondary' : 'btn-primary'} btn-sm w-full">
              ${isBooked ? 'Annuler la réservation' : 'Réserver une place'}
            </button>` : ''}
          ${isTrainer ? `
            <a href="/admin/courses/sessions/${s.course.slug}/${s.session.id}"
              class="btn btn-secondary btn-sm w-full text-center no-underline block mt-1.5">
              👥 Voir les inscrits &amp; présences
            </a>
            <div class="ev-trainer-actions">
              <button class="btn btn-secondary btn-sm flex-1"
                data-edit-slug="${s.course.slug}" data-edit-sid="${s.session.id}"
                data-edit-title="${s.session.title}" data-edit-date="${s.session.date}"
                data-edit-location="${s.session.location ?? ''}" data-edit-capacity="${s.session.capacity ?? 0}">
                Modifier
              </button>
              <button class="btn btn-secondary btn-sm flex-1 text-[#dc2626]"
                data-del-slug="${s.course.slug}" data-del-sid="${s.session.id}">
                Supprimer
              </button>
            </div>` : ''}
        </div>`;
    }

    async function init() {
      try {
        const [cr, br] = await Promise.allSettled([
          apiFetch('/courses'),
          token ? apiFetch('/my/session-bookings', { token: token! }) : Promise.resolve({ bookings: [] }),
        ]);

        const courses = cr.status === 'fulfilled' ? (cr.value as any).courses || [] : [];
        const bookings = br.status === 'fulfilled' ? (br.value as any).bookings || [] : [];

        booked = new Set(bookings.map((b: any) => `${b.courseSlug}|${b.sessionId}`));
        inPersonCourses = courses.filter((c: any) => c.inPerson);

        for (const c of courses) {
          if (!c.inPerson || !c.sessions?.length) continue;
          for (const s of c.sessions) all.push({ course: c, session: s, date: new Date(s.date) });
        }
        all.sort((a, b) => a.date.getTime() - b.date.getTime());

        if (isTrainer) {
          const btnNew = document.getElementById('btn-new-session')!;
          btnNew.style.display = 'block';
          btnNew.addEventListener('click', () => openModal());
        }

        // Jump to first upcoming session's month
        const first = all.find(s => s.date >= new Date());
        if (first) { year = first.date.getFullYear(); month = first.date.getMonth(); }

        document.getElementById('loading-inline')!.style.display = 'none';
        renderCal();

        // Show upcoming sessions in panel on load
        renderPanel(null, []);

        document.getElementById('btn-prev')!.addEventListener('click', () => {
          if (month === 0) { month = 11; year--; } else month--;
          selDay = null; renderCal(); renderPanel(null, []);
        });
        document.getElementById('btn-next')!.addEventListener('click', () => {
          if (month === 11) { month = 0; year++; } else month++;
          selDay = null; renderCal(); renderPanel(null, []);
        });
        document.getElementById('btn-today')!.addEventListener('click', () => {
          year = new Date().getFullYear(); month = new Date().getMonth();
          selDay = today; renderCal();
          const todaySessions = all.filter(s => dk(s.date) === today);
          renderPanel(today, todaySessions);
        });

        // Picker open/close
        document.getElementById('month-label')!.addEventListener('click', (e) => {
          e.stopPropagation();
          const popup = document.getElementById('mp-popup')!;
          if (popup.classList.contains('open')) closePicker();
          else openPicker();
        });
        document.getElementById('mp-prev-year')!.addEventListener('click', (e) => {
          e.stopPropagation(); pickerYear--; renderPicker();
        });
        document.getElementById('mp-next-year')!.addEventListener('click', (e) => {
          e.stopPropagation(); pickerYear++; renderPicker();
        });
        document.addEventListener('click', (e) => {
          const popup = document.getElementById('mp-popup')!;
          if (!popup.contains(e.target as Node)) closePicker();
        });

        document.getElementById('modal-cancel')!.addEventListener('click', closeModal);
        document.getElementById('modal-submit')!.addEventListener('click', submitModal);
        document.getElementById('session-modal')!.addEventListener('click', (e) => {
          if (e.target === document.getElementById('session-modal')) closeModal();
        });
      } catch {
        document.getElementById('loading-inline')!.textContent = 'Erreur de chargement.';
      }
    }

    init();
  </script>
</App>
